})
local formTag = Slab.new(plate, "Form", 336, 17, 104, 20, PAPER, { ZIndex = 8 })
local formText = label(formTag.Holder, {
	Name = "Text",
	Position = UDim2.fromOffset(10, 2),
	Size = UDim2.new(1, -20, 1, -3),
