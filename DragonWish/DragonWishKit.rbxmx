			RibbonR_End = Vector3.new(0.4635, -1.2052, -0.6707),
		},
	},
}

return HairConfig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">PowerConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerConfig  (ModuleScript — lives in ReplicatedStorage)

	Settings for powering up and turning Super Saiyan.
	How it plays: press R -> the camera swings round in front of you and you drop into a ready
	stance -> spam Space (or tap the TAP button on a phone) -> the aura appears, then grows
	bigger and faster, your hair and belt get blown upward -> fill the bar and you burst into
	Super Saiyan; the golden hair then flows calmly. Press R again as a Super Saiyan to power down.
]]

local PowerConfig = {}

PowerConfig.BaseRigName = "Base" -- the R15 rig in ReplicatedStorage every player becomes

-- controls
PowerConfig.PowerKey = Enum.KeyCode.R -- start powering up / cancel / power down
PowerConfig.TapKey = Enum.KeyCode.Space -- spam this to charge

-- charging
PowerConfig.ChargePerTap = 0.05 -- how much each tap fills the bar (0..1)
PowerConfig.ChargeDecay = 0.16 -- how much the bar drains per second if you stop tapping
PowerConfig.MinChargeTime = 2.5 -- you have to charge at least this long before transforming
PowerConfig.AuraStart = 0.06 -- bar level where the aura flickers on
PowerConfig.HairStart = 0.25 -- bar level where the hair and belt start lifting
PowerConfig.LockMovement = true -- you can't walk or jump while powering up

-- the transformation
PowerConfig.BurstTime = 2.4 -- seconds the burst lasts before you get control back
PowerConfig.SSJCalmWind = 0.12 -- a gentle upward lift that stays on as a Super Saiyan (0..1); the
-- sideways breeze is the SSJ hair's LocalWind in HairConfig
PowerConfig.SSJIdleAura = 0.22 -- a soft golden aura stays on after transforming (0 = none)

-- looks
PowerConfig.BaseAuraColor = Color3.fromRGB(200, 228, 255)
PowerConfig.SSJAuraColor = Color3.fromRGB(255, 210, 70)
PowerConfig.AuraSize = 1 -- scales the whole aura

-- camera (front view while powering up)
PowerConfig.CameraDistance = 9 -- studs in front of you
PowerConfig.CameraHeight = 0.8 -- studs above your waist
PowerConfig.CameraLookHeight = 1.4 -- the camera looks at this height above your waist
PowerConfig.CameraShake = 0.22 -- strongest shake (studs) at full power

return PowerConfig
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">CharacterSetup</string>
          <ProtectedString name="Source"><![CDATA[--[[
	CharacterSetup  (Script — lives in ServerScriptService)

	Turns every player into the "Base" rig (ReplicatedStorage > Base) with the base hair and
	the belt on:
	  1. When the server starts it copies Base, puts the rigged base hair, the (hidden) Super
	     Saiyan hair and the belt on it, and makes that copy the StarterCharacter — Roblox's
	     built-in way of giving every player a custom character.
	  2. Players' own avatars are not loaded onto it, and anything that still sneaks on
	     (clothing, accessories, body colours from their avatar) is stripped off when they spawn.

	The rigged pieces are found in ServerStorage > CharacterParts (import the three .fbx files
	there). Settings: ReplicatedStorage > HairConfig and PowerConfig.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))
local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local PIECES = { "BaseHair", "SSJHair", "Belt" }
local OWNED = "DWOwned" -- marks things that belong to the Base rig (never stripped)

local function log(message: string)
	print("[CharacterSetup] " .. message)
end

local function complain(message: string)
	warn("[CharacterSetup] " .. message)
end

----------------------------------------------------------------------------------------
-- finding and copying the imported rigged pieces
----------------------------------------------------------------------------------------
local function partOfBone(bone: Instance): BasePart?
	local node = bone.Parent
	while node and not node:IsA("BasePart") do
		node = node.Parent
	end
	return node :: BasePart?
end

local function findSource(signature: string): (Bone?, string?)
	for _, container in { ServerStorage, ReplicatedStorage, Workspace } do
		local folder = container:FindFirstChild(HairConfig.ModelFolder)
		if folder then
			local bone = folder:FindFirstChild(signature, true)
			if bone and bone:IsA("Bone") then
				return bone, folder:GetFullName()
			end
		end
	end
	-- forgiving: imported but left loose in Workspace / ServerStorage
	for _, container in { Workspace, ServerStorage } do
		for _, d in container:GetDescendants() do
			if d.Name == signature and d:IsA("Bone") then
				return d, container.Name
			end
		end
	end
	return nil
end

-- A copy of the mesh with all its bones inside it (moves bones in if the importer put them
-- in a separate part — same place in the world, so the skinning is unchanged).
local function copyMesh(signatureBone: Bone): BasePart?
	local original = partOfBone(signatureBone)
	if not original then
		return nil
	end
	local holder: Instance = signatureBone:FindFirstAncestorWhichIsA("Model") or original
	if holder:IsA("Workspace") then
		holder = original
	end
	local copy = holder:Clone() or original:Clone()
	if not copy then
		return nil
	end
	local bone = copy:FindFirstChild(signatureBone.Name, true)
	local bonePart = bone and partOfBone(bone)
	if not bonePart then
		copy:Destroy()
		return nil
	end
	local mesh = bonePart
	if not bonePart:IsA("MeshPart") then
		local found = copy:IsA("MeshPart") and copy or copy:FindFirstChildWhichIsA("MeshPart", true)
		if found then
			mesh = found
			for _, child in bonePart:GetChildren() do
				if child:IsA("Bone") then
					child.CFrame = mesh.CFrame:ToObjectSpace(bonePart.CFrame * child.CFrame)
					child.Parent = mesh
				end
			end
		end
	end
	if mesh ~= copy then
		mesh.Parent = nil
		copy:Destroy()
	end
	for _, d in mesh:GetDescendants() do
		if d.Parent and not (d:IsA("Bone") or d:IsA("SurfaceAppearance")) then
			d:Destroy()
		end
	end
	return mesh
end

local function bonePairs(mesh: BasePart, layout)
	local design, actual = {}, {}
	for name, modeled in layout.Bones do
		local bone = mesh:FindFirstChild(name, true)
		if bone and bone:IsA("Bone") then
			local cf = HairPhysics.PartSpaceCFrame(bone, mesh)
			if cf then
				table.insert(design, modeled)
				table.insert(actual, cf.Position)
			end
		end
	end
	return design, actual
end

----------------------------------------------------------------------------------------
-- sizing the belt to the waist
----------------------------------------------------------------------------------------
-- How big the belt has to be so the body never pokes through it, and where the middle of the
-- waist is. The body parts listed in FitAround are measured where they cross the band, all the
-- way round, and compared with the inside of the band (layout.Ring, measured from the model).
-- Returns the size to use (1 = as modeled) and how far to move the belt to centre it.
local function waistFit(rig: Model, attachPart: BasePart, ring, cfg): (number?, Vector3)
	local radii, step = ring.Radii, ring.Step
	local count = #radii
	local function inside(angle: number): number
		local a = (math.deg(angle) % 360) / step
		local i = math.floor(a)
		local f = a - i
		return radii[i % count + 1] * (1 - f) + radii[(i + 1) % count + 1] * f
	end
	local base = attachPart.CFrame * (cfg.Offset or CFrame.identity)
	-- the band grows with the belt, so look a bit above and below it
	local low, high = ring.Bottom * 1.4, ring.Top * 1.4
	local points = {}
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, name in cfg.FitAround do
		local part = rig:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local cf = base:ToObjectSpace(part.CFrame)
			local h = part.Size / 2
			for i = 0, 16 do
				local u = i / 8 - 1
				for j = 0, 16 do
					local v = j / 8 - 1
					-- the four side faces of the part
					for _, q in { Vector3.new(h.X, v * h.Y, u * h.Z), Vector3.new(-h.X, v * h.Y, u * h.Z), Vector3.new(u * h.X, v * h.Y, h.Z), Vector3.new(u * h.X, v * h.Y, -h.Z) } do
						local p = cf * q
						if p.Y >= low and p.Y <= high then
							table.insert(points, p)
							minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
							minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
						end
					end
				end
			end
		end
	end
	if #points == 0 then
		return nil, Vector3.zero
	end
	local middle = Vector3.new(math.clamp((minX + maxX) / 2, -0.3, 0.3), 0, math.clamp((minZ + maxZ) / 2, -0.3, 0.3))
	local need = 0
	local gap = cfg.FitGap or 0.04
	for _, p in points do
		local dx, dz = p.X - middle.X, p.Z - middle.Z
		need = math.max(need, (math.sqrt(dx * dx + dz * dz) + gap) / inside(math.atan2(dz, dx)))
	end
	return math.clamp(need, 0.6, 2), middle
end

----------------------------------------------------------------------------------------
-- putting one piece on the rig
----------------------------------------------------------------------------------------
local function attachPiece(rig: Model, name: string): boolean
	local cfg = HairConfig.Hairs[name]
	local layout = HairConfig.Layouts[name]
	local attachPart = rig:FindFirstChild(layout.Attach)
	if not (attachPart and attachPart:IsA("BasePart")) then
		complain(("the Base rig has no %s part to put the %s on"):format(layout.Attach, name))
		return false
	end
	local bone, where = findSource(cfg.SignatureBone)
	if not bone then
		complain(
			("couldn't find the rigged %s (looking for its bone '%s'). Import the latest %s_Rigged.fbx (File > Import 3D) and put it in ServerStorage > %s; delete any older copy."):format(
				name,
				cfg.SignatureBone,
				name,
				HairConfig.ModelFolder
			)
		)
		return false
	end
	local mesh = copyMesh(bone)
	if not mesh then
		complain(("found the %s bones in %s but no mesh next to them"):format(name, where or "?"))
		return false
	end
	mesh.Name = name
	mesh.Anchored = false
	mesh.CanCollide = false
	mesh.CanTouch = false
	mesh.CanQuery = false
	mesh.Massless = true
	if mesh:IsA("MeshPart") and cfg.TextureId and cfg.TextureId ~= "" then
		mesh.TextureID = cfg.TextureId
	end
	if cfg.Color then
		mesh.Color = cfg.Color
	end
	if cfg.Material then
		mesh.Material = cfg.Material
	end

	-- where it goes: compare the modeled bone positions with the imported ones
	local design, actual = bonePairs(mesh, layout)
	if #design < 3 then
		complain(("the %s is missing its bones (found %d) — re-import it and keep the rig"):format(name, #design))
		mesh:Destroy()
		return false
	end
	local fit = HairPhysics.FitRig(design, actual)
	local wantScale = cfg.Scale or 1
	if cfg.ScaleToHead and attachPart:IsA("MeshPart") then
		local ratio = (attachPart.Size.X + attachPart.Size.Z) * 0.5 / (HairConfig.ReferenceHeadWidth or 1.2)
		if ratio > 0.5 and ratio < 3 then
			wantScale *= ratio
		end
	end
	local shift = Vector3.zero
	if cfg.FitAround and layout.Ring then
		local size, middle = waistFit(rig, attachPart, layout.Ring, cfg)
		if size then
			wantScale = size * (cfg.Scale or 1)
			shift = middle
			log(("sized the %s to wrap the waist (x%.3f)"):format(name, wantScale))
		end
	end
	if math.abs(fit.Scale / wantScale - 1) > 0.02 then
		local temp = Instance.new("Model")
		mesh.Parent = temp
		local ok, err = pcall(function()
			temp:ScaleTo(temp:GetScale() * wantScale / fit.Scale)
		end)
		mesh.Parent = nil
		temp:Destroy()
		if ok then
			design, actual = bonePairs(mesh, layout)
			fit = HairPhysics.FitRig(design, actual)
		else
			complain("couldn't resize the " .. name .. ": " .. tostring(err))
		end
	end
	if fit.Error > 0.05 * math.max(fit.Scale, 0.01) then
		complain(("the %s's bones don't match the expected layout (off by %.2f studs)"):format(name, fit.Error))
	end
	local centre = (layout.HeadCenter or Vector3.zero) * fit.Scale
	local attachToMesh = cfg.Offset * CFrame.new(shift - centre) * HairPhysics.HeadToPart(fit)

	local holder = Instance.new("Model")
	holder.Name = "DW_" .. name
	holder:SetAttribute(OWNED, true)
	mesh.CFrame = attachPart.CFrame * attachToMesh
	mesh.Parent = holder
	local weld = Instance.new("Weld")
	weld.Name = "DWWeld"
	weld.Part0 = attachPart
	weld.Part1 = mesh
	weld.C0 = attachToMesh
	weld.Parent = mesh
	mesh:SetAttribute("HairPreset", name)
	mesh:SetAttribute("FitScale", math.floor(fit.Scale * 1000 + 0.5) / 1000) -- how big it ended up (1 = as modeled)
	mesh:SetAttribute("VisibleIn", cfg.VisibleIn or "Both")
	mesh.Transparency = (cfg.VisibleIn == "SSJ") and 1 or 0
	CollectionService:AddTag(mesh, HairPhysics.TAG)
	holder.Parent = rig
	log(("put the %s on the %s (%d bones lined up)"):format(name, layout.Attach, #design))
	return true
end

----------------------------------------------------------------------------------------
-- build the StarterCharacter
----------------------------------------------------------------------------------------
local base = ReplicatedStorage:WaitForChild(PowerConfig.BaseRigName, 20)
if not (base and base:IsA("Model") and base:FindFirstChildOfClass("Humanoid")) then
	complain(("there's no R15 rig called '%s' (with a Humanoid) in ReplicatedStorage"):format(PowerConfig.BaseRigName))
	return
end

local template = base:Clone()
for _, d in template:GetDescendants() do
	-- the rig's own clothes / accessories are kept; only the players' avatar items get stripped
	if d:IsA("Accessory") or d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh") then
		d:SetAttribute(OWNED, true)
	end
	if d:IsA("BasePart") then
		d.Anchored = false
	end
end
for _, name in PIECES do
	local ok, err = pcall(attachPiece, template, name)
	if not ok then
		complain(("putting on the %s failed: %s"):format(name, tostring(err)))
	end
end
-- Roblox ties a skinned mesh to the first bone with a matching name anywhere in the character,
-- so two pieces with a bone of the same name would steal each other's bones (the hair then
-- never moves). Every piece's bones must have their own names.
do
	local owner = {}
	for _, d in template:GetDescendants() do
		if d:IsA("Bone") then
			local piece = d:FindFirstAncestorWhichIsA("MeshPart")
			local pieceName = piece and piece.Name or "?"
			if owner[d.Name] and owner[d.Name] ~= pieceName then
				complain(("the %s and the %s both have a bone called '%s', so one of them won't move. Re-import the latest %s_Rigged.fbx."):format(
					owner[d.Name], pieceName, d.Name, pieceName))
			end
			owner[d.Name] = owner[d.Name] or pieceName
		end
	end
end
template:SetAttribute("Form", "Base")
template:SetAttribute("PowerState", "Idle")
template:SetAttribute("Charge", 0)
template:SetAttribute("AuraWind", 0)
template.Name = "StarterCharacter"

local old = StarterPlayer:FindFirstChild("StarterCharacter")
if old then
	old:Destroy()
end
template.Parent = StarterPlayer

-- players' own avatars shouldn't be loaded onto the rig
local okAppearance = pcall(function()
	StarterPlayer.LoadCharacterAppearance = false
end)
if not okAppearance then
	complain("couldn't switch off StarterPlayer.LoadCharacterAppearance from a script — untick it in StarterPlayer's properties")
end
log("players now spawn as " .. PowerConfig.BaseRigName)

----------------------------------------------------------------------------------------
-- strip anything from the player's avatar that still gets added
----------------------------------------------------------------------------------------
local function isAvatarItem(inst: Instance): boolean
	return (
		inst:IsA("Accessory")
		or inst:IsA("Clothing")
		or inst:IsA("ShirtGraphic")
		or inst:IsA("BodyColors")
		or inst:IsA("CharacterMesh")
	) and not inst:GetAttribute(OWNED)
end

local function onCharacter(character: Model)
	for _, d in character:GetDescendants() do
		if isAvatarItem(d) then
			d:Destroy()
		end
	end
	-- avatar items can arrive a moment after spawning
	local connection = character.DescendantAdded:Connect(function(d)
		if isAvatarItem(d) then
			task.defer(function()
				if d.Parent then
					d:Destroy()
				end
			end)
		end
	end)
	task.delay(15, function()
		connection:Disconnect()
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		-- spawned before the morph was ready (can happen when testing in Studio): respawn
		if not player.Character:FindFirstChild("DW_Belt") and not player.Character:FindFirstChild("DW_BaseHair") then
			player:LoadCharacter()
		else
			onCharacter(player.Character)
		end
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">PowerUpServer</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerUpServer  (Script — lives in ServerScriptService)

	The referee for powering up. Players' computers tell it "I started charging", "my bar is at
	X", "I'm full — transform", "cancel" and "power down"; it checks those make sense and sets
	attributes on the character that every player's screen reads to draw the aura, pose and
	hair:
	  Form        "Base" or "SSJ"
	  PowerState  "Idle", "Charging" or "Bursting" (the moment of transformation)
	  Charge      0..1, how full the power bar is
	  AuraWind    0..1, how hard the aura blows the hair and belt upward
	It also swaps the visible hair (base <-> Super Saiyan) and stops you walking while charging.
	Settings: ReplicatedStorage > PowerConfig.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local remote = ReplicatedStorage:FindFirstChild("PowerUp")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "PowerUp"
	remote.Parent = ReplicatedStorage
end

local MAX_TAPS_PER_SECOND = 16 -- nobody taps faster than this, so the bar can't rise faster either
local STALE_SECONDS = 4 -- a charging player who goes quiet this long is cancelled

local info = {} -- [character] = { Started, LastUpdate, WalkSpeed, JumpPower, JumpHeight }

local function smoothstep(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

-- shows the pieces that belong to a form and hides the rest
local function applyForm(character: Model, form: string)
	character:SetAttribute("Form", form)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			local visibleIn = d:GetAttribute("VisibleIn")
			if visibleIn and visibleIn ~= "Both" then
				d.Transparency = (visibleIn == form) and 0 or 1
			end
		end
	end
end

local function lockMovement(character: Model, lock: boolean)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local st = info[character]
	if not humanoid or not st or not PowerConfig.LockMovement then
		return
	end
	if lock then
		st.WalkSpeed = st.WalkSpeed or humanoid.WalkSpeed
		st.JumpPower = st.JumpPower or humanoid.JumpPower
		st.JumpHeight = st.JumpHeight or humanoid.JumpHeight
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	else
		if st.WalkSpeed then
			humanoid.WalkSpeed = st.WalkSpeed
			humanoid.JumpPower = st.JumpPower
			humanoid.JumpHeight = st.JumpHeight
		end
		st.WalkSpeed, st.JumpPower, st.JumpHeight = nil, nil, nil
	end
end

local function idleWind(character: Model): number
	return character:GetAttribute("Form") == "SSJ" and PowerConfig.SSJCalmWind or 0
end

local function stopCharging(character: Model)
	character:SetAttribute("PowerState", "Idle")
	character:SetAttribute("Charge", 0)
	character:SetAttribute("AuraWind", idleWind(character))
	lockMovement(character, false)
end

local function burst(character: Model)
	character:SetAttribute("PowerState", "Bursting")
	character:SetAttribute("Charge", 1)
	character:SetAttribute("AuraWind", 1)
	applyForm(character, "SSJ")
	task.delay(PowerConfig.BurstTime, function()
		if character.Parent and character:GetAttribute("PowerState") == "Bursting" then
			stopCharging(character)
		end
	end)
end

remote.OnServerEvent:Connect(function(player: Player, action, value)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (character and humanoid and humanoid.Health > 0) then
		return
	end
	local state = character:GetAttribute("PowerState") or "Idle"
	local form = character:GetAttribute("Form") or "Base"
	local now = os.clock()
	info[character] = info[character] or {}
	local st = info[character]

	if action == "Start" then
		if state == "Idle" and form == "Base" then
			st.Started, st.LastUpdate = now, now
			character:SetAttribute("PowerState", "Charging")
			character:SetAttribute("Charge", 0)
			lockMovement(character, true)
		end
	elseif action == "Charge" then
		if state == "Charging" and typeof(value) == "number" and value == value then
			local previous = character:GetAttribute("Charge") or 0
			local allowedRise = PowerConfig.ChargePerTap * MAX_TAPS_PER_SECOND * (now - (st.LastUpdate or now)) + 0.02
			local charge = math.clamp(math.min(value, previous + allowedRise), 0, 1)
			st.LastUpdate = now
			character:SetAttribute("Charge", math.floor(charge * 100 + 0.5) / 100)
			character:SetAttribute("AuraWind", smoothstep(PowerConfig.HairStart, 1, charge))
		end
	elseif action == "Transform" then
		local charge = character:GetAttribute("Charge") or 0
		if state == "Charging" and charge >= 0.95 and now - (st.Started or now) >= PowerConfig.MinChargeTime - 0.2 then
			burst(character)
		end
	elseif action == "Cancel" then
		if state == "Charging" then
			stopCharging(character)
		end
	elseif action == "PowerDown" then
		if state == "Idle" and form == "SSJ" then
			applyForm(character, "Base")
			character:SetAttribute("AuraWind", 0)
		end
	end
end)

-- a charging player who stopped talking (closed the game, lagged out) is cancelled
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for character, st in info do
		if not character.Parent then
			info[character] = nil
		elseif character:GetAttribute("PowerState") == "Charging" and now - (st.LastUpdate or now) > STALE_SECONDS then
			stopCharging(character)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	if player.Character then
		info[player.Character] = nil
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">HairPhysicsClient</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairPhysicsClient  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Starts the hair simulation on this player's screen. Every hair the server tagged
	"HairPhysics" gets simulated here. Nothing to change in this script — the settings
	are in ReplicatedStorage > HairConfig.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))
HairPhysics.StartClient()
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="11">
        <Properties>
          <string name="Name">PowerUpClient</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerUpClient  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Your controls, camera and screen for powering up:
	  R      start powering up (the camera swings round to face you, you drop into a stance)
	         R again while charging cancels; R as a Super Saiyan powers down
	  Space  spam it to fill the power bar (phones: the big TAP button)
	When the bar is full you burst into Super Saiyan: the screen flashes, the camera kicks back,
	then hands control back to you. The aura, pose and hair are drawn by PowerFX and HairPhysics
	for everyone, using the attributes PowerUpServer sets.
	Settings: ReplicatedStorage > PowerConfig.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))
local remote = ReplicatedStorage:WaitForChild("PowerUp")
local player = Players.LocalPlayer

local SEND_EVERY = 0.1 -- seconds between bar updates sent to the server

----------------------------------------------------------------------------------------
-- screen
----------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "PowerUpUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(parent: Instance, props): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextScaled = true
	l.TextStrokeTransparency = 0.4
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local hint = label(gui, {
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.fromOffset(360, 26),
	Font = Enum.Font.GothamMedium,
	TextTransparency = 0.15,
})

local panel = Instance.new("Frame")
panel.Name = "Charge"
panel.AnchorPoint = Vector2.new(0.5, 1)
panel.Position = UDim2.new(0.5, 0, 1, -60)
panel.Size = UDim2.fromOffset(420, 130)
panel.BackgroundTransparency = 1
panel.Visible = false
panel.Parent = gui
local prompt = label(panel, {
	Name = "Prompt",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(1, 0, 0, 52),
	Text = "SPAM  SPACE!",
})
local promptScale = Instance.new("UIScale")
promptScale.Parent = prompt
local stage = label(panel, {
	Name = "Stage",
	Position = UDim2.new(0, 0, 0, 56),
	Size = UDim2.new(1, 0, 0, 22),
	Font = Enum.Font.GothamBold,
	Text = "",
})
local barBack = Instance.new("Frame")
barBack.Position = UDim2.new(0, 0, 0, 88)
barBack.Size = UDim2.new(1, 0, 0, 24)
barBack.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
barBack.BackgroundTransparency = 0.2
barBack.Parent = panel
Instance.new("UICorner").Parent = barBack
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.new(1, 1, 1)
stroke.Thickness = 2
stroke.Parent = barBack
local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = PowerConfig.BaseAuraColor
barFill.Parent = barBack
Instance.new("UICorner").Parent = barFill

local tapButton = Instance.new("TextButton")
tapButton.Name = "Tap"
tapButton.AnchorPoint = Vector2.new(1, 1)
tapButton.Position = UDim2.new(1, -30, 1, -40)
tapButton.Size = UDim2.fromOffset(150, 150)
tapButton.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
tapButton.Text = "TAP!"
tapButton.Font = Enum.Font.GothamBlack
tapButton.TextScaled = true
tapButton.TextColor3 = Color3.fromRGB(40, 20, 0)
tapButton.Visible = false
tapButton.Parent = gui
local tapCorner = Instance.new("UICorner")
tapCorner.CornerRadius = UDim.new(1, 0)
tapCorner.Parent = tapButton

local flash = Instance.new("Frame")
flash.Name = "Flash"
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundColor3 = Color3.new(1, 1, 1)
flash.BackgroundTransparency = 1
flash.ZIndex = 10
flash.Parent = gui
local bigText = label(gui, {
	Name = "Title",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(700, 90),
	Text = "SUPER SAIYAN!",
	TextColor3 = PowerConfig.SSJAuraColor,
	TextTransparency = 1,
	TextStrokeTransparency = 1,
	ZIndex = 11,
})

----------------------------------------------------------------------------------------
-- state
----------------------------------------------------------------------------------------
local character: Model? = nil
local charging = false
local bursting = false
local charge = 0
local full = false -- the bar filled up: it stays full until you transform
local startedAt = 0
local lastSend = 0
local transformSentAt = -math.huge
local savedCamera = nil
local camShake = 0
local fovKick = 0

local function attr(name: string)
	return character and character:GetAttribute(name)
end

local function refreshHint()
	if charging or bursting then
		hint.Text = ""
	elseif attr("Form") == "SSJ" then
		hint.Text = UserInputService.TouchEnabled and "POWER button  —  power down" or "R  —  power down"
	else
		hint.Text = UserInputService.TouchEnabled and "POWER button  —  power up" or "R  —  power up"
	end
end

----------------------------------------------------------------------------------------
-- camera: swings round in front of you while you power up
----------------------------------------------------------------------------------------
local function takeCamera()
	local camera = Workspace.CurrentCamera
	if not savedCamera then
		savedCamera = { Type = camera.CameraType, FOV = camera.FieldOfView }
	end
	camera.CameraType = Enum.CameraType.Scriptable
end

local function releaseCamera()
	local camera = Workspace.CurrentCamera
	if savedCamera then
		camera.CameraType = savedCamera.Type == Enum.CameraType.Scriptable and Enum.CameraType.Custom or savedCamera.Type
		TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = savedCamera.FOV }):Play()
		savedCamera = nil
	end
end

RunService:BindToRenderStep("DWPowerCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not savedCamera or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	if not root then
		return
	end
	local intensity = bursting and 1 or charge
	local distance = PowerConfig.CameraDistance * (bursting and 1.25 or (1 - 0.18 * charge))
	local base = root.CFrame
	local eye = base * Vector3.new(0, PowerConfig.CameraHeight - 0.3 * intensity, -distance) -- in front (characters face -Z)
	local look = base.Position + Vector3.new(0, PowerConfig.CameraLookHeight, 0)
	camShake = math.max(camShake - dt * 2, intensity * PowerConfig.CameraShake)
	local shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (2 * camShake)
	local target = CFrame.lookAt(eye + shake, look)
	camera.CFrame = camera.CFrame:Lerp(target, 1 - math.exp(-dt * 7))
	fovKick = math.max(0, fovKick - dt * 12)
	camera.FieldOfView = (savedCamera.FOV or 70) + fovKick
end)

----------------------------------------------------------------------------------------
-- charging
----------------------------------------------------------------------------------------
local function tap()
	if not charging then
		return
	end
	charge = math.min(1, charge + PowerConfig.ChargePerTap)
	if charge >= 1 then
		full = true
	end
	promptScale.Scale = 1.18
end

local function setTapBinding(on: boolean)
	if on then
		-- higher priority than the jump button, and "Sink" so spamming Space doesn't jump
		ContextActionService:BindActionAtPriority("DWTap", function(_, state)
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 10, PowerConfig.TapKey)
	else
		ContextActionService:UnbindAction("DWTap")
	end
	tapButton.Visible = on and UserInputService.TouchEnabled
end

local function startCharging()
	charging = true
	charge = 0
	full = false
	startedAt = os.clock()
	transformSentAt = -math.huge
	remote:FireServer("Start")
	takeCamera()
	panel.Visible = true
	prompt.Text = UserInputService.TouchEnabled and "TAP!  TAP!  TAP!" or "SPAM  SPACE!"
	setTapBinding(true)
	refreshHint()
end

local function stopCharging(sendCancel: boolean)
	if charging and sendCancel then
		remote:FireServer("Cancel")
	end
	charging = false
	charge = 0
	full = false
	panel.Visible = false
	setTapBinding(false)
	if not bursting then
		releaseCamera()
	end
	refreshHint()
end

local function playBurst()
	bursting = true
	charging = false
	panel.Visible = false
	setTapBinding(false)
	camShake = PowerConfig.CameraShake * 4
	fovKick = 18
	flash.BackgroundTransparency = 0
	TweenService:Create(flash, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
	bigText.TextTransparency = 0
	bigText.TextStrokeTransparency = 0.2
	bigText.Size = UDim2.fromOffset(500, 70)
	TweenService:Create(bigText, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(760, 100) }):Play()
	task.delay(1.6, function()
		TweenService:Create(bigText, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	task.delay(PowerConfig.BurstTime, function()
		bursting = false
		releaseCamera()
		refreshHint()
	end)
end

local function onPowerKey(_, state)
	if state ~= Enum.UserInputState.Begin or not character then
		return Enum.ContextActionResult.Pass
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or bursting then
		return Enum.ContextActionResult.Sink
	end
	if charging then
		stopCharging(true)
	elseif attr("Form") == "SSJ" then
		remote:FireServer("PowerDown")
	else
		startCharging()
	end
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("DWPower", onPowerKey, true, PowerConfig.PowerKey)
ContextActionService:SetTitle("DWPower", "Power")

tapButton.Activated:Connect(tap)

local STAGES = {
	{ 0.0, "Gather your energy..." },
	{ PowerConfig.AuraStart, "Aura rising!" },
	{ PowerConfig.HairStart, "Power surging!" },
	{ 0.6, "Faster!!" },
	{ 0.85, "BREAK THROUGH!!!" },
}

RunService.RenderStepped:Connect(function(dt)
	if not charging then
		return
	end
	if os.clock() - startedAt > 1.2 and attr("PowerState") ~= "Charging" then
		stopCharging(false) -- the server didn't accept (e.g. already transforming)
		return
	end
	if full then
		charge = 1
	else
		charge = math.max(0, charge - PowerConfig.ChargeDecay * dt)
	end
	promptScale.Scale += (1 - promptScale.Scale) * math.min(1, dt * 10)
	barFill.Size = UDim2.new(charge, 0, 1, 0)
	barFill.BackgroundColor3 = PowerConfig.BaseAuraColor:Lerp(PowerConfig.SSJAuraColor, charge)
	local text = STAGES[1][2]
	for _, s in STAGES do
		if charge >= s[1] then
			text = s[2]
		end
	end
	stage.Text = text
	local now = os.clock()
	if now - lastSend >= SEND_EVERY then
		lastSend = now
		remote:FireServer("Charge", charge)
	end
	if full and now - startedAt >= PowerConfig.MinChargeTime and now - transformSentAt > 0.6 then
		transformSentAt = now
		remote:FireServer("Charge", 1)
		remote:FireServer("Transform")
	end
end)

----------------------------------------------------------------------------------------
-- follow the character and the server's verdicts
----------------------------------------------------------------------------------------
local function onCharacter(newCharacter: Model)
	character = newCharacter
	charging, bursting = false, false
	panel.Visible = false
	setTapBinding(false)
	releaseCamera()
	newCharacter:GetAttributeChangedSignal("PowerState"):Connect(function()
		local state = newCharacter:GetAttribute("PowerState")
		if state == "Bursting" and not bursting then
			playBurst()
		elseif state == "Idle" and charging then
			stopCharging(false) -- the server cancelled us
		end
		refreshHint()
	end)
	newCharacter:GetAttributeChangedSignal("Form"):Connect(refreshHint)
	local humanoid = newCharacter:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.Died:Connect(function()
			stopCharging(false)
			bursting = false
			releaseCamera()
		end)
	end
	refreshHint()
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	onCharacter(player.Character)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">PowerFX</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerFX  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Draws powering up for EVERY character on this player's screen, from the attributes
	PowerUpServer sets (so everyone sees everyone's aura):
	  * the ready stance while charging (knees bent, fists clenched, trembling with power) and a
	    head-back, arms-out "scream" pose at the moment of transformation,
	  * the aura — flames licking upward around the body that get bigger, faster and denser
	    the fuller the power bar is; white for base form, gold for Super Saiyan,
	  * a glow that lights up the surroundings, dust blasting off the ground and rocks lifting
	    up at high power,
	  * the transformation burst: a flash, a shockwave ring across the ground and a big spray.
	The hair and belt being blown upward is HairPhysics reacting to the AuraWind attribute.
	Settings: ReplicatedStorage > PowerConfig.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local ROCKS = 8
local S = PowerConfig.AuraSize

local folder = Instance.new("Folder")
folder.Name = "PowerFX"
folder.Parent = Workspace

----------------------------------------------------------------------------------------
-- the stance (rotations of each R15 joint; characters face -Z, so +X rotation = forward)
----------------------------------------------------------------------------------------
local STANCE = {
	Root = CFrame.new(0, -0.18, 0),
	Waist = CFrame.Angles(-0.14, 0, 0), -- hunched slightly forward, straining
	Neck = CFrame.Angles(0.08, 0, 0),
	LeftShoulder = CFrame.Angles(-0.25, 0, -0.38), -- upper arms back and out
	RightShoulder = CFrame.Angles(-0.25, 0, 0.38),
	LeftElbow = CFrame.Angles(1.05, 0, 0), -- forearms up, fists clenched by the hips
	RightElbow = CFrame.Angles(1.05, 0, 0),
	LeftWrist = CFrame.Angles(0.15, 0, 0),
	RightWrist = CFrame.Angles(0.15, 0, 0),
	LeftHip = CFrame.Angles(0.32, 0, -0.28), -- feet apart, knees bent
	RightHip = CFrame.Angles(0.32, 0, 0.28),
	LeftKnee = CFrame.Angles(-0.6, 0, 0),
	RightKnee = CFrame.Angles(-0.6, 0, 0),
	LeftAnkle = CFrame.Angles(0.28, 0, 0.1),
	RightAnkle = CFrame.Angles(0.28, 0, -0.1),
}
local SCREAM = { -- the moment of transformation: chest out, head back, arms flung wide
	Root = CFrame.new(0, -0.1, 0),
	Waist = CFrame.Angles(0.28, 0, 0),
	Neck = CFrame.Angles(0.45, 0, 0),
	LeftShoulder = CFrame.Angles(0.15, 0, -1.25),
	RightShoulder = CFrame.Angles(0.15, 0, 1.25),
	LeftElbow = CFrame.Angles(0.35, 0, 0),
	RightElbow = CFrame.Angles(0.35, 0, 0),
	LeftWrist = CFrame.identity,
	RightWrist = CFrame.identity,
	LeftHip = CFrame.Angles(0.25, 0, -0.32),
	RightHip = CFrame.Angles(0.25, 0, 0.32),
	LeftKnee = CFrame.Angles(-0.45, 0, 0),
	RightKnee = CFrame.Angles(-0.45, 0, 0),
	LeftAnkle = CFrame.Angles(0.2, 0, 0.1),
	RightAnkle = CFrame.Angles(0.2, 0, -0.1),
}

----------------------------------------------------------------------------------------
-- building one character's effects
----------------------------------------------------------------------------------------
local function fxPart(name: string, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size
	p.Parent = folder
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightInfluence = 0
	for k, v in props do
		e[k] = v
	end
	e.Parent = parent
	return e
end

local function newFX(character: Model)
	local fx = { Character = character, Intensity = 0, Pose = 0, Scream = 0, Color = PowerConfig.BaseAuraColor }
	fx.Aura = fxPart("Aura", Vector3.new(3.2, 5.6, 3.2) * S)
	fx.Flame = emitter(fx.Aura, {
		Texture = FIRE,
		LightEmission = 1,
		Shape = Enum.ParticleEmitterShape.Cylinder,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward,
		EmissionDirection = Enum.NormalId.Top,
		Lifetime = NumberRange.new(0.35, 0.65),
		Acceleration = Vector3.new(0, 14, 0),
		Drag = 0.5,
		SpreadAngle = Vector2.new(6, 6),
		Rotation = NumberRange.new(-30, 30),
		RotSpeed = NumberRange.new(-90, 90),
		Squash = NumberSequence.new(-0.6),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.75),
			NumberSequenceKeypoint.new(0.2, 0.25),
			NumberSequenceKeypoint.new(0.75, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	fx.Haze = emitter(fx.Aura, {
		Texture = SMOKE,
		LightEmission = 1,
		EmissionDirection = Enum.NormalId.Top,
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(1, 1) }),
	})
	fx.Sparks = emitter(fx.Aura, {
		Texture = SPARK,
		LightEmission = 1,
		Shape = Enum.ParticleEmitterShape.Cylinder,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection = Enum.NormalId.Top,
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(12, 22),
		SpreadAngle = Vector2.new(30, 30),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * S), NumberSequenceKeypoint.new(1, 0) }),
	})
	fx.Light = Instance.new("PointLight")
	fx.Light.Shadows = false
	fx.Light.Brightness = 0
	fx.Light.Parent = fx.Aura

	fx.Ground = fxPart("GroundFX", Vector3.new(1, 0.2, 1))
	fx.Dust = emitter(fx.Ground, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(190, 180, 165)),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(88, 88),
		Speed = NumberRange.new(18, 28),
		Drag = 3,
		Acceleration = Vector3.new(0, 3, 0),
		Lifetime = NumberRange.new(0.8, 1.4),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5 * S), NumberSequenceKeypoint.new(1, 5 * S) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		LightInfluence = 1,
	})

	fx.Rocks = {}
	local rng = Random.new()
	for i = 1, ROCKS do
		local rock = fxPart("Rock", Vector3.new(1, 1, 1) * rng:NextNumber(0.35, 0.8) * S)
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(110, 104, 98)
		table.insert(fx.Rocks, {
			Part = rock,
			Angle = (i / ROCKS) * math.pi * 2 + rng:NextNumber(-0.3, 0.3),
			Radius = rng:NextNumber(3, 5.5) * S,
			Top = rng:NextNumber(1.2, 3.8),
			Height = 0,
			Spin = rng:NextNumber(-1.5, 1.5),
			Bob = rng:NextNumber(0, 6),
		})
	end

	-- the stance needs the character's joints (looked up once)
	fx.Motors = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and STANCE[d.Name] then
			fx.Motors[d.Name] = d
		end
	end
	fx.LastWritten = {}
	return fx
end

-- true if two joint angles are the same (reading one back can lose a hair of precision)
local function sameFrame(a: CFrame, b: CFrame): boolean
	local ca = { a:GetComponents() }
	local cb = { b:GetComponents() }
	for k = 1, 12 do
		if math.abs(ca[k] - cb[k]) > 1e-4 then
			return false
		end
	end
	return true
end

local function destroyFX(fx)
	fx.Aura:Destroy()
	fx.Ground:Destroy()
	for _, r in fx.Rocks do
		r.Part:Destroy()
	end
	for name, motor in fx.Motors do
		if motor.Parent and fx.LastWritten[name] and sameFrame(motor.Transform, fx.LastWritten[name]) then
			motor.Transform = CFrame.identity
		end
	end
end

----------------------------------------------------------------------------------------
-- the transformation burst
----------------------------------------------------------------------------------------
local function playBurst(fx, root: BasePart, groundY: number)
	fx.Flame:Emit(120)
	fx.Sparks:Emit(80)
	fx.Dust:Emit(60)
	fx.Light.Brightness = 14
	local color = PowerConfig.SSJAuraColor
	local ring = fxPart("Shockwave", Vector3.new(0.3, 2, 2))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.15
	ring.CFrame = CFrame.new(root.Position.X, groundY + 0.15, root.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
	TweenService:Create(ring, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, 36 * S, 36 * S),
		Transparency = 1,
	}):Play()
	local ball = fxPart("Flash", Vector3.new(2, 2, 2))
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.new(1, 1, 0.9)
	ball.Transparency = 0.1
	ball.CFrame = root.CFrame
	TweenService:Create(ball, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(16, 16, 16) * S,
		Transparency = 1,
	}):Play()
	task.delay(0.9, function()
		ring:Destroy()
		ball:Destroy()
	end)
	fx.Scream = 1
end

----------------------------------------------------------------------------------------
-- every frame
----------------------------------------------------------------------------------------
local active = {} -- [character] = fx
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

local function targetIntensity(character: Model): number
	local state = character:GetAttribute("PowerState")
	if state == "Charging" then
		local c = character:GetAttribute("Charge") or 0
		return c >= PowerConfig.AuraStart and math.max(c, 0.12) or 0
	elseif state == "Bursting" then
		return 1.3
	elseif character:GetAttribute("Form") == "SSJ" then
		return PowerConfig.SSJIdleAura
	end
	return 0
end

local function characters()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	return list
end

local moveParts, moveFrames = {}, {}

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	table.clear(moveParts)
	table.clear(moveFrames)
	local seen = {}
	local finished = {}
	local filter = characters()
	table.insert(filter, folder)
	groundParams.FilterDescendantsInstances = filter
	local now = os.clock()

	for _, character in characters() do
		seen[character] = true
		local root = character:FindFirstChild("HumanoidRootPart")
		local want = targetIntensity(character)
		local state = character:GetAttribute("PowerState")
		local fx = active[character]
		if not fx and (want > 0 or state == "Charging") and root then
			fx = newFX(character)
			active[character] = fx
		end
		if fx and root then
			-- smooth ramps: fast up, slower down
			local rate = want > fx.Intensity and 5 or 2
			fx.Intensity += (want - fx.Intensity) * (1 - math.exp(-dt * rate))
			local i = fx.Intensity
			local gold = character:GetAttribute("Form") == "SSJ" or state == "Bursting"
			local targetColor = gold and PowerConfig.SSJAuraColor or PowerConfig.BaseAuraColor
			fx.Color = fx.Color:Lerp(targetColor, 1 - math.exp(-dt * 6))

			if state == "Bursting" and not fx.Burst then
				fx.Burst = true
				local hit = Workspace:Raycast(root.Position, Vector3.new(0, -12, 0), groundParams)
				playBurst(fx, root, hit and hit.Position.Y or root.Position.Y - 3)
			elseif state ~= "Bursting" then
				fx.Burst = false
			end

			-- aura
			local visible = i > 0.02
			local sizeMul = (0.8 + 0.9 * i) * S
			fx.Aura.Size = Vector3.new(3 * sizeMul, (4.8 + 2.4 * i) * S, 3 * sizeMul)
			table.insert(moveParts, fx.Aura)
			table.insert(moveFrames, root.CFrame * CFrame.new(0, -0.4 + 0.5 * i, 0))
			fx.Flame.Rate = visible and (30 + 300 * i) or 0
			fx.Flame.Speed = NumberRange.new(4 + 11 * i, 8 + 18 * i)
			fx.Flame.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.9 * sizeMul),
				NumberSequenceKeypoint.new(0.4, 1.7 * sizeMul),
				NumberSequenceKeypoint.new(1, 0.15),
			})
			fx.Flame.Color = ColorSequence.new(Color3.new(1, 1, 1), fx.Color)
			fx.Haze.Rate = visible and (6 + 20 * i) or 0
			fx.Haze.Size = NumberSequence.new(4 * sizeMul)
			fx.Haze.Color = ColorSequence.new(fx.Color)
			fx.Sparks.Rate = i > 0.5 and 60 * (i - 0.5) or 0
			fx.Sparks.Color = ColorSequence.new(fx.Color)
			fx.Light.Color = fx.Color
			fx.Light.Range = visible and (6 + 14 * i) or 0
			fx.Light.Brightness += ((visible and (0.8 + 4 * i) or 0) - fx.Light.Brightness) * (1 - math.exp(-dt * 6))

			-- ground: dust and lifting rocks (only if there's ground close below)
			local hit = Workspace:Raycast(root.Position, Vector3.new(0, -8, 0), groundParams)
			local groundY = hit and hit.Position.Y
			if groundY then
				table.insert(moveParts, fx.Ground)
				table.insert(moveFrames, CFrame.new(root.Position.X, groundY + 0.2, root.Position.Z))
			end
			fx.Dust.Rate = (groundY and i > 0.55) and 40 * (i - 0.55) / 0.45 or 0
			for _, rock in fx.Rocks do
				local lift = (groundY and i > 0.7) and rock.Top * math.clamp((i - 0.7) / 0.3, 0, 1) or 0
				if lift > rock.Height then
					rock.Height += (lift - rock.Height) * (1 - math.exp(-dt * 1.5))
				else
					rock.Height = math.max(lift, rock.Height - dt * 6) -- falls back down
				end
				if rock.Height > 0.02 and groundY then
					rock.Part.Transparency = 0
					rock.Angle += dt * 0.25
					local pos = root.Position + Vector3.new(math.cos(rock.Angle), 0, math.sin(rock.Angle)) * rock.Radius
					local bob = math.sin(now * 2 + rock.Bob) * 0.15 * math.min(1, rock.Height)
					table.insert(moveParts, rock.Part)
					table.insert(moveFrames, CFrame.new(pos.X, groundY + rock.Part.Size.Y / 2 + rock.Height + bob, pos.Z)
						* CFrame.Angles(now * rock.Spin, now * rock.Spin * 0.7, 0))
				else
					rock.Part.Transparency = 1
				end
			end

			-- stance blending
			local wantPose = (state == "Charging" or state == "Bursting") and 1 or 0
			fx.Pose += (wantPose - fx.Pose) * (1 - math.exp(-dt * 7))
			fx.Scream = (state == "Bursting") and math.max(fx.Scream - dt * 0.6, 0) or math.max(fx.Scream - dt * 3, 0)
			fx.Tremble = i

			-- tidy up once fully calm
			if want <= 0 and fx.Intensity < 0.01 and fx.Pose < 0.01 and state ~= "Charging" then
				table.insert(finished, fx)
				active[character] = nil
			end
		end
	end
	for character, fx in active do
		if not seen[character] or not character.Parent then
			table.insert(finished, fx)
			active[character] = nil
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	-- removed only after this frame's moves, so nothing moves a part that's already gone
	for _, fx in finished do
		destroyFX(fx)
	end
end)

-- The pose goes on after Roblox has played the character's animations for this frame, blended
-- with them by how far into the stance we are.
RunService.Stepped:Connect(function()
	local t = os.clock()
	for _, fx in active do
		if fx.Pose > 0.001 then
			local w = math.min(fx.Pose, 1)
			local tremble = (fx.Tremble or 0) * 0.025
			for name, motor in fx.Motors do
				if motor.Parent then
					local current = motor.Transform
					-- if the animator didn't touch this joint since our last write, blend from rest
					if fx.LastWritten[name] and sameFrame(current, fx.LastWritten[name]) then
						current = CFrame.identity
					end
					local pose = STANCE[name]:Lerp(SCREAM[name], fx.Scream)
					if tremble > 0 and (name == "Waist" or name == "Neck" or name == "Root") then
						pose *= CFrame.Angles(math.sin(t * 41) * tremble, math.sin(t * 37) * tremble, math.sin(t * 29) * tremble)
					end
					local final = current:Lerp(pose, w)
					motor.Transform = final
					fx.LastWritten[name] = final
				end
			end
		else
			table.clear(fx.LastWritten)
		end
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">HairFitTool</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairFitTool  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	A little panel for lining the hair and belt up on your character while the game is running.
	Press H (or tap the "Fit" button on a phone) to open or close it.

	  Prev / Next   pick which piece you're moving: base hair, Super Saiyan hair or belt
	                (it gets an outline; the Super Saiyan hair only shows once you transform)
	  Up, Down, Left, Right, Fwd, Back   move it 0.05 studs (hold Shift on a keyboard
	                                      for 0.01)
	  Reset         undo this session's nudges

	The box at the bottom shows the Offset line for HairConfig, e.g.
	    Offset = CFrame.new(0, 0.05, -0.02),
	Copy it into that piece's entry in ReplicatedStorage > HairConfig to keep it.
	(The nudges only change what you see in this play session.) Directions are relative to
	the body part the piece is fixed to (the head for hair, the waist for the belt).

	Turn the tool off with HairConfig.FitToolEnabled = false.
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))

if not HairConfig.FitToolEnabled then
	return
end

local STEP = 0.05
local FINE_STEP = 0.01

local player = Players.LocalPlayer
local nudges = {} -- [hair part] = total nudge this session (head space: right, up, back)
local selectedIndex = 1
local gui, title, readout, highlight

local function tagged(): { BasePart }
	local list = {}
	local character = player.Character
	for _, part in CollectionService:GetTagged(HairPhysics.TAG) do
		if part:IsA("BasePart") and character and part:IsDescendantOf(character) then
			table.insert(list, part)
		end
	end
	table.sort(list, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return list
end

local function selectedHair(): BasePart?
	local list = tagged()
	if #list == 0 then
		return nil
	end
	selectedIndex = (selectedIndex - 1) % #list + 1
	return list[selectedIndex]
end

-- The weld holding the piece on, and the body part it's fixed to.
local function findWeld(hair: BasePart): (JointInstance?, BasePart?)
	for _, child in hair:GetChildren() do
		if child:IsA("JointInstance") then
			local other = child.Part0 == hair and child.Part1 or child.Part0
			if other then
				return child, other
			end
		end
	end
	return nil
end

local function offsetLine(hair: BasePart): string
	local preset = hair:GetAttribute("HairPreset")
	local cfg = HairConfig.Hairs[preset]
	local base = cfg and cfg.Offset or CFrame.identity
	local p = base.Position + (nudges[hair] or Vector3.zero)
	local function n(x: number): string
		local str = string.format("%.2f", x)
		if str == "0.00" or str == "-0.00" then
			return "0"
		end
		return (str:gsub("0+$", ""):gsub("%.$", ""))
	end
	return ("Offset = CFrame.new(%s, %s, %s),"):format(n(p.X), n(p.Y), n(p.Z))
end

local function refresh()
	if not gui then
		return
	end
	local hair = selectedHair()
	if hair then
		title.Text = ("Fit: %s"):format(tostring(hair:GetAttribute("HairPreset")))
		readout.Text = offsetLine(hair)
		highlight.Adornee = hair
	else
		title.Text = "Fit: nothing to fit yet"
		readout.Text = ""
		highlight.Adornee = nil
	end
end

-- Moves a hair by delta (head space: right, up, back) by adjusting the weld that holds it.
local function applyDelta(hair: BasePart, delta: Vector3)
	local weld, head = findWeld(hair)
	if not weld or not head then
		warn("[HairFitTool] couldn't find the weld holding " .. hair:GetFullName())
		return
	end
	if weld.Part0 == head then
		local current = weld.C0 * weld.C1:Inverse()
		weld.C0 = CFrame.new(delta) * current * weld.C1
	else
		local current = weld.C1 * weld.C0:Inverse()
		weld.C1 = CFrame.new(delta) * current * weld.C0
	end
	nudges[hair] = (nudges[hair] or Vector3.zero) + delta
	refresh()
end

local function nudge(direction: Vector3)
	local hair = selectedHair()
	if hair then
		local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		applyDelta(hair, direction * (fine and FINE_STEP or STEP))
	end
end

local function reset()
	local hair = selectedHair()
	if hair and nudges[hair] then
		applyDelta(hair, -nudges[hair])
		nudges[hair] = Vector3.zero
		refresh()
	end
end

local function makeButton(parent: Instance, text: string, pos: UDim2, size: UDim2, onClick: () -> ())
	local b = Instance.new("TextButton")
	b.Text = text
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextScaled = true
	b.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

local function buildGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "HairFitTool"
	gui.ResetOnSpawn = false
	gui.Enabled = false

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0, 1)
	frame.Position = UDim2.new(0, 12, 1, -12)
	frame.Size = UDim2.fromOffset(300, 250)
	frame.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
	frame.BackgroundTransparency = 0.1
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(10, 6)
	title.Size = UDim2.new(1, -20, 0, 24)
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local w, h = 88, 32
	local function at(col: number, row: number)
		return UDim2.fromOffset(10 + col * (w + 6), 36 + row * (h + 6))
	end
	local size = UDim2.fromOffset(w, h)
	makeButton(frame, "Prev", at(0, 0), size, function()
		selectedIndex -= 1
		refresh()
	end)
	makeButton(frame, "Reset", at(1, 0), size, reset)
	makeButton(frame, "Next", at(2, 0), size, function()
		selectedIndex += 1
		refresh()
	end)
	makeButton(frame, "Up", at(1, 1), size, function()
		nudge(Vector3.yAxis)
	end)
	makeButton(frame, "Left", at(0, 2), size, function()
		nudge(-Vector3.xAxis)
	end)
	makeButton(frame, "Down", at(1, 2), size, function()
		nudge(-Vector3.yAxis)
	end)
	makeButton(frame, "Right", at(2, 2), size, function()
		nudge(Vector3.xAxis)
	end)
	makeButton(frame, "Fwd", at(0, 1), size, function()
		nudge(-Vector3.zAxis)
	end)
	makeButton(frame, "Back", at(2, 1), size, function()
		nudge(Vector3.zAxis)
	end)

	-- a TextBox so the line can be selected and copied
	readout = Instance.new("TextBox")
	readout.ClearTextOnFocus = false
	readout.TextEditable = false
	readout.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 4)
	readout.Size = UDim2.new(1, -20, 0, 30)
	readout.BackgroundColor3 = Color3.fromRGB(12, 13, 16)
	readout.TextColor3 = Color3.fromRGB(140, 220, 160)
	readout.Font = Enum.Font.Code
	readout.TextScaled = true
	readout.Parent = frame
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 6)
	rc.Parent = readout

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 38)
	hint.Size = UDim2.new(1, -20, 0, 16)
	hint.Font = Enum.Font.Gotham
	hint.TextColor3 = Color3.fromRGB(170, 175, 185)
	hint.TextScaled = true
	hint.Text = "Copy this line into HairConfig to keep it"
	hint.Parent = frame

	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 200, 60)
	highlight.Enabled = false
	highlight.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function toggle(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if not gui then
		buildGui()
	end
	gui.Enabled = not gui.Enabled
	highlight.Enabled = gui.Enabled
	refresh()
	if gui.Enabled then
		local hair = selectedHair()
		if hair then
			print("[HairFitTool] " .. tostring(hair:GetAttribute("HairPreset")) .. ": " .. offsetLine(hair))
		end
	end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction("HairFitTool", toggle, true, HairConfig.FitToolKey or Enum.KeyCode.H)
ContextActionService:SetTitle("HairFitTool", "Fit")
ContextActionService:SetPosition("HairFitTool", UDim2.new(1, -70, 0, 10))
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">ServerStorage</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">CharacterParts</string>
        </Properties>
      </Item>
