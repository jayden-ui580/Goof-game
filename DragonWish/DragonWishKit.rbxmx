      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">PowerConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerConfig  (ModuleScript — lives in ReplicatedStorage)

	Settings for powering up: turning Super Saiyan, and the Kaioken.
	How it plays: press R -> the camera swings round in front of you and you drop into a ready
	stance -> spam Space (or tap the TAP button on a phone) -> the aura appears, then grows
	bigger and faster, your hair and belt get blown upward -> fill the bar and you burst into
	Super Saiyan (and point at the camera: "YOU'RE FINISHED!"); the golden hair then flows
	calmly. Press R again as a Super Saiyan to power down.
	Kaioken (base form only): press K to light it, again to push it higher. More power, faster
	legs, a red aura ... and it eats your health every second. R lets it go.
]]

local PowerConfig = {}

PowerConfig.BaseRigName = "Base" -- the R15 rig in ReplicatedStorage every player becomes

-- controls
PowerConfig.PowerKey = Enum.KeyCode.R -- start powering up / cancel / power down
PowerConfig.TapKey = Enum.KeyCode.Space -- spam this to charge

-- charging
PowerConfig.ChargePerTap = 0.05 -- how much each tap fills the bar (0..1)
PowerConfig.ChargeDecay = 0.16 -- how much the bar drains per second if you stop tapping
PowerConfig.MinChargeTime = 2.5 -- you have to charge at least this long before transforming
PowerConfig.AuraStart = 0.06 -- bar level where the aura flickers on
PowerConfig.HairStart = 0.25 -- bar level where the hair and belt start lifting
PowerConfig.LockMovement = true -- you can't walk or jump while powering up

-- the transformation
PowerConfig.BurstTime = 6.9 -- seconds the transformation takes (the cutscene plays during it);
-- you get control back after it
PowerConfig.ExplodeAt = 2.2 -- seconds into the transformation when the power explodes out (pillar
-- of light, shockwave, you throw your arms out)
PowerConfig.PointAt = 4.3 -- seconds into the transformation when you start the "YOU'RE FINISHED!"
-- point: left hand on the inside of your right elbow, then a swipe into a point at the camera.
-- It lands 0.8 s later; keep BurstTime at least 1.8 s after this so it holds a moment
PowerConfig.SSJCalmWind = 0.12 -- a gentle upward lift on the hair while the Super Saiyan aura is up
-- (0..1); the sideways breeze is the SSJ hair's LocalWind in HairConfig
PowerConfig.SSJIdleAura = 0.75 -- how strong the golden aura stays after transforming (0 = none)
PowerConfig.SSJCalmAfter = 20 -- seconds after you get control back until your hair and aura calm down
PowerConfig.SSJCalmTime = 4 -- seconds the calming down takes

-- the transformation cutscene (only the player transforming sees it)
PowerConfig.Cutscene = true
PowerConfig.CutsceneText = { "THIS IS—", "SUPER SAIYAN!", "YOU'RE FINISHED!" } -- the three manga panels

-- Kaioken (King Kai's technique; base form only). Each press of K lights it or pushes it a
-- level higher: every level burns one ki pip (KaiokenKiCost), multiplies your power level and
-- walk speed, and strains your body: you lose health every second. If your health falls to
-- KaiokenFloor your body gives out: the Kaioken stops and you're exhausted (slow, no powering
-- up) for KaiokenExhaustTime seconds. R lets it go. (Roblox heals you 1 health a second on its
-- own, so the lowest level barely hurts.)
PowerConfig.KaiokenKey = Enum.KeyCode.K
PowerConfig.KaiokenLevels = { 2, 3, 4, 10, 20 } -- the multiplier at each level: x2, x3, x4, x10, x20
PowerConfig.KaiokenStrain = { 1.5, 2.5, 4, 8, 16 } -- health lost per second at each level
PowerConfig.KaiokenSpeed = { 1.15, 1.2, 1.25, 1.4, 1.6 } -- walk speed multiplier at each level
PowerConfig.KaiokenAura = { 0.55, 0.65, 0.75, 0.95, 1.15 } -- how big the red aura burns at each level
PowerConfig.KaiokenKiCost = 20 -- ki each level costs (one of the five pips on the HUD)
PowerConfig.KaiokenCooldown = 0.6 -- seconds between level-ups
PowerConfig.KaiokenFloor = 10 -- health at which your body gives out
PowerConfig.KaiokenExhaustTime = 4 -- seconds you're exhausted afterwards
PowerConfig.ExhaustedSpeed = 0.55 -- walk speed multiplier while exhausted

-- HUD
PowerConfig.KiMax = 100
PowerConfig.KiStart = 30 -- ki when you spawn
PowerConfig.KiRegen = 1.5 -- ki per second while you're not charging (charging fills it fast)
PowerConfig.BasePowerLevel = 1500 -- what the scouter reads in base form at rest
PowerConfig.ChargePowerBoost = 4 -- charging multiplies it up to this much more
PowerConfig.SSJMultiplier = 50 -- Super Saiyan power level = base x this
PowerConfig.RadarRange = 250 -- studs the Dragon Radar can see other players

-- looks
PowerConfig.BaseAuraColor = Color3.fromRGB(110, 205, 255) -- main colour of the flames
PowerConfig.BaseAuraEdge = Color3.fromRGB(30, 115, 255) -- colour at the flame tips
PowerConfig.SSJAuraColor = Color3.fromRGB(255, 210, 70)
PowerConfig.SSJAuraEdge = Color3.fromRGB(255, 125, 25)
PowerConfig.KaiokenAuraColor = Color3.fromRGB(255, 72, 52)
PowerConfig.KaiokenAuraEdge = Color3.fromRGB(205, 0, 28)
PowerConfig.KaiokenGlow = Color3.fromRGB(255, 40, 40) -- the red glow over your whole body
PowerConfig.AuraSize = 1 -- scales the whole aura
PowerConfig.AuraFlames = 1 -- how many flame tongues (1 = normal; lower it if lots of players lag)
PowerConfig.AuraFrameRate = 24 -- how many times a second the aura's flames change shape. Low
-- (12-15) flickers like hand-drawn anime frames; 60 is smooth

-- camera (front view while powering up)
PowerConfig.CameraDistance = 9 -- studs in front of you
PowerConfig.CameraHeight = 0.8 -- studs above your waist
PowerConfig.CameraLookHeight = 1.4 -- the camera looks at this height above your waist
PowerConfig.CameraShake = 0.22 -- strongest shake (studs) at full power

return PowerConfig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DragonUI</string>
          <ProtectedString name="Source"><![CDATA[--[[
	DragonUI  (ModuleScript — lives in ReplicatedStorage)

	The look of Dragon Wish's screens, shared by the HUD and the power-up controls. It borrows from
	how the Dragon Ball fighting games dress their screens (FighterZ, Sparking! ZERO) and from
	Persona 5's rules for stylish menus:
	  * no rounded boxes: everything is a SLAB, a slanted parallelogram ("/" at both ends), and
	    every slab leans the same way
	  * a tight palette: ink black, warm paper and Saiyan-gi orange, with colour only where it
	    means something (yellow health, red damage, blue ki that turns gold as a Super Saiyan)
	  * comic lettering: Bangers with an ink outline, printed twice, slightly offset
	  * Dragon Balls, halftone dots and hard shadows (solid, not blurred)
	Everything here is plain Frames and TextLabels: no uploaded images.

	One rule: never put a slab inside a ROTATED frame. A slab cuts its slanted ends out with
	ClipsDescendants, and Roblox stops clipping inside anything that is rotated.
]]

local DragonUI = {}

DragonUI.INK = Color3.fromRGB(16, 14, 20)
DragonUI.INK_SOFT = Color3.fromRGB(46, 42, 58) -- empty gauges on an ink panel
DragonUI.PAPER = Color3.fromRGB(250, 244, 228)
DragonUI.GI = Color3.fromRGB(255, 122, 24) -- Goku's gi orange
DragonUI.GI_DARK = Color3.fromRGB(176, 66, 10)
DragonUI.GOLD = Color3.fromRGB(255, 200, 44) -- Super Saiyan
DragonUI.HP = Color3.fromRGB(255, 216, 40)
DragonUI.HP_LOW = Color3.fromRGB(255, 92, 40)
DragonUI.DAMAGE = Color3.fromRGB(230, 30, 42)
DragonUI.KI = Color3.fromRGB(80, 214, 255)
DragonUI.KI_SSJ = Color3.fromRGB(255, 214, 60)
DragonUI.SCOUTER = Color3.fromRGB(40, 255, 120)
DragonUI.SLANT = math.tan(math.rad(24)) -- how far the ends lean: 24 degrees off vertical

local function new(className: string, props, parent: Instance?)
	local inst = Instance.new(className)
	for k, v in props do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
DragonUI.new = new

----------------------------------------------------------------------------------------
-- Slab: a slanted parallelogram. Each slanted end is a big square turned to the slant
-- angle inside a box that clips it, so only a triangle of it shows; a plain body fills the
-- middle. (Roblox only stops clipping when the clipping box itself, or something it sits in,
-- is rotated: the turned squares inside are clipped fine.)
----------------------------------------------------------------------------------------
local Slab = {}
Slab.__index = Slab
DragonUI.Slab = Slab

-- x, y, w, h in pixels inside parent. props (all optional): Slant (pixels the top edge is
-- shifted right; default h * SLANT), ZIndex, Transparency
function Slab.new(parent: Instance, name: string, x: number, y: number, w: number, h: number, color: Color3, props)
	props = props or {}
	local self = setmetatable({}, Slab)
	local s = props.Slant or h * DragonUI.SLANT
	local z = props.ZIndex or 1
	local transparency = props.Transparency or 0
	self.S, self.H, self.W, self.Z = s, h, w, z
	self.Pieces, self.Bands = {}, {}
	-- an opaque slab's body runs a pixel into each end so no seam can show where they meet; a
	-- see-through one's can't (the overlap would show as a darker line), so it meets them exactly
	self.Overlap = transparency > 0 and 0 or 1
	self.Holder = new("Frame", {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1,
		ZIndex = z,
	}, parent)
	local function piece(p: Instance)
		local f = new("Frame", {
			BackgroundColor3 = color,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = z,
		}, p)
		table.insert(self.Pieces, f)
		return f
	end
	self.Body = piece(self.Holder)
	self.Body.Name = "Body"
	self.LBox = new("Frame", { Name = "LeftEnd", Size = UDim2.fromOffset(s, h), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = z }, self.Holder)
	self.RBox = new("Frame", { Name = "RightEnd", Size = UDim2.fromOffset(s, h), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = z }, self.Holder)
	local lt, rt = piece(self.LBox), piece(self.RBox)
	-- the slanted edge runs from (0, h) to (s, 0) inside each end box
	local theta = math.atan2(-h, s)
	local big = 2 * (h + s)
	local normal = Vector2.new(-math.sin(theta), math.cos(theta)) -- points down-right, off the edge
	local mid = Vector2.new(s / 2, h / 2)
	local cl, cr = mid + normal * (big / 2), mid - normal * (big / 2)
	for _, t in { lt, rt } do
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Size = UDim2.fromOffset(big, big)
		t.Rotation = math.deg(theta)
	end
	lt.Position = UDim2.fromOffset(cl.X, cl.Y) -- shows below-right of the edge: the left end
	rt.Position = UDim2.fromOffset(cr.X, cr.Y) -- shows above-left of the edge: the right end
	self:SetWidth(w)
	return self
end

-- a slab drawn t pixels bigger all round the slab (x, y, w, h): put it behind that one for an
-- outline of even thickness, slanted ends included
function Slab.around(parent: Instance, name: string, x: number, y: number, w: number, h: number, t: number, color: Color3, props)
	local k = DragonUI.SLANT
	local grow = t * (k + math.sqrt(1 + k * k)) -- sideways growth that keeps the slanted sides t thick
	local p = table.clone(props or {})
	p.Slant = (h + 2 * t) * k
	return Slab.new(parent, name, x - grow, y - t, w + 2 * grow, h + 2 * t, color, p)
end

-- the slab's length (its left end stays put); 0 hides it
function Slab:SetWidth(width: number)
	local s = self.S
	self.Width = width
	self.Holder.Visible = width > 0.5
	self.Holder.Size = UDim2.fromOffset(math.max(width, 0), self.H)
	local o = self.Overlap
	self.Body.Position = UDim2.fromOffset(s - o, 0)
	self.Body.Size = UDim2.fromOffset(math.max(width - 2 * s + 2 * o, 0), self.H)
	self.RBox.Position = UDim2.fromOffset(math.max(width - s, 0), 0)
	for _, band in self.Bands do
		band.Slab:SetWidth(math.max(width - band.Trim, 0))
	end
end

-- fills a share (0..1) of the full slab, like a bar
function Slab:SetFill(share: number)
	share = math.clamp(share, 0, 1)
	self:SetWidth(share <= 0.001 and 0 or self.S + share * (self.W - self.S))
end

function Slab:SetColor(color: Color3)
	for _, p in self.Pieces do
		p.BackgroundColor3 = color
	end
end

function Slab:SetTransparency(t: number)
	for _, p in self.Pieces do
		p.BackgroundTransparency = t
	end
	if (t > 0 and 0 or 1) ~= self.Overlap then
		self.Overlap = t > 0 and 0 or 1
		self:SetWidth(self.Width)
	end
end

-- a strip of this slab from a to b pixels below its top (a shine, a shade, a scan line). It has
-- the same slanted ends, so it always fits exactly inside, and it follows SetWidth.
function Slab:Band(name: string, a: number, b: number, color: Color3, props)
	props = props or {}
	local k = self.S / self.H
	local trim = (self.H - b + a) * k
	local band = Slab.new(self.Holder, name, (self.H - b) * k, a, math.max(self.W - trim, 0), b - a, color, {
		Slant = (b - a) * k,
		ZIndex = props.ZIndex or (self.Z + 1),
		Transparency = props.Transparency,
	})
	table.insert(self.Bands, { Slab = band, Trim = trim })
	band:SetWidth(math.max(self.Width - trim, 0))
	return band
end

----------------------------------------------------------------------------------------
-- comic lettering: an ink-outlined label with a second print offset behind it
-- props: Position, Size, AnchorPoint, Rotation, ZIndex, Text, Font, TextXAlignment,
--        Color (front), BackColor (the offset print), Offset (pixels), Stroke (outline width)
----------------------------------------------------------------------------------------
function DragonUI.Lettering(parent: Instance, name: string, props)
	local holder = new("Frame", {
		Name = name,
		Position = props.Position,
		Size = props.Size,
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Rotation = props.Rotation or 0,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 1,
	}, parent)
	local function label(nm: string, offset: number, color: Color3, z: number)
		local l = new("TextLabel", {
			Name = nm,
			Position = UDim2.fromOffset(offset, offset),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = props.Font or Enum.Font.Bangers,
			Text = props.Text or "",
			TextColor3 = color,
			TextScaled = true,
			TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
			ZIndex = z,
		}, holder)
		local stroke = new("UIStroke", { Color = DragonUI.INK, Thickness = props.Stroke or 2 }, l)
		return l, stroke
	end
	local back, backStroke = label("Print", props.Offset or 3, props.BackColor or DragonUI.GI, props.ZIndex or 1)
	local front, frontStroke = label("Text", 0, props.Color or DragonUI.PAPER, (props.ZIndex or 1) + 1)
	local lettering = { Holder = holder, Front = front, Back = back }
	function lettering:SetText(text: string)
		front.Text = text
		back.Text = text
	end
	function lettering:SetColors(color: Color3?, backColor: Color3?)
		if color then
			front.TextColor3 = color
		end
		if backColor then
			back.TextColor3 = backColor
		end
	end
	function lettering:SetTransparency(t: number)
		front.TextTransparency, back.TextTransparency = t, t
		frontStroke.Transparency, backStroke.Transparency = t, t
	end
	return lettering
end

----------------------------------------------------------------------------------------
-- a Dragon Ball: a glossy orange orb with up to 5 red stars, an ink outline and a hard shadow
----------------------------------------------------------------------------------------
local STAR_SPOTS = { -- where the stars sit for each count (share of the ball)
	[1] = { { 0.5, 0.52 } },
	[2] = { { 0.38, 0.42 }, { 0.62, 0.62 } },
	[3] = { { 0.5, 0.36 }, { 0.36, 0.62 }, { 0.64, 0.62 } },
	[4] = { { 0.38, 0.38 }, { 0.62, 0.38 }, { 0.38, 0.64 }, { 0.62, 0.64 } },
	[5] = { { 0.5, 0.3 }, { 0.3, 0.47 }, { 0.7, 0.47 }, { 0.39, 0.71 }, { 0.61, 0.71 } },
}
DragonUI.STAR_SPOTS = STAR_SPOTS

function DragonUI.Orb(parent: Instance, name: string, x: number, y: number, size: number, z: number?)
	z = z or 1
	local holder = new("Frame", {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
	}, parent)
	local scale = new("UIScale", {}, holder)
	local shadow = new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(math.max(2, size * 0.07), math.max(3, size * 0.09)),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = DragonUI.INK,
		ZIndex = z,
	}, holder)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, shadow)
	local ball = new("Frame", {
		Name = "Ball",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = z + 1,
	}, holder)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ball)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 214, 110), Color3.fromRGB(232, 100, 18)),
		Rotation = 45,
	}, ball)
	new("UIStroke", { Color = DragonUI.INK, Thickness = math.max(2, size * 0.065), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ball)
	local gloss = new("Frame", {
		Name = "Gloss",
		Position = UDim2.fromScale(0.16, 0.1),
		Size = UDim2.fromScale(0.32, 0.18),
		Rotation = -28,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		ZIndex = z + 3,
	}, ball)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, gloss)
	local stars = {}
	for k = 1, 5 do
		local star = new("TextLabel", {
			Name = "Star" .. k,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.3, 0.3),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			Text = "★",
			TextScaled = true,
			TextColor3 = Color3.fromRGB(225, 26, 26),
			Visible = false,
			ZIndex = z + 2,
		}, ball)
		stars[k] = star
	end
	local orb = { Holder = holder, Ball = ball, Stars = stars, Scale = scale, Count = -1 }
	function orb:SetStars(n: number)
		n = math.clamp(math.floor(n), 0, 5)
		if n == self.Count then
			return
		end
		self.Count = n
		local spots = STAR_SPOTS[n] or {}
		for k, star in self.Stars do
			local spot = spots[k]
			star.Visible = spot ~= nil
			if spot then
				star.Position = UDim2.fromScale(spot[1], spot[2])
				local size = n == 1 and 0.46 or (n <= 3 and 0.36 or 0.3)
				star.Size = UDim2.fromScale(size, size)
			end
		end
	end
	orb:SetStars(0)
	return orb
end

----------------------------------------------------------------------------------------
-- halftone: a patch of dots shrinking toward the right, like a screentone fading out
-- props (all optional): ZIndex, Transparency, Lean (shift each row right by this much per pixel
-- it sits higher, so the patch leans like a slab: use DragonUI.SLANT)
----------------------------------------------------------------------------------------
function DragonUI.Halftone(parent: Instance, name: string, x: number, y: number, cols: number, rows: number, step: number, biggest: number, color: Color3, props)
	props = props or {}
	local z = props.ZIndex or 1
	local lean = props.Lean or 0
	local holder = new("Frame", {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(cols * step + rows * step * lean, rows * step),
		BackgroundTransparency = 1,
		ZIndex = z,
	}, parent)
	for row = 0, rows - 1 do
		local shift = (rows - 1 - row) * step * lean + (row % 2) * 0.5 * step
		for col = 0, cols - 1 do
			local d = biggest * (1 - col / cols)
			if d >= 1.5 then
				local dot = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset((col + 0.5) * step + shift, (row + 0.5) * step),
					Size = UDim2.fromOffset(d, d),
					BackgroundColor3 = color,
					BackgroundTransparency = props.Transparency or 0,
					BorderSizePixel = 0,
					ZIndex = z,
				}, holder)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
			end
		end
	end
	return holder
end

----------------------------------------------------------------------------------------
-- small helpers for hand-made motion
----------------------------------------------------------------------------------------
-- 0..1 -> 0..1, overshooting a little before settling (like Enum.EasingStyle.Back, Out)
function DragonUI.BackOut(t: number): number
	t = math.clamp(t, 0, 1)
	local c1 = 1.70158
	return 1 + (c1 + 1) * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

-- 0..1 -> 0..1, fast then gentle (Quad, Out)
function DragonUI.QuadOut(t: number): number
	t = math.clamp(t, 0, 1)
	return 1 - (1 - t) * (1 - t)
end

return DragonUI
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">CharacterSetup</string>
          <ProtectedString name="Source"><![CDATA[--[[
	CharacterSetup  (Script — lives in ServerScriptService)

	Turns every player into the "Base" rig (ReplicatedStorage > Base) with the base hair, the
	belt and fingers on:
	  1. When the server starts it copies Base, puts the rigged base hair, the (hidden) Super
	     Saiyan hair, the belt and the fingers on it, and makes that copy the StarterCharacter —
	     Roblox's built-in way of giving every player a custom character.
	  2. Players' own avatars are not loaded onto it, and anything that still sneaks on
	     (clothing, accessories, body colours from their avatar) is stripped off when they spawn.

	The rigged pieces are found in ServerStorage > CharacterParts (import the five .fbx files
	there; without the two finger files you get plain hands). Settings: ReplicatedStorage >
	HairConfig and PowerConfig.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))
local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local PIECES = { "BaseHair", "SSJHair", "Belt", "LeftFingers", "RightFingers" }
local OWNED = "DWOwned" -- marks things that belong to the Base rig (never stripped)

local function log(message: string)
	print("[CharacterSetup] " .. message)
end

local function complain(message: string)
	warn("[CharacterSetup] " .. message)
end

----------------------------------------------------------------------------------------
-- finding and copying the imported rigged pieces
----------------------------------------------------------------------------------------
local function partOfBone(bone: Instance): BasePart?
	local node = bone.Parent
	while node and not node:IsA("BasePart") do
		node = node.Parent
	end
	return node :: BasePart?
end

local function findSource(signature: string): (Bone?, string?)
	for _, container in { ServerStorage, ReplicatedStorage, Workspace } do
		local folder = container:FindFirstChild(HairConfig.ModelFolder)
		if folder then
			local bone = folder:FindFirstChild(signature, true)
			if bone and bone:IsA("Bone") then
				return bone, folder:GetFullName()
			end
		end
	end
	-- forgiving: imported but left loose in Workspace / ServerStorage
	for _, container in { Workspace, ServerStorage } do
		for _, d in container:GetDescendants() do
			if d.Name == signature and d:IsA("Bone") then
				return d, container.Name
			end
		end
	end
	return nil
end

-- A copy of the mesh with all its bones inside it (moves bones in if the importer put them
-- in a separate part — same place in the world, so the skinning is unchanged).
local function copyMesh(signatureBone: Bone): BasePart?
	local original = partOfBone(signatureBone)
	if not original then
		return nil
	end
	local holder: Instance = signatureBone:FindFirstAncestorWhichIsA("Model") or original
	if holder:IsA("Workspace") then
		holder = original
	end
	local copy = holder:Clone() or original:Clone()
	if not copy then
		return nil
	end
	local bone = copy:FindFirstChild(signatureBone.Name, true)
	local bonePart = bone and partOfBone(bone)
	if not bonePart then
		copy:Destroy()
		return nil
	end
	local mesh = bonePart
	if not bonePart:IsA("MeshPart") then
		local found = copy:IsA("MeshPart") and copy or copy:FindFirstChildWhichIsA("MeshPart", true)
		if found then
			mesh = found
			for _, child in bonePart:GetChildren() do
				if child:IsA("Bone") then
					child.CFrame = mesh.CFrame:ToObjectSpace(bonePart.CFrame * child.CFrame)
					child.Parent = mesh
				end
			end
		end
	end
	if mesh ~= copy then
		mesh.Parent = nil
		copy:Destroy()
	end
	for _, d in mesh:GetDescendants() do
		if d.Parent and not (d:IsA("Bone") or d:IsA("SurfaceAppearance")) then
			d:Destroy()
		end
	end
	return mesh
end

local function bonePairs(mesh: BasePart, layout)
	local design, actual = {}, {}
	for name, modeled in layout.Bones do
		local bone = mesh:FindFirstChild(name, true)
		if bone and bone:IsA("Bone") then
			local cf = HairPhysics.PartSpaceCFrame(bone, mesh)
			if cf then
				table.insert(design, modeled)
				table.insert(actual, cf.Position)
			end
		end
	end
	return design, actual
end

----------------------------------------------------------------------------------------
-- sizing the belt to the waist
----------------------------------------------------------------------------------------
-- How big the belt has to be so the body never pokes through it, and where the middle of the
-- waist is. The body parts listed in FitAround are measured where they cross the band, all the
-- way round, and compared with the inside of the band (layout.Ring, measured from the model).
-- Returns the size to use (1 = as modeled) and how far to move the belt to centre it.
local function waistFit(rig: Model, attachPart: BasePart, ring, cfg): (number?, Vector3)
	local radii, step = ring.Radii, ring.Step
	local count = #radii
	local function inside(angle: number): number
		local a = (math.deg(angle) % 360) / step
		local i = math.floor(a)
		local f = a - i
		return radii[i % count + 1] * (1 - f) + radii[(i + 1) % count + 1] * f
	end
	local base = attachPart.CFrame * (cfg.Offset or CFrame.identity)
	-- the band grows with the belt, so look a bit above and below it
	local low, high = ring.Bottom * 1.4, ring.Top * 1.4
	local points = {}
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, name in cfg.FitAround do
		local part = rig:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local cf = base:ToObjectSpace(part.CFrame)
			local h = part.Size / 2
			for i = 0, 16 do
				local u = i / 8 - 1
				for j = 0, 16 do
					local v = j / 8 - 1
					-- the four side faces of the part
					for _, q in { Vector3.new(h.X, v * h.Y, u * h.Z), Vector3.new(-h.X, v * h.Y, u * h.Z), Vector3.new(u * h.X, v * h.Y, h.Z), Vector3.new(u * h.X, v * h.Y, -h.Z) } do
						local p = cf * q
						if p.Y >= low and p.Y <= high then
							table.insert(points, p)
							minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
							minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
						end
					end
				end
			end
		end
	end
	if #points == 0 then
		return nil, Vector3.zero
	end
	local middle = Vector3.new(math.clamp((minX + maxX) / 2, -0.3, 0.3), 0, math.clamp((minZ + maxZ) / 2, -0.3, 0.3))
	local need = 0
	local gap = cfg.FitGap or 0.04
	for _, p in points do
		local dx, dz = p.X - middle.X, p.Z - middle.Z
		need = math.max(need, (math.sqrt(dx * dx + dz * dz) + gap) / inside(math.atan2(dz, dx)))
	end
	return math.clamp(need, 0.6, 2), middle
end

----------------------------------------------------------------------------------------
-- putting one piece on the rig
----------------------------------------------------------------------------------------
local function attachPiece(rig: Model, name: string): boolean
	local cfg = HairConfig.Hairs[name]
	local layout = HairConfig.Layouts[name]
	local attachPart = rig:FindFirstChild(layout.Attach)
	if not (attachPart and attachPart:IsA("BasePart")) then
		complain(("the Base rig has no %s part to put the %s on"):format(layout.Attach, name))
		return false
	end
	local bone, where = findSource(cfg.SignatureBone)
	if not bone then
		complain(
			("couldn't find the rigged %s (looking for its bone '%s'). Import the latest %s_Rigged.fbx (File > Import 3D) and put it in ServerStorage > %s; delete any older copy."):format(
				name,
				cfg.SignatureBone,
				name,
				HairConfig.ModelFolder
			)
		)
		return false
	end
	local mesh = copyMesh(bone)
	if not mesh then
		complain(("found the %s bones in %s but no mesh next to them"):format(name, where or "?"))
		return false
	end
	mesh.Name = name
	mesh.Anchored = false
	mesh.CanCollide = false
	mesh.CanTouch = false
	mesh.CanQuery = false
	mesh.Massless = true
	if mesh:IsA("MeshPart") and cfg.TextureId and cfg.TextureId ~= "" then
		mesh.TextureID = cfg.TextureId
	end
	if cfg.Color then
		mesh.Color = cfg.Color
		mesh:SetAttribute("KeepColour", true) -- (fingers otherwise follow the hand's colour)
	elseif cfg.Kind == "Fingers" then
		-- the colour of the hand they're on (the rig's BodyColors wins, as it recolours the arms)
		local colours = rig:FindFirstChildOfClass("BodyColors")
		if colours then
			mesh.Color = layout.Attach == "LeftHand" and colours.LeftArmColor3 or colours.RightArmColor3
		else
			mesh.Color = attachPart.Color
		end
		mesh.Material = attachPart.Material
	end
	if cfg.Material then
		mesh.Material = cfg.Material
	end

	-- where it goes: compare the modeled bone positions with the imported ones
	local design, actual = bonePairs(mesh, layout)
	if #design < 3 then
		complain(("the %s is missing its bones (found %d) — re-import it and keep the rig"):format(name, #design))
		mesh:Destroy()
		return false
	end
	local fit = HairPhysics.FitRig(design, actual)
	local wantScale = cfg.Scale or 1
	if cfg.ScaleToHead and attachPart:IsA("MeshPart") then
		local ratio = (attachPart.Size.X + attachPart.Size.Z) * 0.5 / (HairConfig.ReferenceHeadWidth or 1.2)
		if ratio > 0.5 and ratio < 3 then
			wantScale *= ratio
		end
	end
	local shift = Vector3.zero
	if cfg.FitAround and layout.Ring then
		local size, middle = waistFit(rig, attachPart, layout.Ring, cfg)
		if size then
			wantScale = size * (cfg.Scale or 1)
			shift = middle
			log(("sized the %s to wrap the waist (x%.3f)"):format(name, wantScale))
		end
	end
	if math.abs(fit.Scale / wantScale - 1) > 0.02 then
		local temp = Instance.new("Model")
		mesh.Parent = temp
		local ok, err = pcall(function()
			temp:ScaleTo(temp:GetScale() * wantScale / fit.Scale)
		end)
		mesh.Parent = nil
		temp:Destroy()
		if ok then
			design, actual = bonePairs(mesh, layout)
			fit = HairPhysics.FitRig(design, actual)
		else
			complain("couldn't resize the " .. name .. ": " .. tostring(err))
		end
	end
	if fit.Error > 0.05 * math.max(fit.Scale, 0.01) then
		complain(("the %s's bones don't match the expected layout (off by %.2f studs)"):format(name, fit.Error))
	end
	local centre = (layout.HeadCenter or Vector3.zero) * fit.Scale
	local attachToMesh = cfg.Offset * CFrame.new(shift - centre) * HairPhysics.HeadToPart(fit)

	local holder = Instance.new("Model")
	holder.Name = "DW_" .. name
	holder:SetAttribute(OWNED, true)
	mesh.CFrame = attachPart.CFrame * attachToMesh
	mesh.Parent = holder
	local weld = Instance.new("Weld")
	weld.Name = "DWWeld"
	weld.Part0 = attachPart
	weld.Part1 = mesh
	weld.C0 = attachToMesh
	weld.Parent = mesh
	mesh:SetAttribute("FitScale", math.floor(fit.Scale * 1000 + 0.5) / 1000) -- how big it ended up (1 = as modeled)
	mesh:SetAttribute("VisibleIn", cfg.VisibleIn or "Both")
	mesh.Transparency = (cfg.VisibleIn == "SSJ") and 1 or 0
	if cfg.Kind == "Fingers" then
		mesh:SetAttribute("FingerHand", layout.Attach) -- HandFX poses these; no physics
	else
		mesh:SetAttribute("HairPreset", name)
		CollectionService:AddTag(mesh, HairPhysics.TAG)
	end
	holder.Parent = rig
	log(("put the %s on the %s (%d bones lined up)"):format(name, layout.Attach, #design))
	return true
end

----------------------------------------------------------------------------------------
-- build the StarterCharacter
----------------------------------------------------------------------------------------
local base = ReplicatedStorage:WaitForChild(PowerConfig.BaseRigName, 20)
if not (base and base:IsA("Model") and base:FindFirstChildOfClass("Humanoid")) then
	complain(("there's no R15 rig called '%s' (with a Humanoid) in ReplicatedStorage"):format(PowerConfig.BaseRigName))
	return
end

local template = base:Clone()
for _, d in template:GetDescendants() do
	-- the rig's own clothes / accessories are kept; only the players' avatar items get stripped
	if d:IsA("Accessory") or d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh") then
		d:SetAttribute(OWNED, true)
	end
	if d:IsA("BasePart") then
		d.Anchored = false
	end
end
for _, name in PIECES do
	local ok, err = pcall(attachPiece, template, name)
	if not ok then
		complain(("putting on the %s failed: %s"):format(name, tostring(err)))
	end
end
-- Roblox ties a skinned mesh to the first bone with a matching name anywhere in the character,
-- so two pieces with a bone of the same name would steal each other's bones (the hair then
-- never moves). Every piece's bones must have their own names.
do
	local owner = {}
	for _, d in template:GetDescendants() do
		if d:IsA("Bone") then
			local piece = d:FindFirstAncestorWhichIsA("MeshPart")
			local pieceName = piece and piece.Name or "?"
			if owner[d.Name] and owner[d.Name] ~= pieceName then
				complain(("the %s and the %s both have a bone called '%s', so one of them won't move. Re-import the latest %s_Rigged.fbx."):format(
					owner[d.Name], pieceName, d.Name, pieceName))
			end
			owner[d.Name] = owner[d.Name] or pieceName
		end
	end
end
template:SetAttribute("Form", "Base")
template:SetAttribute("PowerState", "Idle")
template:SetAttribute("Charge", 0)
template:SetAttribute("AuraWind", 0)
template:SetAttribute("Breeze", 0)
template:SetAttribute("Ki", PowerConfig.KiStart)
template:SetAttribute("Kaioken", 0)
template:SetAttribute("KaiokenMult", 1)
template:SetAttribute("Exhausted", false)
template.Name = "StarterCharacter"

local old = StarterPlayer:FindFirstChild("StarterCharacter")
if old then
	old:Destroy()
end
template.Parent = StarterPlayer

-- players' own avatars shouldn't be loaded onto the rig
local okAppearance = pcall(function()
	StarterPlayer.LoadCharacterAppearance = false
end)
if not okAppearance then
	complain("couldn't switch off StarterPlayer.LoadCharacterAppearance from a script — untick it in StarterPlayer's properties")
end
log("players now spawn as " .. PowerConfig.BaseRigName)

----------------------------------------------------------------------------------------
-- strip anything from the player's avatar that still gets added
----------------------------------------------------------------------------------------
local function isAvatarItem(inst: Instance): boolean
	return (
		inst:IsA("Accessory")
		or inst:IsA("Clothing")
		or inst:IsA("ShirtGraphic")
		or inst:IsA("BodyColors")
		or inst:IsA("CharacterMesh")
	) and not inst:GetAttribute(OWNED)
end

local function onCharacter(character: Model)
	for _, d in character:GetDescendants() do
		if isAvatarItem(d) then
			d:Destroy()
		end
	end
	-- avatar items can arrive a moment after spawning
	local connection = character.DescendantAdded:Connect(function(d)
		if isAvatarItem(d) then
			task.defer(function()
				if d.Parent then
					d:Destroy()
				end
			end)
		end
	end)
	task.delay(15, function()
		connection:Disconnect()
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		-- spawned before the morph was ready (can happen when testing in Studio): respawn
		if not player.Character:FindFirstChild("DW_Belt") and not player.Character:FindFirstChild("DW_BaseHair") then
			player:LoadCharacter()
		else
			onCharacter(player.Character)
		end
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">PowerUpServer</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerUpServer  (Script — lives in ServerScriptService)

	The referee for powering up. Players' computers tell it "I started charging", "my bar is at
	X", "I'm full — transform", "cancel", "power down" and "Kaioken"; it checks those make sense
	and sets attributes on the character that every player's screen reads to draw the aura,
	pose, hair, fingers and HUD:
	  Form        "Base" or "SSJ"
	  PowerState  "Idle", "Charging" or "Bursting" (the transformation, cutscene included)
	  Charge      0..1, how full the power bar is
	  AuraWind    0..1, how hard the aura blows the hair and belt upward
	  Breeze      0..1, the Super Saiyan glow: the SSJ hair's breeze and the golden aura. 1 when
	              you transform, fading to 0 when you calm down (PowerConfig.SSJCalmAfter)
	  Ki          0..KiMax, shown on the HUD: refills slowly, and charging fills it up
	  Kaioken     0 = off, 1..5 = the level (x2, x3, x4, x10, x20; PowerConfig.KaiokenLevels)
	  KaiokenMult the multiplier of that level (1 when off)
	  Exhausted   true for a few seconds after the Kaioken was pushed until your body gave out
	It also swaps the visible hair (base <-> Super Saiyan), stops you walking while charging
	and transforming, speeds you up in Kaioken, drains your health while it burns, and slows
	you while you're exhausted.
	Settings: ReplicatedStorage > PowerConfig.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local remote = ReplicatedStorage:FindFirstChild("PowerUp")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "PowerUp"
	remote.Parent = ReplicatedStorage
end

local MAX_TAPS_PER_SECOND = 16 -- nobody taps faster than this, so the bar can't rise faster either
local STALE_SECONDS = 4 -- a charging player who goes quiet this long is cancelled
local KI_STEP = 0.25 -- seconds between ki refills

local info = {} -- [character] = { Started, LastUpdate, WalkSpeed, JumpPower, JumpHeight, Token }

local function smoothstep(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

local function state(character: Model)
	info[character] = info[character] or {}
	return info[character]
end

-- shows the pieces that belong to a form and hides the rest
local function applyForm(character: Model, form: string)
	character:SetAttribute("Form", form)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			local visibleIn = d:GetAttribute("VisibleIn")
			if visibleIn and visibleIn ~= "Both" then
				d.Transparency = (visibleIn == form) and 0 or 1
			end
		end
	end
end

local function lockMovement(character: Model, lock: boolean)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local st = info[character]
	if not humanoid or not st or not PowerConfig.LockMovement then
		return
	end
	if lock then
		st.WalkSpeed = st.WalkSpeed or humanoid.WalkSpeed
		st.JumpPower = st.JumpPower or humanoid.JumpPower
		st.JumpHeight = st.JumpHeight or humanoid.JumpHeight
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	else
		if st.WalkSpeed then
			humanoid.WalkSpeed = st.WalkSpeed
			humanoid.JumpPower = st.JumpPower
			humanoid.JumpHeight = st.JumpHeight
		end
		st.WalkSpeed, st.JumpPower, st.JumpHeight = nil, nil, nil
	end
end

-- the hair lift that stays on when you're not charging: while the Super Saiyan glow is up, or
-- the Kaioken burns
local function idleWind(character: Model): number
	local kaioken = character:GetAttribute("Kaioken") or 0
	if kaioken > 0 then
		return 0.3 + 0.1 * kaioken
	end
	if character:GetAttribute("Form") ~= "SSJ" then
		return 0
	end
	return PowerConfig.SSJCalmWind * (character:GetAttribute("Breeze") or 0)
end

----------------------------------------------------------------------------------------
-- Kaioken
----------------------------------------------------------------------------------------
-- walk speed follows the Kaioken level and exhaustion (your normal speed is remembered)
local function applySpeed(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local st = state(character)
	local level = character:GetAttribute("Kaioken") or 0
	local tired = character:GetAttribute("Exhausted")
	if level > 0 or tired then
		st.NormalSpeed = st.NormalSpeed or humanoid.WalkSpeed
		local mult = tired and PowerConfig.ExhaustedSpeed or PowerConfig.KaiokenSpeed[level] or 1
		humanoid.WalkSpeed = st.NormalSpeed * mult
	elseif st.NormalSpeed then
		humanoid.WalkSpeed = st.NormalSpeed
		st.NormalSpeed = nil
	end
end

local function setKaioken(character: Model, level: number)
	character:SetAttribute("Kaioken", level)
	character:SetAttribute("KaiokenMult", PowerConfig.KaiokenLevels[level] or 1)
	character:SetAttribute("AuraWind", idleWind(character))
	applySpeed(character)
end

-- pushed too far: the Kaioken stops and you're exhausted for a few seconds
local function exhaust(character: Model)
	local st = state(character)
	st.Token = (st.Token or 0) + 1
	local token = st.Token
	setKaioken(character, 0)
	character:SetAttribute("Exhausted", true)
	applySpeed(character)
	task.delay(PowerConfig.KaiokenExhaustTime, function()
		if character.Parent and st.Token == token then
			character:SetAttribute("Exhausted", false)
			applySpeed(character)
		end
	end)
end

local function stopCharging(character: Model)
	character:SetAttribute("PowerState", "Idle")
	character:SetAttribute("Charge", 0)
	character:SetAttribute("AuraWind", idleWind(character))
	lockMovement(character, false)
end

-- A while after transforming, the hair stops flowing and the golden aura fades (both read the
-- Breeze attribute). token makes sure an old transformation never calms a newer one.
local function calmDown(character: Model, token: number)
	local st = state(character)
	local steps = math.max(1, math.floor(PowerConfig.SSJCalmTime / 0.1))
	for i = 1, steps do
		if not character.Parent or st.Token ~= token or character:GetAttribute("Form") ~= "SSJ" then
			return
		end
		if character:GetAttribute("PowerState") == "Idle" then
			local f = 1 - i / steps
			character:SetAttribute("Breeze", math.floor(f * 100 + 0.5) / 100)
			character:SetAttribute("AuraWind", PowerConfig.SSJCalmWind * f)
		end
		task.wait(0.1)
	end
end

local function burst(character: Model)
	local st = state(character)
	st.Token = (st.Token or 0) + 1
	local token = st.Token
	character:SetAttribute("PowerState", "Bursting")
	character:SetAttribute("Charge", 1)
	character:SetAttribute("AuraWind", 1)
	character:SetAttribute("Breeze", 1)
	character:SetAttribute("Ki", PowerConfig.KiMax)
	applyForm(character, "SSJ")
	task.delay(PowerConfig.BurstTime, function()
		if character.Parent and character:GetAttribute("PowerState") == "Bursting" then
			stopCharging(character)
		end
	end)
	task.delay(PowerConfig.BurstTime + PowerConfig.SSJCalmAfter, function()
		if character.Parent and st.Token == token then
			calmDown(character, token)
		end
	end)
end

remote.OnServerEvent:Connect(function(player: Player, action, value)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (character and humanoid and humanoid.Health > 0) then
		return
	end
	local powerState = character:GetAttribute("PowerState") or "Idle"
	local form = character:GetAttribute("Form") or "Base"
	local now = os.clock()
	local st = state(character)

	local kaioken = character:GetAttribute("Kaioken") or 0
	if action == "Start" then
		if powerState == "Idle" and form == "Base" and kaioken == 0 and not character:GetAttribute("Exhausted") then
			st.Started, st.LastUpdate = now, now
			character:SetAttribute("PowerState", "Charging")
			character:SetAttribute("Charge", 0)
			lockMovement(character, true)
		end
	elseif action == "Charge" then
		if powerState == "Charging" and typeof(value) == "number" and value == value then
			local previous = character:GetAttribute("Charge") or 0
			local allowedRise = PowerConfig.ChargePerTap * MAX_TAPS_PER_SECOND * (now - (st.LastUpdate or now)) + 0.02
			local charge = math.clamp(math.min(value, previous + allowedRise), 0, 1)
			st.LastUpdate = now
			character:SetAttribute("Charge", math.floor(charge * 100 + 0.5) / 100)
			character:SetAttribute("AuraWind", smoothstep(PowerConfig.HairStart, 1, charge))
			-- charging fills your ki
			local ki = character:GetAttribute("Ki") or 0
			character:SetAttribute("Ki", math.max(ki, math.floor(charge * PowerConfig.KiMax)))
		end
	elseif action == "Transform" then
		local charge = character:GetAttribute("Charge") or 0
		if powerState == "Charging" and charge >= 0.95 and now - (st.Started or now) >= PowerConfig.MinChargeTime - 0.2 then
			burst(character)
		end
	elseif action == "Cancel" then
		if powerState == "Charging" then
			stopCharging(character)
		end
	elseif action == "PowerDown" then
		if powerState == "Idle" and kaioken > 0 then
			setKaioken(character, 0) -- let the Kaioken go
		elseif powerState == "Idle" and form == "SSJ" then
			st.Token = (st.Token or 0) + 1 -- cancels a pending calm-down
			applyForm(character, "Base")
			character:SetAttribute("AuraWind", 0)
			character:SetAttribute("Breeze", 0)
		end
	elseif action == "Kaioken" then
		-- light it, or push it one level higher: base form, standing (not charging), not
		-- exhausted, not too soon after the last level, and with a ki pip to burn
		local ki = character:GetAttribute("Ki") or 0
		if
			powerState == "Idle"
			and form == "Base"
			and not character:GetAttribute("Exhausted")
			and kaioken < #PowerConfig.KaiokenLevels
			and ki >= PowerConfig.KaiokenKiCost
			and now - (st.KaiokenAt or -math.huge) >= PowerConfig.KaiokenCooldown
		then
			st.KaiokenAt = now
			character:SetAttribute("Ki", ki - PowerConfig.KaiokenKiCost)
			setKaioken(character, kaioken + 1)
		end
	end
end)

-- a charging player who stopped talking (closed the game, lagged out) is cancelled; the
-- Kaioken eats health; and ki slowly refills
local kiClock = 0
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for character, st in info do
		if not character.Parent then
			info[character] = nil
		elseif character:GetAttribute("PowerState") == "Charging" and now - (st.LastUpdate or now) > STALE_SECONDS then
			stopCharging(character)
		else
			local level = character:GetAttribute("Kaioken") or 0
			local humanoid = level > 0 and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				local strain = PowerConfig.KaiokenStrain[level] or 0
				local floor = PowerConfig.KaiokenFloor
				local health = math.max(humanoid.Health - strain * dt, math.min(floor, humanoid.Health))
				humanoid.Health = health
				if health <= floor + 1e-3 then
					exhaust(character) -- your body gives out
				end
			end
		end
	end
	kiClock += dt
	if kiClock >= KI_STEP then
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local ki = character and character:GetAttribute("Ki")
			if ki and ki < PowerConfig.KiMax and character:GetAttribute("PowerState") ~= "Charging"
				and (character:GetAttribute("Kaioken") or 0) == 0
			then
				character:SetAttribute("Ki", math.min(PowerConfig.KiMax, ki + PowerConfig.KiRegen * kiClock))
			end
		end
		kiClock = 0
	end
end)

Players.PlayerRemoving:Connect(function(player)
	if player.Character then
		info[player.Character] = nil
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="11">
        <Properties>
          <string name="Name">HairPhysicsClient</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairPhysicsClient  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Starts the hair simulation on this player's screen. Every hair the server tagged
	"HairPhysics" gets simulated here. Nothing to change in this script — the settings
	are in ReplicatedStorage > HairConfig.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))
HairPhysics.StartClient()
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">PowerUpClient</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerUpClient  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Your controls, camera and screen for powering up:
	  R      start powering up (the camera swings round to face you, you drop into a stance)
	         R again while charging cancels; R as a Super Saiyan (or in Kaioken) powers down
	  Space  spam it to fill the power bar (phones: the big TAP button)
	  K      Kaioken: lights it, and each press after pushes it a level higher (phones: the
	         KAIOKEN button). The server decides if you can; a red "KAIOKEN x3!" pops up when
	         it does
	When the bar is full you burst into Super Saiyan: the transformation cutscene plays
	(SSJCutscene: your eyes, your hair, the explosion, the manga panels), then you get control
	back. The prompt, bar and TAP button are drawn with ReplicatedStorage > DragonUI. The aura,
	pose and hair are drawn by PowerFX and HairPhysics for everyone, using the attributes
	PowerUpServer sets.
	Settings: ReplicatedStorage > PowerConfig.
]]

local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))
local remote = ReplicatedStorage:WaitForChild("PowerUp")
local player = Players.LocalPlayer

-- the transformation cutscene (if it's missing, transforming still works without it)
local okCutscene, Cutscene = pcall(function()
	return require(script.Parent:WaitForChild("SSJCutscene", 5))
end)
if not okCutscene then
	Cutscene = nil
end

local SEND_EVERY = 0.1 -- seconds between bar updates sent to the server

----------------------------------------------------------------------------------------
-- screen (the look comes from ReplicatedStorage > DragonUI)
----------------------------------------------------------------------------------------
local DragonUI = require(ReplicatedStorage:WaitForChild("DragonUI"))
local new, Slab = DragonUI.new, DragonUI.Slab
local INK, PAPER = DragonUI.INK, DragonUI.PAPER
local touch = UserInputService.TouchEnabled

local gui = new("ScreenGui", {
	Name = "PowerUpUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 6, -- (above the HUD, so the shout and flashes cover it)
}, player:WaitForChild("PlayerGui"))

-- comic text: Bangers with an ink outline (ink-coloured text goes without one)
local function text(parent: Instance, props): TextLabel
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Bangers,
		TextColor3 = PAPER,
		TextScaled = true,
	})
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	if l.TextColor3 ~= INK then
		new("UIStroke", { Color = INK, Thickness = 2 }, l)
	end
	return l
end

-- the hints along the bottom: key caps and what they do
local hint = new("Frame", {
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.fromOffset(200, 30),
	BackgroundTransparency = 1,
}, gui)
local function hintEntry(index: number)
	local holder = new("Frame", { Name = "Hint" .. index, Size = UDim2.fromOffset(200, 30), BackgroundTransparency = 1 }, hint)
	local key = Slab.new(holder, "Key", 0, 0, 120, 30, PAPER, { ZIndex = 2 })
	local keyText = text(key.Holder, {
		Name = "Text",
		Position = UDim2.fromOffset(13, 4),
		Size = UDim2.new(1, -26, 1, -7),
		TextColor3 = INK,
		ZIndex = 3,
	})
	local action = Slab.new(holder, "Action", 44, 3, 240, 24, INK, { Transparency = 0.15, ZIndex = 1 })
	local actionText = text(action.Holder, {
		Name = "Text",
		Position = UDim2.fromOffset(15, 2),
		Size = UDim2.new(1, -30, 1, -4),
		ZIndex = 2,
	})
	return { Holder = holder, Key = key, KeyText = keyText, Action = action, ActionText = actionText }
end
local hintEntries = { hintEntry(1), hintEntry(2) }

-- list = { { key, what it does }, ... } (up to two), or nil for none
local function setHint(list)
	list = list or {}
	hint.Visible = #list > 0
	local x = 0
	for i, entry in hintEntries do
		local item = list[i]
		entry.Holder.Visible = item ~= nil
		if item then
			local keyWidth = 26 + 13 * #item[1]
			local actionWidth = 30 + 11 * #item[2]
			entry.KeyText.Text = item[1]
			entry.ActionText.Text = item[2]
			entry.Key:SetWidth(keyWidth)
			entry.Action:SetWidth(actionWidth)
			entry.Action.Holder.Position = UDim2.fromOffset(keyWidth - 6, 3)
			entry.Holder.Position = UDim2.fromOffset(x, 0)
			entry.Holder.Size = UDim2.fromOffset(keyWidth - 6 + actionWidth, 30)
			x += keyWidth - 6 + actionWidth + 16
		end
	end
	hint.Size = UDim2.fromOffset(math.max(x - 16, 1), 30)
end
setHint(nil) -- (until your character arrives)

-- the charge panel: SPAM SPACE!, how far along you are, and the bar
local PANEL_W = touch and 300 or 420
local panel = new("Frame", {
	Name = "Charge",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -64),
	Size = UDim2.fromOffset(PANEL_W, 124),
	BackgroundTransparency = 1,
	Visible = false,
}, gui)
local panelScale = new("UIScale", {}, panel) -- shrinks the panel on small screens
local prompt = DragonUI.Lettering(panel, "Prompt", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(1, -30, 0, 54),
	Text = "SPAM  SPACE!",
	TextXAlignment = Enum.TextXAlignment.Center,
	Stroke = 3,
	Offset = 4,
	ZIndex = 2,
})
local promptScale = new("UIScale", {}, prompt.Holder)
local stage = text(panel, {
	Name = "Stage",
	Position = UDim2.new(0, 0, 0, 58),
	Size = UDim2.new(1, 0, 0, 22),
	Text = "",
	ZIndex = 2,
})
local BAR_X, BAR_Y, BAR_H = 16, 90, 22
local BAR_W = PANEL_W - BAR_X - 68
Slab.around(panel, "BarEdge", BAR_X, BAR_Y, BAR_W, BAR_H, 3, PAPER, { ZIndex = 1 })
local barBack = Slab.new(panel, "Bar", BAR_X, BAR_Y, BAR_W, BAR_H, INK, { ZIndex = 2 })
local barFill = Slab.new(barBack.Holder, "Fill", 0, 0, BAR_W, BAR_H, DragonUI.KI, { ZIndex = 3 })
barFill:Band("Shade", 14, BAR_H, INK, { Transparency = 0.7, ZIndex = 4 })
barFill:Band("Shine", 3, 6, PAPER, { Transparency = 0.3, ZIndex = 4 })
barFill:SetFill(0)
local percent = text(panel, {
	Name = "Percent",
	Position = UDim2.fromOffset(BAR_X + BAR_W + 10, BAR_Y - 5),
	Size = UDim2.fromOffset(56, BAR_H + 10),
	Text = "0%",
	TextXAlignment = Enum.TextXAlignment.Left,
	ZIndex = 2,
})

-- phones: a big Dragon Ball to tap
local TAP_SIZE = touch and 124 or 150
local tapButton = new("TextButton", {
	Name = "Tap",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -30, 1, -40),
	Size = UDim2.fromOffset(TAP_SIZE, TAP_SIZE),
	BackgroundTransparency = 1,
	AutoButtonColor = false,
	Text = "",
	Visible = false,
}, gui)
local tapBall = DragonUI.Orb(tapButton, "Ball", 0, 0, TAP_SIZE, 1)
DragonUI.Lettering(tapButton, "Label", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.52),
	Size = UDim2.fromScale(0.8, 0.42),
	Rotation = -8,
	Text = "TAP!",
	BackColor = DragonUI.DAMAGE,
	TextXAlignment = Enum.TextXAlignment.Center,
	Stroke = 3,
	Offset = 4,
	ZIndex = 5,
})

if touch then
	-- phones: the charge panel goes top right (the radar slides away while you power up) and
	-- the TAP button bottom middle, between the thumbstick and the jump button, so it never
	-- covers JUMP
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -60, 0, 62)
	tapButton.AnchorPoint = Vector2.new(0.5, 1)
	tapButton.Position = UDim2.new(0.5, 0, 1, -22)
end

local flash = new("Frame", {
	Name = "Flash",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 1,
	ZIndex = 10,
}, gui)
-- the title when there's no cutscene
local bigText = DragonUI.Lettering(gui, "Title", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(700, 100),
	Text = "SUPER SAIYAN!",
	Color = DragonUI.GOLD,
	BackColor = DragonUI.DAMAGE,
	TextXAlignment = Enum.TextXAlignment.Center,
	Stroke = 4,
	Offset = 5,
	ZIndex = 11,
})
bigText.Holder.Visible = false
local bigScale = new("UIScale", {}, bigText.Holder)

-- "KAIOKEN x3!": pops up each time the Kaioken is lit or pushed higher
local kaiokenText = DragonUI.Lettering(gui, "Kaioken", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(touch and 0.56 or 0.5, touch and 0.3 or 0.24),
	Size = UDim2.fromOffset(touch and 380 or 560, touch and 58 or 84),
	Rotation = -4,
	Text = "KAIOKEN!",
	Color = Color3.fromRGB(255, 70, 52),
	BackColor = INK,
	TextXAlignment = Enum.TextXAlignment.Center,
	Stroke = 4,
	Offset = 5,
	ZIndex = 11,
})
kaiokenText.Holder.Visible = false
local kaiokenScale = new("UIScale", {}, kaiokenText.Holder)
-- a short line when a key can't do anything right now ("NOT ENOUGH KI!")
local toast = DragonUI.Lettering(gui, "Toast", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -56),
	Size = UDim2.fromOffset(300, 30),
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Center,
	Offset = 2,
	ZIndex = 11,
})
toast.Holder.Visible = false
local toastUntil = 0

-- a colour grade on this player's screen only: punchier as you charge, a warm flash on release
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "PowerUpGrade"
grade.Parent = Lighting

----------------------------------------------------------------------------------------
-- state
----------------------------------------------------------------------------------------
local character: Model? = nil
local charging = false
local bursting = false
local charge = 0
local full = false -- the bar filled up: it stays full until you transform
local startedAt = 0
local lastSend = 0
local transformSentAt = -math.huge
local savedCamera = nil
local camShake = 0
local fovKick = 0

local function attr(name: string)
	return character and character:GetAttribute(name)
end

local function refreshHint()
	local powerKey = touch and "POWER" or PowerConfig.PowerKey.Name
	local kaiokenKey = touch and "KAIOKEN" or PowerConfig.KaiokenKey.Name
	local kaioken = attr("Kaioken") or 0
	if charging or bursting or attr("Exhausted") then
		setHint(nil)
	elseif attr("Form") == "SSJ" then
		setHint({ { powerKey, "POWER DOWN" } })
	elseif kaioken >= #PowerConfig.KaiokenLevels then
		setHint({ { powerKey, "LET IT GO" } })
	elseif kaioken > 0 then
		setHint({ { kaiokenKey, "HIGHER!" }, { powerKey, "LET IT GO" } })
	else
		setHint({ { powerKey, "POWER UP" }, { kaiokenKey, "KAIOKEN" } })
	end
end

local function showToast(message: string)
	toast:SetText(message)
	toast.Holder.Visible = true
	toastUntil = os.clock() + 1.4
	task.delay(1.45, function()
		if os.clock() >= toastUntil then
			toast.Holder.Visible = false
		end
	end)
end

----------------------------------------------------------------------------------------
-- camera: swings round in front of you while you power up
----------------------------------------------------------------------------------------
local function takeCamera()
	local camera = Workspace.CurrentCamera
	if not savedCamera then
		savedCamera = { Type = camera.CameraType, FOV = camera.FieldOfView }
	end
	camera.CameraType = Enum.CameraType.Scriptable
end

local function releaseCamera()
	local camera = Workspace.CurrentCamera
	if savedCamera then
		camera.CameraType = savedCamera.Type == Enum.CameraType.Scriptable and Enum.CameraType.Custom or savedCamera.Type
		TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = savedCamera.FOV }):Play()
		savedCamera = nil
	end
end

RunService:BindToRenderStep("DWPowerCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not savedCamera or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	if not root then
		return
	end
	local intensity = bursting and 1 or charge
	local distance = PowerConfig.CameraDistance * (bursting and 1.25 or (1 - 0.18 * charge))
	local base = root.CFrame
	local eye = base * Vector3.new(0, PowerConfig.CameraHeight - 0.3 * intensity, -distance) -- in front (characters face -Z)
	local look = base.Position + Vector3.new(0, PowerConfig.CameraLookHeight, 0)
	camShake = math.max(camShake - dt * 2, intensity * PowerConfig.CameraShake)
	local shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (2 * camShake)
	local target = CFrame.lookAt(eye + shake, look)
	camera.CFrame = camera.CFrame:Lerp(target, 1 - math.exp(-dt * 7))
	fovKick = math.max(0, fovKick - dt * 12)
	camera.FieldOfView = (savedCamera.FOV or 70) + fovKick
end)

----------------------------------------------------------------------------------------
-- charging
----------------------------------------------------------------------------------------
local function tap()
	if not charging then
		return
	end
	charge = math.min(1, charge + PowerConfig.ChargePerTap)
	if charge >= 1 then
		full = true
	end
	promptScale.Scale = 1.18
	tapBall.Scale.Scale = 1.12
end

local function setTapBinding(on: boolean)
	if on then
		-- higher priority than the jump button, and "Sink" so spamming Space doesn't jump
		ContextActionService:BindActionAtPriority("DWTap", function(_, state)
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 10, PowerConfig.TapKey)
	else
		ContextActionService:UnbindAction("DWTap")
	end
	tapButton.Visible = on and touch
end

local function startCharging()
	local okSize, viewport = pcall(function()
		return Workspace.CurrentCamera.ViewportSize
	end)
	panelScale.Scale = (okSize and viewport and viewport.Y > 100) and math.clamp(viewport.Y / 720, 0.66, 1.15) or 1
	charging = true
	charge = 0
	full = false
	startedAt = os.clock()
	transformSentAt = -math.huge
	remote:FireServer("Start")
	takeCamera()
	panel.Visible = true
	prompt:SetText(touch and "TAP!  TAP!  TAP!" or ("SPAM  " .. string.upper(PowerConfig.TapKey.Name) .. "!"))
	setTapBinding(true)
	refreshHint()
end

local function stopCharging(sendCancel: boolean)
	if charging and sendCancel then
		remote:FireServer("Cancel")
	end
	charging = false
	charge = 0
	full = false
	panel.Visible = false
	setTapBinding(false)
	grade.Contrast, grade.Saturation = 0, 0
	if not bursting then
		releaseCamera()
	end
	refreshHint()
end

local function playBurst()
	bursting = true
	charging = false
	panel.Visible = false
	setTapBinding(false)
	local cutscene = PowerConfig.Cutscene and Cutscene and character
	if cutscene then
		gui.Enabled = false -- the cutscene has the screen to itself
		Cutscene.Play(character, PowerConfig.BurstTime - 0.05, function()
			gui.Enabled = true
		end)
	end
	-- the moment the power explodes out
	task.delay(PowerConfig.ExplodeAt or 0, function()
		if not bursting then
			return
		end
		camShake = PowerConfig.CameraShake * 4
		fovKick = 18
		grade.Brightness = 0.3
		grade.Contrast = 0.25
		grade.Saturation = 0.35
		grade.TintColor = Color3.fromRGB(255, 236, 200)
		TweenService:Create(grade, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
		}):Play()
		if not cutscene then
			flash.BackgroundColor3 = Color3.new(1, 1, 1)
			flash.BackgroundTransparency = 0
			TweenService:Create(flash, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
			bigText.Holder.Visible = true
			bigScale.Scale = 0.5
			TweenService:Create(bigScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			task.delay(1.6, function()
				TweenService:Create(bigScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.01 }):Play()
				task.delay(0.26, function()
					bigText.Holder.Visible = false
				end)
			end)
		end
	end)
	task.delay(PowerConfig.BurstTime, function()
		bursting = false
		releaseCamera()
		refreshHint()
	end)
end

local function onPowerKey(_, state)
	if state ~= Enum.UserInputState.Begin or not character then
		return Enum.ContextActionResult.Pass
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or bursting then
		return Enum.ContextActionResult.Sink
	end
	if charging then
		stopCharging(true)
	elseif attr("Form") == "SSJ" or (attr("Kaioken") or 0) > 0 then
		remote:FireServer("PowerDown")
	elseif attr("Exhausted") then
		showToast("TOO TIRED!")
	else
		startCharging()
	end
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("DWPower", onPowerKey, true, PowerConfig.PowerKey)
ContextActionService:SetTitle("DWPower", "Power")

-- K: light the Kaioken, or push it higher (the server checks and answers by setting the
-- Kaioken attribute; the pop-up plays when it does)
local function onKaiokenKey(_, state)
	if state ~= Enum.UserInputState.Begin or not character then
		return Enum.ContextActionResult.Pass
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or charging or bursting then
		return Enum.ContextActionResult.Sink
	end
	local level = attr("Kaioken") or 0
	if attr("Form") == "SSJ" then
		showToast("BASE FORM ONLY!")
	elseif attr("Exhausted") then
		showToast("TOO TIRED!")
	elseif level >= #PowerConfig.KaiokenLevels then
		showToast("THAT'S THE LIMIT!")
	elseif (attr("Ki") or 0) < PowerConfig.KaiokenKiCost then
		showToast("NOT ENOUGH KI!")
	else
		remote:FireServer("Kaioken")
	end
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("DWKaioken", onKaiokenKey, true, PowerConfig.KaiokenKey)
ContextActionService:SetTitle("DWKaioken", "Kaioken")

-- the moment it lights (or climbs): the shout on screen, a red flash, a kick of the camera
local function kaiokenPop(level: number)
	local mult = PowerConfig.KaiokenLevels[level] or 2
	kaiokenText:SetText(level <= 1 and "KAIOKEN!" or ("KAIOKEN x" .. mult .. "!"))
	kaiokenText.Holder.Visible = true
	kaiokenScale.Scale = 0.45
	TweenService:Create(kaiokenScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local shownAt = os.clock()
	kaiokenText.ShownAt = shownAt
	task.delay(1.1, function()
		if kaiokenText.ShownAt == shownAt then
			TweenService:Create(kaiokenScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.01 }):Play()
			task.delay(0.23, function()
				if kaiokenText.ShownAt == shownAt then
					kaiokenText.Holder.Visible = false
				end
			end)
		end
	end)
	flash.BackgroundColor3 = Color3.fromRGB(255, 40, 30)
	flash.BackgroundTransparency = 0.55
	TweenService:Create(flash, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
	grade.TintColor = Color3.fromRGB(255, 205, 200)
	grade.Contrast = 0.15
	TweenService:Create(grade, TweenInfo.new(0.8), { TintColor = Color3.new(1, 1, 1), Contrast = 0 }):Play()
	local camera = Workspace.CurrentCamera
	if camera and not savedCamera then
		local fov = camera.FieldOfView
		camera.FieldOfView = fov + 4 + level * 1.5
		TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = fov }):Play()
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- a short camera shake (the camera follows the humanoid's offset)
		task.spawn(function()
			for k = 1, 9 do
				humanoid.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * (0.5 * (1 - k / 10))
				task.wait(0.03)
			end
			humanoid.CameraOffset = Vector3.zero
		end)
	end
end

tapButton.Activated:Connect(tap)

local STAGES = {
	{ 0.0, "Gather your energy..." },
	{ PowerConfig.AuraStart, "Aura rising!" },
	{ PowerConfig.HairStart, "Power surging!" },
	{ 0.6, "Faster!!" },
	{ 0.85, "BREAK THROUGH!!!" },
}

RunService.RenderStepped:Connect(function(dt)
	if not charging then
		return
	end
	if os.clock() - startedAt > 1.2 and attr("PowerState") ~= "Charging" then
		stopCharging(false) -- the server didn't accept (e.g. already transforming)
		return
	end
	if full then
		charge = 1
	else
		charge = math.max(0, charge - PowerConfig.ChargeDecay * dt)
	end
	promptScale.Scale += (1 - promptScale.Scale) * math.min(1, dt * 10)
	tapBall.Scale.Scale += (1 - tapBall.Scale.Scale) * math.min(1, dt * 12)
	barFill:SetFill(charge)
	-- ki blue, turning Super Saiyan gold once your hair starts lifting
	barFill:SetColor(DragonUI.KI:Lerp(DragonUI.GOLD, math.clamp((charge - PowerConfig.HairStart) / 0.5, 0, 1)))
	percent.Text = math.floor(charge * 100 + 0.5) .. "%"
	stage.TextColor3 = PAPER:Lerp(DragonUI.GOLD, math.clamp((charge - 0.5) * 2, 0, 1))
	grade.Contrast = 0.12 * charge
	grade.Saturation = 0.2 * charge
	local text = STAGES[1][2]
	for _, s in STAGES do
		if charge >= s[1] then
			text = s[2]
		end
	end
	stage.Text = text
	local now = os.clock()
	if now - lastSend >= SEND_EVERY then
		lastSend = now
		remote:FireServer("Charge", charge)
	end
	if full and now - startedAt >= PowerConfig.MinChargeTime and now - transformSentAt > 0.6 then
		transformSentAt = now
		remote:FireServer("Charge", 1)
		remote:FireServer("Transform")
	end
end)

----------------------------------------------------------------------------------------
-- follow the character and the server's verdicts
----------------------------------------------------------------------------------------
local function onCharacter(newCharacter: Model)
	character = newCharacter
	charging, bursting = false, false
	panel.Visible = false
	setTapBinding(false)
	if Cutscene then
		Cutscene.Stop()
	end
	gui.Enabled = true
	releaseCamera()
	newCharacter:GetAttributeChangedSignal("PowerState"):Connect(function()
		local state = newCharacter:GetAttribute("PowerState")
		if state == "Bursting" and not bursting then
			playBurst()
		elseif state == "Idle" and charging then
			stopCharging(false) -- the server cancelled us
		end
		refreshHint()
	end)
	newCharacter:GetAttributeChangedSignal("Form"):Connect(refreshHint)
	local lastKaioken = newCharacter:GetAttribute("Kaioken") or 0
	newCharacter:GetAttributeChangedSignal("Kaioken"):Connect(function()
		local level = newCharacter:GetAttribute("Kaioken") or 0
		if level > lastKaioken and character == newCharacter then
			kaiokenPop(level)
		end
		lastKaioken = level
		refreshHint()
	end)
	newCharacter:GetAttributeChangedSignal("Exhausted"):Connect(function()
		if newCharacter:GetAttribute("Exhausted") and character == newCharacter then
			showToast("YOUR BODY GAVE OUT...")
		end
		refreshHint()
	end)
	local humanoid = newCharacter:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.Died:Connect(function()
			stopCharging(false)
			bursting = false
			if Cutscene then
				Cutscene.Stop()
			end
			releaseCamera()
		end)
	end
	refreshHint()
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	onCharacter(player.Character)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">PowerFX</string>
          <ProtectedString name="Source"><![CDATA[--[[
	PowerFX  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Draws powering up for EVERY character on this player's screen, from the attributes
	PowerUpServer sets (so everyone sees everyone's aura):
	  * the power-up animation, coded joint by joint (no animation asset needed):
	      start     standing tall, fists clenched at the waist, elbows out
	      charging  the fuller the bar, the more you hunch over with your head down and your
	                elbows thrown wide, trembling with effort
	      transform you stay hunched as the power builds, then at the explosion you lean back,
	                head up, arms lowered and spread ... then your arms come in (your left
	                fingers on the inside of your right elbow), you coil, and swipe the left arm
	                out into a point at the camera: "YOU'RE FINISHED!" (PowerConfig.PointAt)
	      Kaioken   each level snaps you into a flex: chest out, head back, fists driven down
	      exhausted bent over, head hanging, breathing hard
	  * the aura: a glowing ring on the ground at your feet with a sheet of fire rising from it
	    all the way round you. The flames are rooted on the ring, lean outward as they rise and
	    fade at their tips; thin streaks shoot up through them and licks of flame break off and
	    rise. Energy swirls round you, ripples pulse out along the ground and sparks float up.
	    It grows bigger and faster as the bar fills; blue in base form, gold as a Super Saiyan,
	    red in Kaioken. After transforming the gold aura stays up, then fades when you calm down
	    (the Breeze attribute).
	  * the Kaioken: a red aura sized by the level, a red glow over your whole body throbbing
	    like a heartbeat (faster the higher you go), a red shockwave each time you push it, and
	    a strained tremble at x10 and x20,
	  * dust blasting off the ground and rocks lifting at high power,
	  * the transformation explosion: a pillar of light, a flash, a shockwave ring and a spray.
	The hair and belt being blown upward is HairPhysics reacting to the AuraWind attribute.
	Settings: ReplicatedStorage > PowerConfig.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local ROCKS = 8
local S = PowerConfig.AuraSize
local EXPLODE_AT = PowerConfig.ExplodeAt or 0
local rng = Random.new()

local folder = Instance.new("Folder")
folder.Name = "PowerFX"
folder.Parent = Workspace

local function smooth(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- moves current toward target; rate = how quickly (per second)
local function ease(current: number, target: number, rate: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-dt * rate))
end

----------------------------------------------------------------------------------------
-- the power-up animation: three key poses for each R15 joint, blended in code.
-- Characters face -Z: a negative X turn bends the spine or head forward, a positive one
-- leans it back; on the shoulders a Z turn swings the arm out to the side.
----------------------------------------------------------------------------------------
local READY = { -- standing tall, fists clenched at the waist, elbows out
	Root = CFrame.new(0, -0.01, 0),
	Waist = CFrame.Angles(0.06, 0, 0),
	Neck = CFrame.Angles(-0.06, 0, 0),
	LeftShoulder = CFrame.Angles(-0.4, -0.25, -0.32),
	RightShoulder = CFrame.Angles(-0.4, 0.25, 0.32),
	LeftElbow = CFrame.Angles(1.25, 0, 0),
	RightElbow = CFrame.Angles(1.25, 0, 0),
	LeftWrist = CFrame.Angles(0.2, 0, 0),
	RightWrist = CFrame.Angles(0.2, 0, 0),
	LeftHip = CFrame.Angles(0.04, 0, -0.1),
	RightHip = CFrame.Angles(0.04, 0, 0.1),
	LeftKnee = CFrame.Angles(-0.08, 0, 0),
	RightKnee = CFrame.Angles(-0.08, 0, 0),
	LeftAnkle = CFrame.Angles(0.04, 0, 0.1),
	RightAnkle = CFrame.Angles(0.04, 0, -0.1),
}
local STRAIN = { -- hunched over, head down, elbows thrown wide, knees bent
	Root = CFrame.new(0, -0.16, 0) * CFrame.Angles(-0.08, 0, 0),
	Waist = CFrame.Angles(-0.28, 0, 0),
	Neck = CFrame.Angles(-0.3, 0, 0),
	LeftShoulder = CFrame.Angles(0.1, -0.35, -0.7),
	RightShoulder = CFrame.Angles(0.1, 0.35, 0.7),
	LeftElbow = CFrame.Angles(1.15, 0, 0),
	RightElbow = CFrame.Angles(1.15, 0, 0),
	LeftWrist = CFrame.Angles(0.3, 0, 0),
	RightWrist = CFrame.Angles(0.3, 0, 0),
	LeftHip = CFrame.Angles(0.5, 0, -0.3),
	RightHip = CFrame.Angles(0.5, 0, 0.3),
	LeftKnee = CFrame.Angles(-0.95, 0, 0),
	RightKnee = CFrame.Angles(-0.95, 0, 0),
	LeftAnkle = CFrame.Angles(0.45, 0, 0.15),
	RightAnkle = CFrame.Angles(0.45, 0, -0.15),
}
local RELEASE = { -- the explosion: leaning back, head up, arms lowered and spread
	Root = CFrame.new(0, -0.08, 0) * CFrame.Angles(0.1, 0, 0),
	Waist = CFrame.Angles(0.3, 0, 0),
	Neck = CFrame.Angles(0.45, 0, 0),
	LeftShoulder = CFrame.Angles(-0.2, 0, -0.7),
	RightShoulder = CFrame.Angles(-0.2, 0, 0.7),
	LeftElbow = CFrame.Angles(0.2, 0, 0),
	RightElbow = CFrame.Angles(0.2, 0, 0),
	LeftWrist = CFrame.Angles(-0.1, 0, 0),
	RightWrist = CFrame.Angles(-0.1, 0, 0),
	LeftHip = CFrame.Angles(0.2, 0, -0.32),
	RightHip = CFrame.Angles(0.2, 0, 0.32),
	LeftKnee = CFrame.Angles(-0.35, 0, 0),
	RightKnee = CFrame.Angles(-0.35, 0, 0),
	LeftAnkle = CFrame.Angles(0.05, 0, 0.2),
	RightAnkle = CFrame.Angles(0.05, 0, -0.2),
}
-- how much each joint trembles with effort
local SHAKE = { Root = 0.5, Waist = 1, Neck = 1.2, LeftShoulder = 0.7, RightShoulder = 0.7, LeftElbow = 0.5, RightElbow = 0.5 }

-- Kaioken: the flex you snap into each time you light it or push it higher: chest out, head
-- back (a shout), arms driven down and back, fists clenched, knees bent
local KAIOKEN_FLEX = {
	Root = CFrame.new(0, -0.14, 0) * CFrame.Angles(0.06, 0, 0),
	Waist = CFrame.Angles(0.22, 0, 0),
	Neck = CFrame.Angles(0.38, 0, 0),
	LeftShoulder = CFrame.Angles(-0.38, 0, -0.42),
	RightShoulder = CFrame.Angles(-0.38, 0, 0.42),
	LeftElbow = CFrame.Angles(0.5, 0, 0),
	RightElbow = CFrame.Angles(0.5, 0, 0),
	LeftWrist = CFrame.Angles(-0.2, 0, 0),
	RightWrist = CFrame.Angles(-0.2, 0, 0),
	LeftHip = CFrame.Angles(0.28, 0, -0.24),
	RightHip = CFrame.Angles(0.28, 0, 0.24),
	LeftKnee = CFrame.Angles(-0.5, 0, 0),
	RightKnee = CFrame.Angles(-0.5, 0, 0),
	LeftAnkle = CFrame.Angles(0.22, 0, 0.14),
	RightAnkle = CFrame.Angles(0.22, 0, -0.14),
}
-- exhausted (the Kaioken pushed until your body gave out): bent over, head hanging, arms limp
local SLUMP = {
	Root = CFrame.new(0, -0.1, 0) * CFrame.Angles(-0.1, 0, 0),
	Waist = CFrame.Angles(-0.3, 0, 0),
	Neck = CFrame.Angles(-0.35, 0, 0),
	LeftShoulder = CFrame.Angles(0.15, 0, 0.08),
	RightShoulder = CFrame.Angles(0.15, 0, -0.08),
	LeftElbow = CFrame.Angles(0.2, 0, 0),
	RightElbow = CFrame.Angles(0.2, 0, 0),
	LeftWrist = CFrame.identity,
	RightWrist = CFrame.identity,
	LeftHip = CFrame.Angles(0.3, 0, -0.06),
	RightHip = CFrame.Angles(0.3, 0, 0.06),
	LeftKnee = CFrame.Angles(-0.5, 0, 0),
	RightKnee = CFrame.Angles(-0.5, 0, 0),
	LeftAnkle = CFrame.Angles(0.2, 0, 0),
	RightAnkle = CFrame.Angles(0.2, 0, 0),
}

-- The "YOU'RE FINISHED!" point at the end of the transformation. From the release pose your
-- arms come in (TOUCH: right forearm up, left fingertips on the inside of your right elbow),
-- you coil for a beat, then swipe the left arm out into a point at the camera (HIT). Every
-- joint starts a moment after the one driving it and overshoots a little before settling, the
-- body sinks into the stance and the head gives a nod. Angles in degrees: { x, y, z } (Root
-- also moves: { x, y, z, studs right, up, back }).
local POINT_TOUCH = {
	Root = { 0, -10, 0, 0, -0.05, 0 },
	Waist = { -4, -18, 0 },
	Neck = { -6, 26, 0 },
	RightShoulder = { 72, 0, -32 },
	RightElbow = { 108, 0, 0 },
	RightWrist = { 0, 0, 0 },
	LeftShoulder = { 56.3, -18.5, 78.1 },
	LeftElbow = { 54.8, 0, 0 },
	LeftWrist = { -10.6, 0, 26.7 },
	LeftHip = { 6, 0, -10 },
	RightHip = { 6, 0, 8 },
	LeftKnee = { -12, 0, 0 },
	RightKnee = { -8, 0, 0 },
	LeftAnkle = { 4, 0, 6 },
	RightAnkle = { 2, 0, -6 },
}
local POINT_HIT = {
	Root = { 0, -12, 0, 0, -0.12, 0 },
	Waist = { -7, -16, 0 },
	Neck = { -9, 24, 6 },
	RightShoulder = { -28, 0, 24 }, -- the right fist pulled back to the hip
	RightElbow = { 100, 0, 0 },
	RightWrist = { 0, 0, 0 },
	LeftShoulder = { 86.4, 1.6, -29.6 }, -- the left arm straight out at the camera
	LeftElbow = { 4, 0, 0 },
	LeftWrist = { 1.5, 0, -16.4 },
	LeftHip = { 16, 0, -18 },
	RightHip = { -6, 0, 16 },
	LeftKnee = { -24, 0, 0 },
	RightKnee = { -10, 0, 0 },
	LeftAnkle = { 8, 0, 10 },
	RightAnkle = { -4, 0, -8 },
}
local POINT_COIL = { Root = { 0, -3, 0 }, Waist = { 0, -5, 0 }, LeftShoulder = { 0, 0, 5 }, RightElbow = { 6, 0, 0 } }
-- per joint: { delay into TOUCH, delay into the swipe, swipe length, overshoot }
local POINT_TIMING = {
	default = { 0, 0, 0.28, 0.6 },
	Root = { 0, 0, 0.3, 0.8 },
	Waist = { 0.03, 0.01, 0.26, 1.2 },
	Neck = { 0.02, 0.04, 0.24, 1.0 },
	LeftShoulder = { 0.06, 0.02, 0.2, 2.0 },
	LeftElbow = { 0.09, 0.05, 0.17, 1.6 },
	LeftWrist = { 0.11, 0.08, 0.15, 1.8 },
	RightShoulder = { 0.05, 0, 0.22, 1.2 },
	RightElbow = { 0.08, 0.02, 0.2, 1.2 },
	RightWrist = { 0.1, 0.04, 0.18, 1.0 },
}
local POINT_IN, POINT_SWIPE = 0.4, 0.62 -- seconds after PointAt: arms in by; the swipe starts
local POINT_LAND = POINT_SWIPE + 0.19 -- the point lands (the third manga panel slams in)

local function smoother(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * x * (x * (x * 6 - 15) + 10)
end

-- 0..1 with an overshoot past 1 before settling (bigger c1 = more overshoot)
local function backOut(x: number, c1: number): number
	x = math.clamp(x, 0, 1)
	local c3 = c1 + 1
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

local POINT_E = {}
do
	local function angles(t)
		return Vector3.new(math.rad(t[1]), math.rad(t[2]), math.rad(t[3])), Vector3.new(t[4] or 0, t[5] or 0, t[6] or 0)
	end
	for name, cf in RELEASE do
		local rx, ry, rz = cf:ToEulerAnglesXYZ()
		local ta, tp = angles(POINT_TOUCH[name])
		local ha, hp = angles(POINT_HIT[name])
		local coil = POINT_COIL[name] and (angles(POINT_COIL[name])) or Vector3.zero
		POINT_E[name] = { RA = Vector3.new(rx, ry, rz), RP = cf.Position, TA = ta, TP = tp, HA = ha, HP = hp, Coil = coil }
	end
end

-- the point pose of one joint, t seconds after PowerConfig.PointAt
local function pointPose(name: string, t: number): CFrame
	local e = POINT_E[name]
	local d = POINT_TIMING[name] or POINT_TIMING.default
	local a = smoother((t - d[1]) / POINT_IN)
	local b = backOut((t - POINT_SWIPE - d[2]) / d[3], d[4])
	local coil = smoother((t - POINT_IN) / (POINT_SWIPE - POINT_IN)) * (1 - smoother((t - POINT_SWIPE) / 0.1))
	local ang = e.RA + (e.TA - e.RA) * a + (e.HA - e.TA) * b + e.Coil * coil
	local pos = e.RP + (e.TP - e.RP) * a + (e.HP - e.TP) * b
	local land = t - POINT_LAND
	if land > 0 then
		if name == "Root" then -- the body sinks into the stance and bobs back up
			pos += Vector3.new(0, -0.07 * math.exp(-8 * land) * math.cos(13 * land), 0)
		elseif name == "Neck" then -- a nod
			ang += Vector3.new(math.rad(-7) * math.exp(-9 * land) * math.sin(15 * land), 0, 0)
		end
		if name == "Waist" or name == "LeftShoulder" then -- breathing while holding it
			ang += Vector3.new(math.rad(1.2) * math.sin(land * 5.5) * smoother(land / 0.6), 0, 0)
		end
	end
	return CFrame.new(pos) * CFrame.Angles(ang.X, ang.Y, ang.Z)
end

-- how strongly the Kaioken flex holds, t seconds after you pushed it a level
local function flexWeight(t: number): number
	if t < 0 or t > 0.9 then
		return 0
	elseif t < 0.1 then
		return smoother(t / 0.1)
	elseif t < 0.42 then
		return 1
	end
	return 1 - smoother((t - 0.42) / 0.45)
end

----------------------------------------------------------------------------------------
-- the aura
----------------------------------------------------------------------------------------
local function seq(points): NumberSequence
	local keys = {}
	for _, p in points do
		table.insert(keys, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(keys)
end

local function colours(points): ColorSequence
	local keys = {}
	for _, p in points do
		table.insert(keys, ColorSequenceKeypoint.new(p[1], p[2]))
	end
	return ColorSequence.new(keys)
end

-- sizes in studs, each {at no power, at full power}
local RING_RADIUS = { 1.7, 2.4 } -- the glowing ring on the ground the flames rise from
local FLAME_HEIGHT = { 2.6, 8.5 } -- the tallest flames
local FLAME_LEAN = { 0.4, 2.2 } -- how far the tops of the tallest flames lean out
local RING_SEGMENTS = 36 -- glowing pieces the ground ring is made of
local RIPPLE_SEGMENTS = 24 -- ... and each ripple pulsing out from it
local SWOOSHES = 4 -- energy streaks swirling up around you

-- The flames are Beams: tapered ribbons that always face the camera, so each one reads as a
-- flame tongue. Per group: how many; how tall (share of FLAME_HEIGHT) and wide at the base;
-- how fast they flicker {no power, full power}; how see-through from root (0) to tip (1); and
-- colours. The sheet's flames overlap all the way round, so together they look like one fire,
-- brightest at its edges where you look through the most flames.
local GROUPS = {
	{ -- the sheet of fire, rooted on the ground ring
		Kind = "Sheet", Count = 30, Height = { 0.55, 1 }, Width = { 0.9, 1.5 }, Speed = { 2, 5 },
		Transparency = seq({ { 0, 0.78 }, { 0.15, 0.5 }, { 0.45, 0.45 }, { 0.8, 0.78 }, { 1, 1 } }),
		Paint = function(core, main, edge)
			return colours({ { 0, main }, { 0.5, main }, { 1, edge } })
		end,
	},
	{ -- thin bright streaks shooting up through it
		Kind = "Streak", Count = 8, Height = { 0.6, 1 }, Width = { 0.18, 0.3 }, Speed = { 4, 8 },
		Transparency = seq({ { 0, 0.75 }, { 0.25, 0.3 }, { 0.7, 0.55 }, { 1, 1 } }),
		Paint = function(core, main, edge)
			return colours({ { 0, Color3.new(1, 1, 1) }, { 0.5, core }, { 1, main } })
		end,
	},
	{ -- licks of flame breaking off and rising (Speed = licks per second)
		Kind = "Lick", Count = 10, Height = { 0.25, 0.45 }, Width = { 0.6, 1.1 }, Speed = { 1.2, 2.4 },
		Transparency = seq({ { 0, 1 }, { 0.2, 0.45 }, { 0.6, 0.55 }, { 1, 1 } }),
		Paint = function(core, main, edge)
			return colours({ { 0, main }, { 0.5, main }, { 1, edge } })
		end,
	},
}
local AURA_FPS = math.max(PowerConfig.AuraFrameRate or 24, 1)

-- an attachment frame whose axis (X) points straight up
local UP_FRAME = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis)

-- an attachment frame at pos whose axis (X) points along dir (a unit vector); a Beam's curve
-- leaves and arrives along its attachments' axes
local function pointing(pos: Vector3, dir: Vector3): CFrame
	local side = dir:Cross(Vector3.zAxis)
	if side.Magnitude < 1e-3 then
		side = dir:Cross(Vector3.xAxis)
	end
	return CFrame.fromMatrix(pos, dir, side.Unit)
end

----------------------------------------------------------------------------------------
-- building one character's effects
----------------------------------------------------------------------------------------
local function fxPart(name: string, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size
	p.Parent = folder
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightInfluence = 0
	for k, v in props do
		e[k] = v
	end
	e.Parent = parent
	return e
end

local function newBeam(parent: Instance, transparency: NumberSequence)
	local a0 = Instance.new("Attachment")
	a0.Parent = parent
	local a1 = Instance.new("Attachment")
	a1.Parent = parent
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	beam.Segments = 10
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Width0 = 0
	beam.Width1 = 0
	beam.Transparency = transparency
	pcall(function()
		beam.Brightness = 2 -- newer property: a little extra glow where it exists
	end)
	beam.Parent = parent
	return beam, a0, a1
end

local function ringPiece(name: string): Part
	local p = fxPart(name, Vector3.new(0.4, 0.06, 0.2))
	p.Material = Enum.Material.Neon
	return p
end

-- a new random start for a flame (and, for a lick, a new place to break off from)
local function reroll(t)
	t.WidthMul = rng:NextNumber(0.75, 1.25)
	t.HeightMul = rng:NextNumber(0, 1)
	t.LeanMul = rng:NextNumber(0.7, 1.3)
	t.SpeedMul = rng:NextNumber(0.75, 1.3)
	if t.Kind == "Lick" then
		t.Angle = rng:NextNumber(0, math.pi * 2)
	end
end

local function resetSwoosh(w, feet: number, first: boolean)
	w.Angle = rng:NextNumber(0, math.pi * 2)
	w.R = rng:NextNumber(2.2, 3.2) * S
	w.Y = feet + (first and rng:NextNumber(0, 6) or rng:NextNumber(0, 1)) * S
	w.Top = feet + rng:NextNumber(6, 9) * S
	w.Rise = rng:NextNumber(4, 7) * S
	w.Spin = rng:NextNumber(3.5, 5.5) * (rng:NextNumber() < 0.5 and -1 or 1)
end

-- The character's joints the animation turns. Characters now spawn with AnimationConstraints
-- (Roblox's "Avatar Joint Upgrade") instead of Motor6Ds; both are posed the same way, through
-- their Transform.
local function findJoints(character: Model)
	local joints = {}
	for _, d in character:GetDescendants() do
		if READY[d.Name] and (d:IsA("AnimationConstraint") or d:IsA("Motor6D")) then
			if not joints[d.Name] or d:IsA("AnimationConstraint") then
				joints[d.Name] = d
			end
		end
	end
	return joints
end

local function newFX(character: Model, root: BasePart)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local fx = {
		Character = character,
		Intensity = 0,
		Pose = 0,
		Strain = 0,
		Release = 0,
		Shudder = 0,
		Flare = 1,
		Gold = 0,
		PaintedGold = -1,
		Red = 0, -- Kaioken red (the aura's colour)
		PaintedRed = -1,
		GlowW = 0, -- the red glow over the body
		PointMix = 0, -- 1 while the "YOU'RE FINISHED!" point plays
		PointT = 0,
		FlexW = 0, -- the Kaioken flex
		Slump = 0, -- exhausted
		KaiokenSeen = 0,
		Spin = 0, -- the whole fire slowly turns round you
		RipplePhase = 0,
		-- how far below the HumanoidRootPart's centre the feet are
		FootDrop = (humanoid and humanoid.HipHeight or 2) + root.Size.Y / 2,
	}
	fx.Aura = fxPart("Aura", Vector3.new(4.8, 6, 4.8) * S)

	fx.Tongues = {}
	local amount = math.max(PowerConfig.AuraFlames or 1, 0)
	for gi, group in GROUPS do
		local count = math.max(1, math.floor(group.Count * amount + 0.5))
		local offset = rng:NextNumber(0, math.pi * 2)
		for k = 1, count do
			local beam, a0, a1 = newBeam(fx.Aura, group.Transparency)
			local t = {
				Group = group, GroupIndex = gi, Kind = group.Kind, Index = k, Of = count,
				Beam = beam, A0 = a0, A1 = a1, Boil = 1, BoilAngle = 0,
				-- spread evenly round the ring, a little uneven
				Angle = (k - 1) / count * math.pi * 2 + offset + rng:NextNumber(-0.4, 0.4) * (math.pi * 2 / count),
				Phase = rng:NextNumber(0, math.pi * 2),
				Life = rng:NextNumber(),
			}
			reroll(t)
			table.insert(fx.Tongues, t)
		end
	end
	fx.FrameClock = math.huge -- draw the first frame straight away

	fx.Swooshes = {}
	for _ = 1, SWOOSHES do
		local beam, a0, a1 = newBeam(fx.Aura, seq({ { 0, 1 }, { 0.5, 0.35 }, { 1, 0.05 } }))
		local w = { Beam = beam, A0 = a0, A1 = a1 }
		resetSwoosh(w, -fx.FootDrop, true)
		table.insert(fx.Swooshes, w)
	end

	-- the glowing ring on the ground, and the ripples pulsing out of it
	fx.Ring, fx.RingLocal = {}, {}
	for k = 1, RING_SEGMENTS do
		fx.Ring[k] = ringPiece("AuraRing")
		fx.RingLocal[k] = CFrame.identity
	end
	fx.RipplePieces, fx.RippleLocal = {}, {}
	for k = 1, RIPPLE_SEGMENTS do
		fx.RipplePieces[k] = ringPiece("AuraRipple")
		fx.RippleLocal[k] = CFrame.identity
	end

	fx.Streaks = emitter(fx.Aura, { -- light streaks shooting up past the body
		Texture = SPARK,
		LightEmission = 1,
		Shape = Enum.ParticleEmitterShape.Cylinder,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection = Enum.NormalId.Top,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Lifetime = NumberRange.new(0.15, 0.3),
		Speed = NumberRange.new(26, 42),
		Squash = NumberSequence.new(2.5),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * S), NumberSequenceKeypoint.new(1, 0.1 * S) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
	})
	fx.Sparks = emitter(fx.Aura, { -- sparks floating up through the fire
		Texture = SPARK,
		LightEmission = 1,
		Shape = Enum.ParticleEmitterShape.Cylinder,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection = Enum.NormalId.Top,
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(3, 9),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, 2, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.28 * S),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	fx.Haze = emitter(fx.Aura, { -- a soft glow around the flames
		Texture = SMOKE,
		LightEmission = 1,
		EmissionDirection = Enum.NormalId.Top,
		Lifetime = NumberRange.new(0.7, 1.1),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.88), NumberSequenceKeypoint.new(1, 1) }),
	})
	fx.Light = Instance.new("PointLight")
	fx.Light.Shadows = false
	fx.Light.Brightness = 0
	fx.Light.Parent = fx.Aura

	fx.Ground = fxPart("GroundFX", Vector3.new(1, 0.2, 1))
	fx.Dust = emitter(fx.Ground, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(190, 180, 165)),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(88, 88),
		Speed = NumberRange.new(18, 28),
		Drag = 3,
		Acceleration = Vector3.new(0, 3, 0),
		Lifetime = NumberRange.new(0.8, 1.4),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5 * S), NumberSequenceKeypoint.new(1, 5 * S) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		LightInfluence = 1,
	})

	fx.Rocks = {}
	for i = 1, ROCKS do
		local rock = fxPart("Rock", Vector3.new(1, 1, 1) * rng:NextNumber(0.35, 0.8) * S)
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(110, 104, 98)
		table.insert(fx.Rocks, {
			Part = rock,
			Angle = (i / ROCKS) * math.pi * 2 + rng:NextNumber(-0.3, 0.3),
			Radius = rng:NextNumber(3.5, 6) * S,
			Top = rng:NextNumber(1.2, 3.8),
			Height = 0,
			Spin = rng:NextNumber(-1.5, 1.5),
			Bob = rng:NextNumber(0, 6),
		})
	end

	-- the animation needs the character's joints
	fx.Motors = findJoints(character)
	fx.NextJointScan = 0
	fx.LastWritten = {}
	return fx
end

-- true if two joint angles are the same (reading one back can lose a hair of precision)
local function sameFrame(a: CFrame, b: CFrame): boolean
	local ca = { a:GetComponents() }
	local cb = { b:GetComponents() }
	for k = 1, 12 do
		if math.abs(ca[k] - cb[k]) > 1e-4 then
			return false
		end
	end
	return true
end

local function destroyFX(fx)
	fx.Aura:Destroy()
	fx.Ground:Destroy()
	for _, r in fx.Rocks do
		r.Part:Destroy()
	end
	for _, p in fx.Ring do
		p:Destroy()
	end
	for _, p in fx.RipplePieces do
		p:Destroy()
	end
	if fx.Pillar then
		fx.Pillar:Destroy()
	end
	if fx.Glow then
		fx.Glow:Destroy()
	end
	for name, motor in fx.Motors do
		if motor.Parent and fx.LastWritten[name] and sameFrame(motor.Transform, fx.LastWritten[name]) then
			motor.Transform = CFrame.identity
		end
	end
end

-- recolours everything when the aura's colour changes (base blue <-> Super Saiyan gold, or
-- Kaioken red)
local function paint(fx)
	local g, r = fx.Gold, fx.Red
	local main = PowerConfig.BaseAuraColor:Lerp(PowerConfig.SSJAuraColor, g):Lerp(PowerConfig.KaiokenAuraColor, r)
	local edge = PowerConfig.BaseAuraEdge:Lerp(PowerConfig.SSJAuraEdge, g):Lerp(PowerConfig.KaiokenAuraEdge, r)
	local core = Color3.new(1, 1, 1):Lerp(main, 0.35)
	local painted = {}
	for _, t in fx.Tongues do
		painted[t.GroupIndex] = painted[t.GroupIndex] or t.Group.Paint(core, main, edge)
		t.Beam.Color = painted[t.GroupIndex]
	end
	local swoosh = colours({ { 0, edge }, { 1, core } })
	for _, w in fx.Swooshes do
		w.Beam.Color = swoosh
	end
	local ringColor = main:Lerp(Color3.new(1, 1, 1), 0.25)
	for _, p in fx.Ring do
		p.Color = ringColor
	end
	for _, p in fx.RipplePieces do
		p.Color = main
	end
	fx.Streaks.Color = ColorSequence.new(core, main)
	fx.Sparks.Color = ColorSequence.new(core)
	fx.Haze.Color = ColorSequence.new(main)
	fx.Light.Color = main
	fx.Core, fx.Main, fx.Edge = core, main, edge
	fx.PaintedGold, fx.PaintedRed = g, r
end

----------------------------------------------------------------------------------------
-- the transformation explosion
----------------------------------------------------------------------------------------
local function playBurst(fx, root: BasePart, groundY: number)
	fx.Streaks:Emit(70)
	fx.Sparks:Emit(90)
	fx.Dust:Emit(60)
	fx.Light.Brightness = 16
	fx.Flare = 1.7 -- the flames shoot up extra high for a moment
	fx.Shudder = 1
	local color = PowerConfig.SSJAuraColor

	-- a pillar of light shooting into the sky
	local pillar = fxPart("Pillar", Vector3.new(1, 1, 1))
	pillar.CFrame = CFrame.new(root.Position.X, groundY, root.Position.Z)
	local bottom = Instance.new("Attachment")
	bottom.CFrame = UP_FRAME
	bottom.Parent = pillar
	local top = Instance.new("Attachment")
	top.CFrame = CFrame.new(0, 70 * S, 0) * UP_FRAME
	top.Parent = pillar
	local beam = Instance.new("Beam")
	beam.Attachment0 = bottom
	beam.Attachment1 = top
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Width0 = 0
	beam.Width1 = 0
	beam.Color = ColorSequence.new(Color3.new(1, 1, 0.9), color)
	beam.Transparency = seq({ { 0, 0.15 }, { 0.6, 0.45 }, { 1, 1 } })
	beam.Parent = pillar
	fx.Pillar = pillar
	TweenService:Create(beam, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Width0 = 11 * S,
		Width1 = 4 * S,
	}):Play()
	task.delay(0.18, function()
		TweenService:Create(beam, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Width0 = 0, Width1 = 0 }):Play()
	end)

	local ring = fxPart("Shockwave", Vector3.new(0.3, 2, 2))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.15
	ring.CFrame = CFrame.new(root.Position.X, groundY + 0.15, root.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
	TweenService:Create(ring, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, 40 * S, 40 * S),
		Transparency = 1,
	}):Play()
	local ball = fxPart("Flash", Vector3.new(2, 2, 2))
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.new(1, 1, 0.9)
	ball.Transparency = 0.1
	ball.CFrame = root.CFrame
	TweenService:Create(ball, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(18, 18, 18) * S,
		Transparency = 1,
	}):Play()
	task.delay(1.4, function()
		ring:Destroy()
		ball:Destroy()
		pillar:Destroy()
		if fx.Pillar == pillar then
			fx.Pillar = nil
		end
	end)
end

-- each time the Kaioken is lit or pushed higher: a red shockwave along the ground and a flash
local function playFlare(fx, root: BasePart, groundY: number)
	fx.Sparks:Emit(40)
	fx.Streaks:Emit(25)
	fx.Light.Brightness = 10
	fx.Flare = math.max(fx.Flare, 1.35)
	fx.Shudder = math.max(fx.Shudder, 0.6)
	local color = PowerConfig.KaiokenAuraColor
	local ring = fxPart("KaiokenWave", Vector3.new(0.25, 2, 2))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.CFrame = CFrame.new(root.Position.X, groundY + 0.15, root.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.25, 22 * S, 22 * S),
		Transparency = 1,
	}):Play()
	local ball = fxPart("KaiokenFlash", Vector3.new(2, 2, 2))
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.Neon
	ball.Color = color:Lerp(Color3.new(1, 1, 1), 0.4)
	ball.Transparency = 0.25
	ball.CFrame = root.CFrame
	TweenService:Create(ball, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(10, 10, 10) * S,
		Transparency = 1,
	}):Play()
	task.delay(0.6, function()
		ring:Destroy()
		ball:Destroy()
	end)
end

----------------------------------------------------------------------------------------
-- every frame
----------------------------------------------------------------------------------------
local active = {} -- [character] = fx
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

local function targetIntensity(character: Model, fx): number
	local state = character:GetAttribute("PowerState")
	if state == "Charging" then
		local c = character:GetAttribute("Charge") or 0
		return c >= PowerConfig.AuraStart and math.max(c, 0.12) or 0
	elseif state == "Bursting" then
		return (fx and fx.Exploded) and 1.25 or 1 -- the power builds, then explodes out
	end
	local kaioken = character:GetAttribute("Kaioken") or 0
	if kaioken > 0 then
		return PowerConfig.KaiokenAura[kaioken] or 0.7
	elseif character:GetAttribute("Form") == "SSJ" then
		-- the golden aura stays up after transforming and fades when you calm down
		return PowerConfig.SSJIdleAura * (character:GetAttribute("Breeze") or 1)
	end
	return 0
end

local function characters()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	return list
end

-- moves the flames, ring, streaks and swirls of one character's aura
local function updateAura(fx, i: number, dt: number, camDir: Vector3?)
	-- glow, light and particles change smoothly every frame
	local visible = i > 0.02
	local k = math.min(i, 1.4)
	fx.Streaks.Rate = i > 0.3 and 70 * (i - 0.3) or 0
	fx.Sparks.Rate = visible and (6 + 34 * i) or 0
	fx.Haze.Rate = visible and (6 + 18 * i) or 0
	fx.Haze.Size = NumberSequence.new(5 * S * (0.7 + 0.5 * i))
	fx.Light.Range = visible and (8 + 18 * i) or 0
	fx.Light.Brightness = ease(fx.Light.Brightness, visible and (1 + 5 * i) or 0, 6, dt)
	fx.Spin += dt * (0.25 + 0.35 * k)

	-- the shapes change in steps (AuraFrameRate a second); a low rate flickers like anime
	fx.FrameClock += dt
	if fx.FrameClock < 1 / AURA_FPS then
		return
	end
	local step = math.min(fx.FrameClock, 0.25)
	fx.FrameClock = 0

	local feet = -fx.FootDrop
	local ringRadius = lerp(RING_RADIUS[1], RING_RADIUS[2], math.min(k, 1.2)) * S
	local tallest = lerp(FLAME_HEIGHT[1], FLAME_HEIGHT[2], k) * S * fx.Flare
	local leanMax = lerp(FLAME_LEAN[1], FLAME_LEAN[2], k) * S
	local share = visible and math.clamp(0.35 + 0.75 * i, 0, 1) or 0 -- fewer flames at low power

	for _, t in fx.Tongues do
		local group = t.Group
		local speed = lerp(group.Speed[1], group.Speed[2], math.min(k, 1.2)) * t.SpeedMul
		if t.Index > math.ceil(t.Of * share) then
			if t.Beam.Width0 ~= 0 then
				t.Beam.Width0 = 0
			end
			continue
		end
		-- each drawn frame every flame wobbles a little, as if redrawn by hand
		t.Boil = rng:NextNumber(0.9, 1.1)
		t.BoilAngle = rng:NextNumber(-0.04, 0.04)
		local a = t.Angle + fx.Spin + t.BoilAngle
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local front = camDir and smooth(0.05, 0.6, out:Dot(camDir)) or 0 -- between the camera and you
		local width = lerp(group.Width[1], group.Width[2], math.min(k, 1)) * S * t.WidthMul
		local height, lean, baseY, radius
		if t.Kind == "Lick" then
			-- breaks off near the ground and rises along the fire, shrinking as it goes
			t.Life += step * speed
			if t.Life >= 1 then
				t.Life -= math.floor(t.Life)
				reroll(t)
			end
			local life = t.Life
			height = lerp(group.Height[1], group.Height[2], t.HeightMul) * tallest * (1 - 0.5 * life) * t.Boil
			baseY = feet + 0.15 * S + life * 0.6 * tallest
			lean = leanMax * t.LeanMul * (baseY - feet) / math.max(tallest, 0.1)
			radius = ringRadius + lean
			width *= (1 - life) * smooth(0, 0.15, life)
		else
			-- rooted on the ring; licks up and down
			t.Phase += step * speed
			local lick = 0.8 + 0.2 * math.sin(t.Phase) + 0.08 * math.sin(t.Phase * 2.7 + t.Index)
			height = lerp(group.Height[1], group.Height[2], t.HeightMul) * tallest * lick * t.Boil
			baseY = feet + 0.03 * S
			radius = ringRadius * (t.Kind == "Streak" and 0.9 or 0.97)
			lean = 0
		end
		local tipLean = leanMax * t.LeanMul * height / math.max(tallest, 0.1)
		width *= 1 - 0.85 * front
		local base = out * radius + Vector3.new(0, baseY, 0)
		local tip = out * (radius + tipLean) + Vector3.new(0, baseY + height, 0)
		t.A0.CFrame = CFrame.new(base) * UP_FRAME
		t.A1.CFrame = pointing(tip, (Vector3.yAxis * height + out * (tipLean * 1.3)).Unit)
		t.Beam.Width0 = width
		t.Beam.CurveSize0 = height * 0.4
		t.Beam.CurveSize1 = height * 0.2
	end

	-- the glowing ground ring: flickers, and swells with power
	local ringOn = visible and smooth(0.02, 0.25, i) or 0
	local length = 2 * ringRadius * math.sin(math.pi / #fx.Ring) * 1.15
	for n, p in fx.Ring do
		local a = (n - 1) / #fx.Ring * math.pi * 2 + fx.Spin * 0.3
		local r = ringRadius * (1 + rng:NextNumber(-0.025, 0.025))
		fx.RingLocal[n] = CFrame.new(math.cos(a) * r, feet + 0.04, math.sin(a) * r) * CFrame.Angles(0, -(a + math.pi / 2), 0)
		p.Size = Vector3.new(length, 0.06 * S, (0.14 + 0.12 * k) * S * rng:NextNumber(0.8, 1.25))
		p.Transparency = 1 - ringOn * rng:NextNumber(0.55, 0.9)
	end
	-- ripples pulse out of it along the ground while the power is high
	fx.RipplePhase += step * (0.9 + 0.8 * k)
	if fx.RipplePhase >= 1 then
		fx.RipplePhase -= math.floor(fx.RipplePhase)
	end
	local ripple = fx.RipplePhase
	local rippleOn = visible and smooth(0.3, 0.7, i) or 0
	local rippleRadius = ringRadius * (1 + 0.9 * ripple)
	local rippleLength = 2 * rippleRadius * math.sin(math.pi / #fx.RipplePieces) * 1.15
	for n, p in fx.RipplePieces do
		local a = (n - 1) / #fx.RipplePieces * math.pi * 2
		fx.RippleLocal[n] = CFrame.new(math.cos(a) * rippleRadius, feet + 0.03, math.sin(a) * rippleRadius)
			* CFrame.Angles(0, -(a + math.pi / 2), 0)
		p.Size = Vector3.new(rippleLength, 0.05 * S, 0.1 * S)
		p.Transparency = 1 - rippleOn * 0.6 * (1 - ripple)
	end

	-- energy streaks swirling up around you
	local swirl = smooth(0.3, 0.75, i)
	for _, w in fx.Swooshes do
		w.Angle += step * w.Spin * (0.6 + i)
		w.Y += step * w.Rise * (0.6 + i)
		if w.Y > w.Top then
			resetSwoosh(w, feet, false)
		end
		local arc = 1.3 * (w.Spin > 0 and 1 or -1)
		local a, b = w.Angle, w.Angle + arc
		local p0 = Vector3.new(math.cos(a) * w.R, w.Y, math.sin(a) * w.R)
		local p1 = Vector3.new(math.cos(b) * w.R, w.Y + 1.2 * S, math.sin(b) * w.R)
		local dirSign = w.Spin > 0 and 1 or -1
		w.A0.CFrame = pointing(p0, Vector3.new(-math.sin(a) * dirSign, 0.25, math.cos(a) * dirSign).Unit)
		w.A1.CFrame = pointing(p1, Vector3.new(-math.sin(b) * dirSign, 0.25, math.cos(b) * dirSign).Unit)
		local curve = w.R * math.abs(arc) / 3
		w.Beam.CurveSize0 = curve
		w.Beam.CurveSize1 = curve
		local life = smooth(feet, feet + 1.5 * S, w.Y) * (1 - smooth(w.Top - 2 * S, w.Top, w.Y))
		w.Beam.Width0 = 0.04 * S * swirl * life
		w.Beam.Width1 = 0.4 * S * swirl * life
	end
end

local moveParts, moveFrames = {}, {}

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	table.clear(moveParts)
	table.clear(moveFrames)
	local seen = {}
	local finished = {}
	local filter = characters()
	table.insert(filter, folder)
	groundParams.FilterDescendantsInstances = filter
	local now = os.clock()
	local camera = Workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position

	for _, character in characters() do
		seen[character] = true
		local root = character:FindFirstChild("HumanoidRootPart")
		local state = character:GetAttribute("PowerState")
		local fx = active[character]
		local want = targetIntensity(character, fx)
		if not fx and (want > 0 or state == "Charging" or character:GetAttribute("Exhausted")) and root then
			fx = newFX(character, root)
			active[character] = fx
		end
		if fx and root then
			-- the transformation: the power builds for ExplodeAt seconds, then explodes out
			if state == "Bursting" then
				fx.BurstAt = fx.BurstAt or now
				if not fx.Exploded and now - fx.BurstAt >= EXPLODE_AT then
					fx.Exploded = true
					local hit = Workspace:Raycast(root.Position, Vector3.new(0, -12, 0), groundParams)
					playBurst(fx, root, hit and hit.Position.Y or root.Position.Y - fx.FootDrop)
				end
			else
				fx.BurstAt, fx.Exploded = nil, false
			end
			want = targetIntensity(character, fx)

			-- smooth ramps: fast up, slower down
			fx.Intensity = ease(fx.Intensity, want, want > fx.Intensity and 5 or 1.5, dt)
			local i = fx.Intensity
			fx.Flare = ease(fx.Flare, 1, 2.5, dt)
			local gold = (character:GetAttribute("Form") == "SSJ" or state == "Bursting") and 1 or 0
			fx.Gold = ease(fx.Gold, gold, 6, dt)
			local kaioken = character:GetAttribute("Kaioken") or 0
			-- red while the Kaioken burns, and while its aura dies away after; another aura
			-- (charging, Super Saiyan) takes the colour back
			if kaioken > 0 then
				fx.Red = ease(fx.Red, 1, 8, dt)
			elseif state == "Charging" or state == "Bursting" or gold > 0 then
				fx.Red = ease(fx.Red, 0, 6, dt)
			end
			fx.GlowW = ease(fx.GlowW, kaioken > 0 and 1 or 0, kaioken > 0 and 8 or 3, dt)
			if math.abs(fx.Gold - fx.PaintedGold) > 0.01 or math.abs(fx.Red - fx.PaintedRed) > 0.01 then
				paint(fx)
			end
			-- the Kaioken's red glow over the whole body, throbbing like a heartbeat
			if fx.GlowW > 0.01 then
				if not fx.Glow then
					local glow = Instance.new("Highlight")
					glow.Name = "KaiokenGlow"
					glow.DepthMode = Enum.HighlightDepthMode.Occluded
					glow.FillColor = PowerConfig.KaiokenGlow
					glow.OutlineColor = PowerConfig.KaiokenGlow:Lerp(Color3.new(1, 1, 1), 0.35)
					glow.Adornee = character
					glow.Parent = folder
					fx.Glow = glow
				end
				local beat = 0.5 + 0.5 * math.sin(now * (6 + kaioken))
				fx.Glow.FillTransparency = 1 - fx.GlowW * (0.28 + 0.1 * beat + 0.03 * kaioken)
				fx.Glow.OutlineTransparency = 1 - fx.GlowW * (0.55 + 0.3 * beat)
				fx.Glow.Enabled = true
			elseif fx.Glow then
				fx.Glow.Enabled = false
			end

			-- the aura follows the character, kept upright
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			local auraCF = flat.Magnitude > 1e-3 and CFrame.lookAt(root.Position, root.Position + flat) or CFrame.new(root.Position)
			local camDir = nil
			if camPos then
				local rel = auraCF:PointToObjectSpace(camPos)
				local h = Vector3.new(rel.X, 0, rel.Z)
				if h.Magnitude > 0.5 and rel.Magnitude < 80 then
					camDir = h.Unit
				end
			end
			updateAura(fx, i, dt, camDir)
			table.insert(moveParts, fx.Aura)
			table.insert(moveFrames, auraCF)
			for n, p in fx.Ring do
				table.insert(moveParts, p)
				table.insert(moveFrames, auraCF * fx.RingLocal[n])
			end
			for n, p in fx.RipplePieces do
				table.insert(moveParts, p)
				table.insert(moveFrames, auraCF * fx.RippleLocal[n])
			end

			-- ground: dust and lifting rocks (only if there's ground close below)
			local hit = Workspace:Raycast(root.Position, Vector3.new(0, -(fx.FootDrop + 5), 0), groundParams)
			local groundY = hit and hit.Position.Y
			if groundY then
				table.insert(moveParts, fx.Ground)
				table.insert(moveFrames, CFrame.new(root.Position.X, groundY + 0.2, root.Position.Z))
			end
			fx.Dust.Rate = (groundY and i > 0.55) and 40 * (i - 0.55) / 0.45 or 0

			-- Kaioken: a shockwave and a flex each time it's lit or pushed higher
			local kaiokenLevel = character:GetAttribute("Kaioken") or 0
			if kaiokenLevel > fx.KaiokenSeen then
				fx.FlexAt = now
				playFlare(fx, root, groundY or (root.Position.Y - fx.FootDrop))
			end
			fx.KaiokenSeen = kaiokenLevel
			fx.FlexW = fx.FlexAt and flexWeight(now - fx.FlexAt) or 0
			fx.Slump = ease(fx.Slump, character:GetAttribute("Exhausted") and 1 or 0, 4, dt)
			for _, rock in fx.Rocks do
				local lift = (groundY and i > 0.7) and rock.Top * math.clamp((i - 0.7) / 0.3, 0, 1) or 0
				if lift > rock.Height then
					rock.Height += (lift - rock.Height) * (1 - math.exp(-dt * 1.5))
				else
					rock.Height = math.max(lift, rock.Height - dt * 6) -- falls back down
				end
				if rock.Height > 0.02 and groundY then
					rock.Part.Transparency = 0
					rock.Angle += dt * 0.25
					local pos = root.Position + Vector3.new(math.cos(rock.Angle), 0, math.sin(rock.Angle)) * rock.Radius
					local bob = math.sin(now * 2 + rock.Bob) * 0.15 * math.min(1, rock.Height)
					table.insert(moveParts, rock.Part)
					table.insert(moveFrames, CFrame.new(pos.X, groundY + rock.Part.Size.Y / 2 + rock.Height + bob, pos.Z)
						* CFrame.Angles(now * rock.Spin, now * rock.Spin * 0.7, 0))
				else
					rock.Part.Transparency = 1
				end
			end

			-- the animation: how far into each key pose we are
			local posing = state == "Charging" or state == "Bursting"
			fx.Pose = ease(fx.Pose, posing and 1 or 0, posing and 6 or 3.5, dt)
			if state == "Charging" then
				local charge = character:GetAttribute("Charge") or 0
				fx.Strain = ease(fx.Strain, smooth(0.2, 0.85, charge), 3, dt)
				fx.Release = ease(fx.Release, 0, 10, dt)
			elseif state == "Bursting" then
				if fx.Exploded then
					fx.Release = ease(fx.Release, 1, 14, dt) -- snaps into the release pose and holds it
				else
					fx.Strain = ease(fx.Strain, 1, 4, dt) -- hunched, straining, as the power builds
				end
				-- then the "YOU'RE FINISHED!" point
				local pointAt = PowerConfig.PointAt
				if pointAt and now - fx.BurstAt >= pointAt then
					fx.PointMix = 1
					fx.PointT = now - fx.BurstAt - pointAt
				end
			end
			if state ~= "Bursting" and fx.Pose < 0.01 then
				fx.PointMix = 0 -- (held while the pose fades out after the transformation)
			end
			fx.Shudder = math.max(fx.Shudder - dt * 0.8, 0)
			local building = (state == "Bursting" and not fx.Exploded) and 0.5 or 0
			local pointing = fx.PointMix * (1 - smoother((fx.PointT - POINT_LAND) / 0.3))
			fx.Tremble = (0.035 * fx.Strain * (1 - fx.Release) + 0.03 * fx.Shudder + 0.02 * building) * (1 - pointing)
				+ 0.012 * math.max(0, kaiokenLevel - 3)
				+ 0.025 * fx.FlexW

			-- tidy up once fully calm
			if
				want <= 0
				and fx.Intensity < 0.01
				and fx.Pose < 0.01
				and fx.FlexW < 0.01
				and fx.Slump < 0.01
				and fx.GlowW < 0.01
				and state ~= "Charging"
				and not character:GetAttribute("Exhausted")
			then
				table.insert(finished, fx)
				active[character] = nil
			end
		end
	end
	for character, fx in active do
		if not seen[character] or not character.Parent then
			table.insert(finished, fx)
			active[character] = nil
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	-- removed only after this frame's moves, so nothing moves a part that's already gone
	for _, fx in finished do
		destroyFX(fx)
	end
end)

-- The pose goes on after Roblox has played the character's animations for this frame (in
-- PreSimulation, as Roblox recommends), blended with them by how far into the power-up we are.
local okPre, preSimulation = pcall(function()
	return RunService.PreSimulation
end)
local poseSignal = (okPre and preSimulation) or RunService.Stepped
poseSignal:Connect(function()
	local t = os.clock()
	for _, fx in active do
		-- joints can be swapped out after spawning (e.g. by the joint upgrade): look again if so
		if t >= fx.NextJointScan then
			fx.NextJointScan = t + 1
			local ok = next(fx.Motors) ~= nil
			for _, joint in fx.Motors do
				if not joint.Parent then
					ok = false
				end
			end
			if not ok then
				fx.Motors = findJoints(fx.Character)
				table.clear(fx.LastWritten)
			end
		end
		local w = math.min(fx.Pose, 1)
		local flexW, slumpW = fx.FlexW or 0, fx.Slump or 0
		if w > 0.001 or flexW > 0.001 or slumpW > 0.001 then
			local tremble = fx.Tremble or 0
			for name, motor in fx.Motors do
				if motor.Parent then
					local current = motor.Transform
					-- if the animator didn't touch this joint since our last write, blend from rest
					if fx.LastWritten[name] and sameFrame(current, fx.LastWritten[name]) then
						current = CFrame.identity
					end
					-- layers on top of the walk/idle animation: the power-up (or the point), the
					-- Kaioken flex, the exhausted slump
					local final = current
					if w > 0.001 then
						local pose = READY[name]:Lerp(STRAIN[name], fx.Strain):Lerp(RELEASE[name], fx.Release)
						if fx.PointMix > 0 then
							pose = pose:Lerp(pointPose(name, fx.PointT), fx.PointMix)
						end
						final = final:Lerp(pose, w)
					end
					if flexW > 0.001 then
						final = final:Lerp(KAIOKEN_FLEX[name], flexW)
					end
					if slumpW > 0.001 then
						local slump = SLUMP[name]
						if name == "Waist" or name == "Neck" then -- breathing hard
							slump *= CFrame.Angles(0.06 * math.sin(t * 6.5), 0, 0)
						end
						final = final:Lerp(slump, slumpW)
					end
					local shake = SHAKE[name]
					if shake and tremble > 0 then
						local a = tremble * shake
						final *= CFrame.Angles(math.sin(t * 41 + #name) * a, math.sin(t * 37) * a, math.sin(t * 29 + #name) * a)
					end
					motor.Transform = final
					fx.LastWritten[name] = final
				end
			end
		else
			table.clear(fx.LastWritten)
		end
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SSJCutscene</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SSJCutscene  (ModuleScript — lives in StarterPlayer > StarterPlayerScripts, next to
	PowerUpClient, which plays it)

	The transformation cutscene the transforming player sees:
	  0.0 s   black bars slide in; an extreme close-up pans across your eyes
	  1.0 s   the camera sweeps up over your hair as it turns gold and blows upward
	  2.2 s   (PowerConfig.ExplodeAt) the power explodes: a white flash, the camera slams back to
	          a low angle and pulls away, and manga focus lines frame you
	  2.6 s   the screen turns into a manga page: black and white, inked outlines, screentone
	          dots round the edges ... and a tall manga panel slides DOWN into frame: "THIS IS—"
	  3.25 s  a second panel slides UP into frame: "SUPER SAIYAN!"   (PowerConfig.CutsceneText)
	  4.3 s   (PowerConfig.PointAt) the panels slide away; cut to the front: your arms come in,
	          left fingers on the inside of your right elbow, then you swipe into a point at the
	          camera as it pushes in on you ... and a third panel slams in: "YOU'RE FINISHED!"
	  end     the panel goes, the colour floods back, the bars go and you get control
	The arm, hand and finger movements are PowerFX's and HandFX's; this script moves the camera
	and draws the screen.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local EXPLODE = PowerConfig.ExplodeAt or 2.2
local EYES_END = math.min(1, EXPLODE * 0.45) -- the eye close-up, then the hair until the explosion
local BAR = 0.13 -- height of each black bar (share of the screen)
local FOCUS_LINES = 40
local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local PAPER = Color3.fromRGB(250, 247, 238)

local player = Players.LocalPlayer
local rng = Random.new()

local Cutscene = { Playing = false }

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function easeOut(t: number): number
	t = math.clamp(t, 0, 1)
	return 1 - (1 - t) ^ 3
end

local function easeInOut(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function smooth(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

local function new(className: string, props, parent: Instance?)
	local inst = Instance.new(className)
	for k, v in props do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function tween(inst: Instance, seconds: number, props, style, direction)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function fadeLine(parent: Instance) -- thin at the start, solid at the end
	return new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.35, 0.35),
			NumberSequenceKeypoint.new(1, 0),
		}),
	}, parent)
end

----------------------------------------------------------------------------------------
-- the screen layer (built once, shown only during the cutscene)
----------------------------------------------------------------------------------------
local gui = new("ScreenGui", {
	Name = "SSJCutscene",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 50,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Enabled = false,
}, player:WaitForChild("PlayerGui"))

-- manga focus lines: thin black wedges pointing in at you from the edges of the screen
local lines = new("Frame", {
	Name = "FocusLines",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	ZIndex = 1,
}, gui)

local flash = new("Frame", {
	Name = "Flash",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = WHITE,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ZIndex = 2,
}, gui)

-- the manga filter's screentone: halftone dots, bigger toward the edges of the screen
local tone = new("CanvasGroup", {
	Name = "Screentone",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	GroupTransparency = 1,
	ZIndex = 3,
}, gui)

-- ... and a black panel border round the whole screen, like a page
local page = new("Frame", {
	Name = "PageBorder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(1, -18, 1, -18),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 4,
}, gui)
new("UIStroke", { Color = BLACK, Thickness = 5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, page)

local topBar = new("Frame", {
	Name = "TopBar",
	Size = UDim2.fromScale(1, 0),
	BackgroundColor3 = BLACK,
	BorderSizePixel = 0,
	ZIndex = 5,
}, gui)
local bottomBar = new("Frame", {
	Name = "BottomBar",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.fromScale(0, 1),
	Size = UDim2.fromScale(1, 0),
	BackgroundColor3 = BLACK,
	BorderSizePixel = 0,
	ZIndex = 5,
}, gui)

-- the manga filter's colour: black and white, hard contrast, a touch of paper warmth
local grade = new("ColorCorrectionEffect", { Name = "MangaFilter", Enabled = false }, Lighting)

----------------------------------------------------------------------------------------
-- the manga panels: tall white panels with a double black border and a hard shadow
----------------------------------------------------------------------------------------
local function mangaPanel(name: string, size: UDim2, aspect: number, style: string)
	local holder = new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = size,
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
	}, gui)
	new("UIAspectRatioConstraint", { AspectRatio = aspect }, holder)
	local scale = new("UIScale", { Scale = 1 }, holder)
	new("Frame", {
		Name = "Shadow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 10, 0.5, 10),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, holder)
	local panel = new("Frame", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 11,
	}, holder)
	new("UIStroke", { Color = BLACK, Thickness = 6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, panel)
	local inner = new("Frame", {
		Name = "InnerBorder",
		Position = UDim2.fromOffset(9, 9),
		Size = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		ZIndex = 14,
	}, panel)
	new("UIStroke", { Color = BLACK, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inner)

	if style == "speed" then
		-- horizontal speed lines whooshing across
		for k = 1, 16 do
			local line = new("Frame", {
				Name = "Speed",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.08 + (k - 1) / 15 * 0.84 + rng:NextNumber(-0.02, 0.02)),
				Size = UDim2.new(rng:NextNumber(0.35, 0.95), 0, 0, rng:NextNumber(2, 5)),
				BackgroundColor3 = BLACK,
				BorderSizePixel = 0,
				ZIndex = 12,
			}, panel)
			fadeLine(line)
		end
	else
		-- focus lines bursting out from behind the words
		for k = 1, 28 do
			local a = (k - 1) / 28 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
			local d = rng:NextNumber(0.42, 0.5) -- (in panel widths) from the middle to the line's middle
			local line = new("Frame", {
				Name = "Burst",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5 + math.cos(a) * d, 0.5 + math.sin(a) * d * aspect),
				Size = UDim2.new(0.62, 0, 0, rng:NextNumber(2, 6)),
				Rotation = math.deg(a),
				BackgroundColor3 = BLACK,
				BorderSizePixel = 0,
				ZIndex = 12,
			}, panel)
			fadeLine(line)
		end
	end
	-- screentone fading up from the bottom of the panel
	for row = 0, 6 do
		for col = 0, 9 do
			local size = 2 + row * 1.6
			local dot = new("Frame", {
				Name = "Tone",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((col + 0.5 + (row % 2) * 0.5) / 10, 0, 0.66 + row * 0.052, 0),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = BLACK,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				ZIndex = 12,
			}, panel)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
		end
	end
	local text = new("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.86, 0.62),
		BackgroundTransparency = 1,
		Font = Enum.Font.Bangers,
		TextScaled = true,
		TextColor3 = BLACK,
		Text = "",
		ZIndex = 13,
	}, panel)
	new("UIStroke", { Color = PAPER, Thickness = 4 }, text) -- a paper-white halo so it reads over the lines
	return { Holder = holder, Scale = scale, Text = text }
end

local panel1 = mangaPanel("PanelThisIs", UDim2.fromScale(0.19, 0.66), 0.5, "speed")
local panel2 = mangaPanel("PanelSuperSaiyan", UDim2.fromScale(0.25, 0.7), 0.58, "burst")
local panel3 = mangaPanel("PanelFinished", UDim2.fromScale(0.38, 0.3), 1.7, "burst")
local PANEL1_AT, PANEL1_FROM = UDim2.fromScale(0.21, 0.5), UDim2.fromScale(0.21, -0.6) -- slides down
local PANEL2_AT, PANEL2_FROM = UDim2.fromScale(0.77, 0.5), UDim2.fromScale(0.77, 1.6) -- slides up
local PANEL3_AT, PANEL3_OUT = UDim2.fromScale(0.29, 0.65), UDim2.fromScale(0.29, 1.6) -- slams in
local POINT_AT = PowerConfig.PointAt
local POINT_LAND = 0.81 -- seconds after PointAt: the point lands (PowerFX's swipe)

-- "SUPER SAIYAN!" -> "SUPER\nSAIYAN!": one word per line fills a tall panel
local function stacked(text: string): string
	return (text:gsub("%s+", "\n"))
end

local function slideIn(panel, from: UDim2, at: UDim2, text: string)
	panel.Text.Text = stacked(text)
	panel.Holder.Visible = true
	panel.Holder.Position = from
	panel.Scale.Scale = 1
	tween(panel.Holder, 0.42, { Position = at }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.delay(0.4, function()
		-- a little punch when it lands
		panel.Scale.Scale = 1.08
		tween(panel.Scale, 0.2, { Scale = 1 })
	end)
end

local function slideOut(panel, to: UDim2)
	tween(panel.Holder, 0.38, { Position = to }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
end

-- the third panel doesn't slide: it slams down onto the page, like a stamp
local function slamIn(panel, at: UDim2, text: string)
	panel.Text.Text = stacked(text)
	panel.Holder.Visible = true
	panel.Holder.Position = at
	panel.Scale.Scale = 1.8
	tween(panel.Scale, 0.14, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.14, function()
		tween(panel.Scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
end

----------------------------------------------------------------------------------------
-- building the effects that depend on the screen size
----------------------------------------------------------------------------------------
local function screenSize(): Vector2
	local okSize, size = pcall(function()
		return gui.AbsoluteSize
	end)
	if not okSize or not size or size.X < 10 then
		local camera = Workspace.CurrentCamera
		size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	end
	return size
end

local function buildFocusLines(size: Vector2)
	lines:ClearAllChildren()
	local centre = size / 2
	local inner = math.min(size.X, size.Y) * 0.36
	local outer = size.Magnitude * 0.6
	for k = 1, FOCUS_LINES do
		local a = (k - 1) / FOCUS_LINES * math.pi * 2 + rng:NextNumber(-0.06, 0.06)
		local r0 = inner * rng:NextNumber(0.9, 1.3)
		local length = outer - r0
		local mid = centre + Vector2.new(math.cos(a), math.sin(a)) * (r0 + length / 2)
		local line = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(mid.X, mid.Y),
			Size = UDim2.fromOffset(length, rng:NextNumber(2, 7)),
			Rotation = math.deg(a),
			BackgroundColor3 = BLACK,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, lines)
		fadeLine(line)
	end
end

local toneBuiltFor = Vector2.zero
local function buildScreentone(size: Vector2)
	if (size - toneBuiltFor).Magnitude < 1 then
		return -- already made for this screen size
	end
	toneBuiltFor = size
	tone:ClearAllChildren()
	-- a halftone grid (every other row shifted half a step, like printed screentone); each dot
	-- grows with its distance from the middle of the screen, so the tone darkens to the edges
	local step = math.clamp(size.Y * 0.03, 14, 24)
	local centre = size / 2
	local row = 0
	for y = step / 2, size.Y, step * 0.87 do
		local shift = (row % 2) * step / 2
		row += 1
		for x = step / 2 + shift, size.X, step do
			local dx = (x - centre.X) / centre.X
			local dy = (y - centre.Y) / centre.Y
			local r = math.sqrt(dx * dx + dy * dy)
			local d = step * 0.95 * smooth(0.6, 1.3, r)
			if d >= 2 then
				local dot = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x, y),
					Size = UDim2.fromOffset(d, d),
					BackgroundColor3 = BLACK,
					BackgroundTransparency = 0.12,
					BorderSizePixel = 0,
				}, tone)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
			end
		end
	end
end

local function setLines(transparency: number)
	for _, line in lines:GetChildren() do
		if line:IsA("Frame") then
			line.BackgroundTransparency = transparency
		end
	end
end

----------------------------------------------------------------------------------------
-- the manga filter: turns the screen into a manga page, then fades it back
----------------------------------------------------------------------------------------
local ink: Highlight? = nil

local function mangaOn(character: Model)
	grade.Enabled = true
	grade.Saturation, grade.Contrast, grade.Brightness, grade.TintColor = 0, 0, 0, WHITE
	tween(grade, 0.25, { Saturation = -1, Contrast = 0.65, Brightness = 0.04, TintColor = PAPER })
	tween(tone, 0.25, { GroupTransparency = 0 })
	page.Visible = true
	-- inked outline round your character
	if ink then
		ink:Destroy()
	end
	local okInk, made = pcall(function() -- (Roblox only draws so many highlights at once)
		return new("Highlight", {
			Name = "MangaInk",
			DepthMode = Enum.HighlightDepthMode.Occluded,
			OutlineColor = BLACK,
			OutlineTransparency = 1,
			FillColor = WHITE,
			FillTransparency = 1,
			Adornee = character,
		}, character)
	end)
	ink = okInk and made or nil
	if ink then
		tween(ink, 0.25, { OutlineTransparency = 0, FillTransparency = 0.78 })
	end
end

local function mangaOff(seconds: number)
	tween(grade, seconds, { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = WHITE })
	tween(tone, seconds, { GroupTransparency = 1 })
	page.Visible = false
	if ink then
		tween(ink, seconds, { OutlineTransparency = 1, FillTransparency = 1 })
	end
end

local function mangaClear()
	grade.Enabled = false
	tone.GroupTransparency = 1
	page.Visible = false
	if ink then
		ink:Destroy()
		ink = nil
	end
end

----------------------------------------------------------------------------------------
-- the camera shots (all measured from your head / body as they move)
----------------------------------------------------------------------------------------
local function eyesShot(head: BasePart, u: number): (CFrame, number)
	local h = head.CFrame
	local e = easeInOut(u)
	local eye = h * Vector3.new(lerp(0.32, -0.32, e), 0.12, -1.45)
	local look = h * Vector3.new(lerp(0.12, -0.12, e), 0.1, 0)
	return CFrame.lookAt(eye, look, h.UpVector), lerp(24, 17, e)
end

local function hairShot(head: BasePart, u: number): (CFrame, number)
	local h = head.CFrame
	local e = easeInOut(u)
	local eye = h * Vector3.new(lerp(0.55, 0.2, e), lerp(0.25, 1.9, e), lerp(-2.1, -2.9, e))
	local look = h * Vector3.new(0, lerp(0.5, 2.2, e), 0)
	return CFrame.lookAt(eye, look, h.UpVector), lerp(42, 50, e)
end

local function pullShot(root: BasePart, u: number): (CFrame, number)
	local r = root.CFrame
	local e = easeOut(u * 1.6)
	local eye = r * Vector3.new(lerp(0.8, 2.6, e), lerp(-1.6, 0.3, e), lerp(-4.5, -13, e))
	local look = r * Vector3.new(0, lerp(1.9, 1.3, e), 0)
	return CFrame.lookAt(eye, look), lerp(80, 62, e)
end

-- the point: in front of you, a little to your left; it pushes in as your arm swipes out at the
-- lens (u = seconds since the point began)
local function pointShot(root: BasePart, u: number): (CFrame, number)
	local r = root.CFrame
	local e = easeInOut(math.clamp((u - 0.57) / 0.3, 0, 1))
	local eye = r * Vector3.new(lerp(-1.8, -1.1, e), lerp(0.9, 0.5, e), lerp(-8.4, -5.2, e))
	local look = r * Vector3.new(lerp(-0.4, -0.55, e), 1.1, lerp(-0.6, -1, e))
	return CFrame.lookAt(eye, look), lerp(46, 54, e)
end

----------------------------------------------------------------------------------------
-- playing it
----------------------------------------------------------------------------------------
local stopCurrent: (() -> ())? = nil

-- Plays the cutscene on character for duration seconds. onDone runs when it ends.
function Cutscene.Play(character: Model, duration: number, onDone: (() -> ())?)
	if stopCurrent then
		stopCurrent()
	end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	if not (head and root and camera) then
		if onDone then
			onDone()
		end
		return
	end
	local texts = PowerConfig.CutsceneText or { "THIS IS—", "SUPER SAIYAN!" }
	Cutscene.Playing = true
	player:SetAttribute("InCutscene", true)
	-- hide the phone's thumbstick and jump button for the cinematic
	local okModal, wasModal = pcall(function()
		return UserInputService.ModalEnabled
	end)
	pcall(function()
		UserInputService.ModalEnabled = true
	end)
	gui.Enabled = true
	local size = screenSize()
	buildFocusLines(size)
	buildScreentone(size) -- (made while the bars close in, hidden until the manga moment)
	setLines(1)
	mangaClear()
	flash.BackgroundTransparency = 1
	panel1.Holder.Visible = false
	panel2.Holder.Visible = false
	panel3.Holder.Visible = false
	-- the point needs room: PointAt, the swipe and a beat to hold it before the end
	local pointAt = (POINT_AT and duration >= POINT_AT + POINT_LAND + 0.6) and POINT_AT or nil
	topBar.Size = UDim2.fromScale(1, 0)
	bottomBar.Size = UDim2.fromScale(1, 0)
	tween(topBar, 0.3, { Size = UDim2.fromScale(1, BAR) })
	tween(bottomBar, 0.3, { Size = UDim2.fromScale(1, BAR) })

	local start = os.clock()
	local fired = {}
	local function once(key: string, at: number, t: number, fn: () -> ())
		if not fired[key] and t >= at then
			fired[key] = true
			fn()
		end
	end
	local shake = 0
	local finished = false
	local function stop()
		if finished then
			return
		end
		finished = true
		stopCurrent = nil
		RunService:UnbindFromRenderStep("DWCutsceneCamera")
		gui.Enabled = false
		mangaClear()
		Cutscene.Playing = false
		player:SetAttribute("InCutscene", false)
		pcall(function()
			UserInputService.ModalEnabled = okModal and wasModal or false
		end)
		if onDone then
			onDone()
		end
	end
	stopCurrent = stop

	RunService:BindToRenderStep("DWCutsceneCamera", Enum.RenderPriority.Camera.Value + 2, function()
		local t = os.clock() - start
		if t >= duration or not character.Parent or not head.Parent then
			stop()
			return
		end
		once("explode", EXPLODE, t, function()
			flash.BackgroundTransparency = 0
			tween(flash, 0.7, { BackgroundTransparency = 1 })
			shake = 0.6
			setLines(0.1)
		end)
		once("panel1", EXPLODE + 0.4, t, function()
			mangaOn(character)
			slideIn(panel1, PANEL1_FROM, PANEL1_AT, texts[1] or "")
		end)
		once("panel2", EXPLODE + 1.05, t, function()
			slideIn(panel2, PANEL2_FROM, PANEL2_AT, texts[2] or "")
			shake = math.max(shake, 0.25)
		end)
		if pointAt then
			once("panels away", pointAt - 0.2, t, function()
				slideOut(panel1, PANEL1_FROM)
				slideOut(panel2, PANEL2_FROM)
				setLines(1)
			end)
			once("finished", pointAt + POINT_LAND, t, function()
				slamIn(panel3, PANEL3_AT, texts[3] or "YOU'RE FINISHED!")
				flash.BackgroundTransparency = 0.55
				tween(flash, 0.3, { BackgroundTransparency = 1 })
				setLines(0.15)
				shake = math.max(shake, 0.35)
			end)
		end
		once("leave", duration - 0.5, t, function()
			slideOut(panel1, PANEL1_FROM) -- back up
			slideOut(panel2, PANEL2_FROM) -- back down
			if panel3.Holder.Visible then
				slideOut(panel3, PANEL3_OUT)
			end
			mangaOff(0.45) -- the colour comes back as the panels go
			tween(topBar, 0.4, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(bottomBar, 0.4, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			setLines(1)
		end)

		local cf, fov
		if t < EYES_END then
			cf, fov = eyesShot(head, t / EYES_END)
			shake = 0.008
		elseif t < EXPLODE then
			cf, fov = hairShot(head, (t - EYES_END) / (EXPLODE - EYES_END))
			shake = 0.02
		elseif pointAt and t >= pointAt then
			cf, fov = pointShot(root, t - pointAt)
		else
			cf, fov = pullShot(root, (t - EXPLODE) / math.max((pointAt or duration) - EXPLODE, 0.1))
		end
		local jolt = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * shake
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = cf + jolt
		camera.FieldOfView = fov
		if t >= EXPLODE then
			shake = math.max(shake * 0.9, 0.03)
		end
	end)
end

function Cutscene.Stop()
	if stopCurrent then
		stopCurrent()
	end
end

return Cutscene
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="15">
        <Properties>
          <string name="Name">HUD</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HUD  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Your screen, dressed like the Dragon Ball fighting games (the look itself lives in
	ReplicatedStorage > DragonUI: slanted slabs, ink / paper / gi orange, comic lettering):
	  top left   your face on a slanted gi-orange card: a live 3D portrait whose head pops out
	             over the top, a blue energy arc and a gi badge (気 "ki", or 超 "super" as a Super
	             Saiyan). Beside it, on a dark panel that fades out in halftone dots: your name,
	             your form, a yellow HP bar (a red chunk shows damage you just took) and your Ki
	             in five slanted pips, with a Dragon Ball whose stars count the full ones
	  under it   a Scouter readout of your POWER LEVEL: it scrambles and counts up as you power
	             up ... and warns you when it's over 9000
	  Kaioken    everything turns red: the card, the pips, the arc, a 拳 ("fist") badge and a
	             "KAIOKEN x3" tag; the HP bar's outline throbs as the strain eats your health,
	             and the Scouter multiplies your power level
	  top right  a Dragon Radar: a sweeping green screen with a blip for every player nearby
	             (up on the radar = the way your camera faces)
	It slides in when you spawn and again when the transformation cutscene ends, shakes when you
	get hit, shrinks to fit phones, and hides during the cutscene.
	Numbers: ReplicatedStorage > PowerConfig (KiMax, BasePowerLevel, SSJMultiplier, RadarRange).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))
local DragonUI = require(ReplicatedStorage:WaitForChild("DragonUI"))

local new, Slab = DragonUI.new, DragonUI.Slab
local INK, PAPER, GI, GOLD = DragonUI.INK, DragonUI.PAPER, DragonUI.GI, DragonUI.GOLD
local K = DragonUI.SLANT

local player = Players.LocalPlayer
local rng = Random.new()

local KI_PIPS = 5
local BLIPS = 12
local RADAR_SCREEN = 124 -- pixels across the radar's green screen
local PLATE_X, PLATE_Y = 12, 4
local HEADROOM = 30 -- room above the plate for your head to pop out of the portrait card
local RADAR_MARGIN = 16
-- the portrait camera, from your head (head space: -Z is the way your face looks)
local PORTRAIT_FOV = 30
local PORTRAIT_EYE = Vector3.new(0.9, 0.3, -5.2)
local PORTRAIT_LOOK = Vector3.new(0, 0.35, 0) -- above your head's middle, so your hair fits

-- our own HP bar replaces Roblox's
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local function commas(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

local function label(parent: Instance, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		TextColor3 = PAPER,
		TextScaled = true,
		Font = Enum.Font.Bangers,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function inkStroke(parent: Instance, thickness: number)
	return new("UIStroke", { Color = INK, Thickness = thickness }, parent)
end

local function circle(parent: Instance, props)
	local f = new("Frame", props, parent)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
	return f
end

-- the guide every row of the plate starts on: a slanted line, so the rows step out like the
-- slabs themselves (x where a row whose bottom is at y should start)
local function guideX(y: number): number
	return 140 + (70 - y) * K
end

----------------------------------------------------------------------------------------
-- the screen
----------------------------------------------------------------------------------------
local gui = new("ScreenGui", {
	Name = "DragonHUD",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5,
}, player:WaitForChild("PlayerGui"))

-- top left: the fighter plate (everything inside shrinks together on small screens)
local plate = new("Frame", {
	Name = "Plate",
	Position = UDim2.fromOffset(PLATE_X, PLATE_Y),
	Size = UDim2.fromOffset(500, 160),
	BackgroundTransparency = 1,
}, gui)
local plateScale = new("UIScale", {}, plate)

-- the dark panel behind your name and bars, fading out to the right in halftone dots
Slab.new(plate, "Panel", 92, 10, 356, 88, INK, { Transparency = 0.15, ZIndex = 1 })
DragonUI.Halftone(plate, "Dots", 406, 10, 7, 11, 8, 7.5, INK, { Transparency = 0.15, Lean = K, ZIndex = 1 })

-- the portrait card, its hard shadow and a two-tone shade
Slab.new(plate, "CardShadow", 7, 25, 134, 90, INK, { ZIndex = 3 })
local card = Slab.new(plate, "Card", 0, 18, 134, 90, GI, { ZIndex = 4 })
local cardShade = card:Band("Shade", 58, 90, DragonUI.GI_DARK)

-- the energy arc swooping round the bottom of the card: three rings inside each other (an ink
-- edge so it shows on a bright sky, the ki colour, a white-hot core); only their lower-left part
-- shows
local function ring(parent: Instance, name: string, grow: number, color: Color3, thickness: number)
	local r = circle(parent, {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, grow, 1, grow),
		BackgroundTransparency = 1,
		ZIndex = 5,
	})
	local stroke = new("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, r)
	new("UIGradient", {
		Rotation = 125,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(0.85, 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
	}, stroke)
	return r, stroke
end
local arcHolder = new("Frame", {
	Name = "Arc",
	Position = UDim2.fromOffset(-7, -3),
	Size = UDim2.fromOffset(138, 138),
	BackgroundTransparency = 1,
	ZIndex = 5,
}, plate)
local arcInk = ring(arcHolder, "Edge", 0, INK, 9)
local arcKi, arcStroke = ring(arcInk, "Ki", 2, DragonUI.KI, 7)
ring(arcKi, "Core", 5, Color3.new(1, 1, 1), 1.5)

-- your live 3D portrait: no background, and taller than the card, so your head pops out
local portrait = new("ViewportFrame", {
	Name = "Portrait",
	Position = UDim2.fromOffset(12, -30),
	Size = UDim2.fromOffset(110, 138), -- its bottom edge is the card's
	BackgroundTransparency = 1,
	Ambient = Color3.fromRGB(175, 165, 150),
	LightColor = Color3.fromRGB(255, 245, 225),
	LightDirection = Vector3.new(-0.5, -1, -0.7),
	ZIndex = 6,
}, plate)

-- the gi badge: a kanji in a white circle, like the one on Goku's gi
local badge = circle(plate, {
	Name = "Badge",
	Position = UDim2.fromOffset(78, 80),
	Size = UDim2.fromOffset(42, 42),
