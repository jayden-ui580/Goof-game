end

-- Ki: five slanted pips, and a Dragon Ball whose stars count the full ones
local PIP_Y, PIP_W, PIP_H, PIP_GAP = 78, 46, 12, 5
local pips = {}
for k = 1, KI_PIPS do
	local x = guideX(PIP_Y + PIP_H) + (k - 1) * (PIP_W + PIP_GAP)
	local edge = Slab.around(plate, "KiEdge" .. k, x, PIP_Y, PIP_W, PIP_H, 2, PAPER, { ZIndex = 7 })
	edge.Holder.Visible = false
	local back = Slab.new(plate, "Ki" .. k, x, PIP_Y, PIP_W, PIP_H, DragonUI.INK_SOFT, { ZIndex = 8 })
	local fill = Slab.new(back.Holder, "Fill", 0, 0, PIP_W, PIP_H, DragonUI.KI, { ZIndex = 9 })
	fill:Band("Shine", 2, 4, PAPER, { Transparency = 0.3, ZIndex = 10 })
	pips[k] = { Edge = edge, Back = back, Fill = fill, Full = false, PopAt = -1 }
end
local kiBall = DragonUI.Orb(plate, "KiBall", guideX(PIP_Y + PIP_H) + KI_PIPS * (PIP_W + PIP_GAP) + 2, PIP_Y - 14, 38, 9)

-- the Scouter: a dark green readout with scan lines
local SC_Y, SC_W, SC_H = 106, 226, 50
local SC_X = guideX(SC_Y + SC_H)
local scouter = new("Frame", {
	Name = "Scouter",
	Position = UDim2.fromOffset(SC_X, SC_Y),
	Size = UDim2.fromOffset(SC_W, SC_H),
	BackgroundTransparency = 1,
	ZIndex = 8,
}, plate)
Slab.around(scouter, "Edge", 0, 0, SC_W, SC_H, 3, INK, { ZIndex = 8 })
local glass = Slab.new(scouter, "Glass", 0, 0, SC_W, SC_H, Color3.fromRGB(22, 80, 46), { ZIndex = 9 })
for a = 4, SC_H - 2, 5 do
	glass:Band("Scan", a, a + 1, Color3.fromRGB(150, 255, 180), { Transparency = 0.86, ZIndex = 10 })
end
glass:Band("Glare", 0, 9, Color3.new(1, 1, 1), { Transparency = 0.88, ZIndex = 10 })
label(scouter, {
	Name = "Title",
	Position = UDim2.fromOffset(SC_H * K + 4, 4),
	Size = UDim2.fromOffset(110, 11),
	Font = Enum.Font.Code,
	Text = "POWER LEVEL",
	TextColor3 = Color3.fromRGB(170, 255, 190),
	ZIndex = 11,
})
local powerValue = label(scouter, {
	Name = "Value",
	Position = UDim2.fromOffset(SC_H * K - 2, 15),
	Size = UDim2.fromOffset(SC_W - SC_H * K - 14, 32),
	Font = Enum.Font.Sarpanch,
	Text = commas(PowerConfig.BasePowerLevel),
	TextColor3 = Color3.fromRGB(120, 255, 150),
	ZIndex = 11,
})
new("UIStroke", { Color = Color3.fromRGB(0, 60, 20), Thickness = 1, Transparency = 0.3 }, powerValue)
local warn9000 = DragonUI.Lettering(scouter, "Over9000", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.55, 0.56),
	Size = UDim2.fromOffset(SC_W - 20, 36),
	Rotation = -4,
	Text = "IT'S OVER 9000!!",
	Color = DragonUI.DAMAGE,
	BackColor = INK,
	TextXAlignment = Enum.TextXAlignment.Center,
	ZIndex = 12,
})
warn9000.Holder.Visible = false

-- top right: the Dragon Radar
local radar = new("Frame", {
	Name = "Radar",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -RADAR_MARGIN, 0, 6),
	Size = UDim2.fromOffset(164, 198),
	BackgroundTransparency = 1,
}, gui)
local radarScale = new("UIScale", {}, radar)
circle(radar, { -- hard shadow
	Name = "Shadow",
	Position = UDim2.fromOffset(9, 19),
	Size = UDim2.fromOffset(152, 152),
	BackgroundColor3 = INK,
	BackgroundTransparency = 0.2,
	ZIndex = 1,
})
local nub = new("Frame", {
	Name = "Button",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromOffset(76, 0),
	Size = UDim2.fromOffset(30, 14),
	BackgroundColor3 = PAPER,
	ZIndex = 2,
}, radar)
new("UIStroke", { Color = INK, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, nub)
local bezel = circle(radar, {
	Name = "Bezel",
	Position = UDim2.fromOffset(0, 10),
	Size = UDim2.fromOffset(152, 152),
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 3,
})
new("UIGradient", { Color = ColorSequence.new(PAPER, Color3.fromRGB(176, 172, 164)), Rotation = 60 }, bezel)
new("UIStroke", { Color = INK, Thickness = 3.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, bezel)
local screen = circle(bezel, {
	Name = "Screen",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(RADAR_SCREEN, RADAR_SCREEN),
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 4,
})
new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(86, 186, 108), Color3.fromRGB(18, 62, 36)), Rotation = 45 }, screen)
new("UIStroke", { Color = INK, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, screen)
do -- the grid, each line cut to fit inside the round screen
	local r = RADAR_SCREEN / 2
	for k = -2, 2 do
		local d = k * RADAR_SCREEN / 6
		local chord = 2 * math.sqrt(math.max(r * r - d * d, 0)) - 4
		for _, vertical in { false, true } do
			new("Frame", {
				Name = "Grid",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = vertical and UDim2.new(0.5, d, 0.5, 0) or UDim2.new(0.5, 0, 0.5, d),
				Size = vertical and UDim2.fromOffset(1, chord) or UDim2.fromOffset(chord, 1),
				BackgroundColor3 = Color3.fromRGB(150, 240, 170),
				BackgroundTransparency = k == 0 and 0.35 or 0.62,
				BorderSizePixel = 0,
				ZIndex = 5,
			}, screen)
		end
	end
end
local sweep = new("Frame", {
	Name = "Sweep",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(RADAR_SCREEN - 6, 2),
	BackgroundColor3 = Color3.fromRGB(200, 255, 215),
	BorderSizePixel = 0,
	ZIndex = 5,
}, screen)
new("UIGradient", { -- only the half from the centre outward shows, brightest at the rim
	Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(0.51, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	}),
}, sweep)
local blips = {}
for k = 1, BLIPS do
	local blip = circle(screen, {
		Name = "Blip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = DragonUI.DAMAGE,
		Visible = false,
		ZIndex = 6,
	})
	new("UIStroke", { Color = INK, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, blip)
	blips[k] = blip
end
local you = new("Frame", { -- you, in the middle
	Name = "You",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(9, 9),
	Rotation = 45,
	BackgroundColor3 = DragonUI.HP,
	ZIndex = 7,
}, screen)
new("UIStroke", { Color = INK, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, you)
Slab.new(radar, "Tag", 2, 170, 150, 24, INK, { ZIndex = 8 })
DragonUI.Lettering(radar, "Title", {
	Position = UDim2.fromOffset(18, 173),
	Size = UDim2.fromOffset(92, 18),
	Text = "DRAGON RADAR",
	Offset = 2,
	ZIndex = 9,
})
local range = Slab.new(radar, "Range", 112, 174, 50, 17, GI, { ZIndex = 9 })
label(range.Holder, {
	Name = "Text",
	Position = UDim2.fromOffset(6, 1),
	Size = UDim2.new(1, -12, 1, -2),
	Text = PowerConfig.RadarRange .. "m",
	TextColor3 = INK,
	TextXAlignment = Enum.TextXAlignment.Center,
	ZIndex = 10,
})

----------------------------------------------------------------------------------------
-- the portrait: a copy of your character in a 3D view, looking at your face
----------------------------------------------------------------------------------------
local portraitModel: Model? = nil
local portraitForm = nil

local function buildPortrait(character: Model)
	if portraitModel then
		portraitModel:Destroy()
		portraitModel = nil
	end
	local archivable = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(function()
		return character:Clone()
	end)
	character.Archivable = archivable
	if not ok or not copy then
		return
	end
	for _, d in copy:GetDescendants() do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Beam") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			if CollectionService:HasTag(d, "HairPhysics") then
				CollectionService:RemoveTag(d, "HairPhysics") -- no hair physics for the copy
			end
		end
	end
	local head = copy:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		copy:Destroy()
		return
	end
	copy.Parent = portrait
	local camera = portrait:FindFirstChildOfClass("Camera") or new("Camera", {}, portrait)
	camera.FieldOfView = PORTRAIT_FOV
	portrait.CurrentCamera = camera
	local h = head.CFrame
	camera.CFrame = CFrame.lookAt(h * PORTRAIT_EYE, h * PORTRAIT_LOOK)
	portraitModel = copy
	portraitForm = character:GetAttribute("Form")
end

----------------------------------------------------------------------------------------
-- every frame
----------------------------------------------------------------------------------------
local shownHealth, trailHealth, trailWait = 1, 1, 0
local shownKi = 0
local shownPower = PowerConfig.BasePowerLevel
local scrambleUntil = 0
local over9000Until = 0
local lastTarget = PowerConfig.BasePowerLevel
local ssjMix = 0 -- 0 = base colours, 1 = Super Saiyan colours
local kaiokenMix = 0 -- 1 = Kaioken red
local tiredMix = 0 -- 1 = exhausted grey
local KAIOKEN_RED = Color3.fromRGB(255, 64, 48)
local sweepAngle = 0
local enterAt = os.clock() -- the plate slides in from here
local radarAway = 0 -- 1 = the radar has slid off screen (while you power up)
local hitAt = -math.huge
local wasHidden = false
local character: Model? = nil

local function powerTarget(c: Model): number
	local base = PowerConfig.BasePowerLevel
	local state = c:GetAttribute("PowerState")
	local kaioken = c:GetAttribute("Kaioken") or 0
	if kaioken > 0 then
		return base * (c:GetAttribute("KaiokenMult") or PowerConfig.KaiokenLevels[kaioken] or 1)
	elseif c:GetAttribute("Form") == "SSJ" then
		return base * PowerConfig.SSJMultiplier
	elseif state == "Charging" or state == "Bursting" then
		return base * (1 + PowerConfig.ChargePowerBoost * (c:GetAttribute("Charge") or 0))
	end
	return base
end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local now = os.clock()
	local hidden = player:GetAttribute("InCutscene")
	gui.Enabled = not hidden
	if hidden then
		-- frozen while the cutscene plays, so afterwards the HUD slides back in and the Scouter
		-- counts your new power level up (and tells you it's over 9000)
		wasHidden = true
		return
	end
	if wasHidden then
		wasHidden = false
		enterAt = now
	end
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local scale = math.clamp(viewport.Y / 720, 0.68, 1.15)
	plateScale.Scale = scale
	radarScale.Scale = scale

	-- sliding in, and shaking when you get hit
	local enter = DragonUI.BackOut((now - enterAt) / 0.5)
	local shake = math.max(0, 1 - (now - hitAt) / 0.3)
	local jitter = shake > 0 and Vector2.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * (6 * shake) or Vector2.zero
	plate.Position = UDim2.fromOffset(PLATE_X - (1 - enter) * (520 * scale + 40) + jitter.X, PLATE_Y + HEADROOM * scale + jitter.Y)

	character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (character and humanoid) then
		return
	end

	-- the radar slides away while you power up (the charge bar takes its place on phones)
	local state = character:GetAttribute("PowerState")
	local busy = state == "Charging" or state == "Bursting"
	radarAway += ((busy and 1 or 0) - radarAway) * (1 - math.exp(-dt * 10))
	local away = math.max(1 - enter, radarAway)
	radar.Position = UDim2.new(1, -RADAR_MARGIN + away * (200 * scale + 40), 0, 6)

	-- colours follow your form (gold as a Super Saiyan, red in Kaioken, grey when exhausted)
	local ssj = character:GetAttribute("Form") == "SSJ"
	local kaioken = character:GetAttribute("Kaioken") or 0
	local tired = character:GetAttribute("Exhausted") == true
	ssjMix += ((ssj and 1 or 0) - ssjMix) * (1 - math.exp(-dt * 6))
	kaiokenMix += ((kaioken > 0 and 1 or 0) - kaiokenMix) * (1 - math.exp(-dt * 8))
	tiredMix += ((tired and 1 or 0) - tiredMix) * (1 - math.exp(-dt * 6))
	local grey = Color3.fromRGB(138, 130, 122)
	local kiColor = DragonUI.KI:Lerp(DragonUI.KI_SSJ, ssjMix):Lerp(KAIOKEN_RED, kaiokenMix)
	card:SetColor(GI:Lerp(GOLD, ssjMix):Lerp(Color3.fromRGB(222, 38, 34), kaiokenMix):Lerp(grey, tiredMix * 0.75))
	cardShade:SetColor(
		DragonUI.GI_DARK:Lerp(Color3.fromRGB(214, 128, 16), ssjMix):Lerp(Color3.fromRGB(128, 8, 18), kaiokenMix):Lerp(grey:Lerp(INK, 0.4), tiredMix * 0.75)
	)
	arcStroke.Color = kiColor
	formTag:SetColor(PAPER:Lerp(GOLD, ssjMix):Lerp(DragonUI.DAMAGE, kaiokenMix):Lerp(grey, tiredMix))
	if tired then
		formText.Text = "EXHAUSTED"
	elseif kaioken > 0 then
		formText.Text = "KAIOKEN x" .. tostring(character:GetAttribute("KaiokenMult") or PowerConfig.KaiokenLevels[kaioken])
	else
		formText.Text = ssj and "SUPER SAIYAN" or "BASE FORM"
	end
	formText.TextColor3 = INK:Lerp(PAPER, kaiokenMix)
	badgeKanji.Text = kaioken > 0 and "拳" or (ssj and "超" or "気")
	badgeStroke.Color = INK
	nameText:SetColors(nil, GI:Lerp(DragonUI.DAMAGE, math.max(ssjMix, kaiokenMix)))
	if portraitForm ~= character:GetAttribute("Form") and character:FindFirstChild("Head") then
		-- re-take the portrait a moment after your form changes, once the new hair shows
		portraitForm = character:GetAttribute("Form")
		local c = character
		task.delay(0.4, function()
			if player.Character == c then
				buildPortrait(c)
			end
		end)
	end

	-- HP: the bar drops at once; the red chunk behind it catches up a moment later
	local health = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
	if health < shownHealth - 0.02 then -- a hit (not the Kaioken's steady drain)
		trailWait = 0.5
		hitAt = now
	end
	shownHealth = health
	trailWait -= dt
	if trailWait <= 0 then
		trailHealth += (shownHealth - trailHealth) * (1 - math.exp(-dt * 4))
	end
	trailHealth = math.max(trailHealth, shownHealth)
	hpFill:SetFill(shownHealth)
	hpTrail:SetFill(trailHealth)
	if health < 0.3 then -- low: the bar throbs orange (red is the damage chunk's colour)
		hpFill:SetColor(DragonUI.HP:Lerp(DragonUI.HP_LOW, 0.5 + 0.5 * math.sin(now * 9)))
	else
		hpFill:SetColor(DragonUI.HP)
	end
	-- the outline flashes on a hit, and throbs with the Kaioken's strain (faster when higher)
	local throb = kaiokenMix * (0.35 + 0.35 * math.sin(now * (6 + kaioken)))
	hpEdge:SetColor(PAPER:Lerp(DragonUI.DAMAGE, math.max(shake, throb)))
	portrait.ImageColor3 = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 90, 90), shake)
	hpValue.Text = tostring(math.ceil(humanoid.Health))
	-- a glint runs along the bar every few seconds
	local fillWidth = hpFill.Width or 0
	local run = ((now % 2.8) / 0.45)
	if run < 1 and fillWidth > 30 then
		local x = -18 + (fillWidth + 18) * DragonUI.QuadOut(run)
		local left, right = math.max(x, 0), math.min(x + 18, fillWidth)
		hpGlint.Holder.Position = UDim2.fromOffset(left, 0)
		hpGlint:SetWidth(math.max(right - left, 0))
	else
		hpGlint:SetWidth(0)
	end

	-- Ki: five pips filling one after another; each pops when it fills up
	local ki = character:GetAttribute("Ki") or 0
	shownKi += (ki - shownKi) * (1 - math.exp(-dt * 8))
	local share = math.clamp(shownKi / PowerConfig.KiMax, 0, 1) * KI_PIPS
	local full = 0
	for k, pip in pips do
		local f = math.clamp(share - (k - 1), 0, 1)
		pip.Fill:SetFill(f)
		local isFull = f >= 0.999
		if isFull and not pip.Full then
			pip.PopAt = now
		end
		pip.Full = isFull
		pip.Edge.Holder.Visible = isFull
		local pop = math.max(0, 1 - (now - pip.PopAt) / 0.25)
		pip.Fill:SetColor(kiColor:Lerp(PAPER, pop))
		if isFull then
			full += 1
		end
	end
	kiBall:SetStars(full)
	kiBall.Scale.Scale = full >= KI_PIPS and (1 + 0.06 * math.sin(now * 6)) or 1

	-- the Scouter: counts toward your power level, scrambling when it jumps
	local wanted = powerTarget(character)
	if wanted > lastTarget * 1.3 then
		scrambleUntil = now + 0.35
	end
	if lastTarget <= 9000 and wanted > 9000 then
		over9000Until = now + 1.6
	end
	lastTarget = wanted
	shownPower += (wanted - shownPower) * (1 - math.exp(-dt * 3))
	if now < scrambleUntil then
		local digits = #tostring(math.floor(wanted))
		powerValue.Text = commas(rng:NextInteger(10 ^ (digits - 1), 10 ^ digits - 1))
	else
		local wobble = (character:GetAttribute("PowerState") == "Idle") and 1 or (1 + rng:NextNumber(-0.01, 0.01))
		powerValue.Text = commas(shownPower * wobble)
	end
	local warning = now < over9000Until
	warn9000.Holder.Visible = warning and (math.floor(now * 8) % 2 == 0)
	powerValue.TextTransparency = warning and 0.75 or 0

	-- the Dragon Radar
	sweepAngle = (sweepAngle + dt * 150) % 360
	sweep.Rotation = sweepAngle
	local root = character:FindFirstChild("HumanoidRootPart")
	local used = 0
	if root and camera then
		local look = camera.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local turn = CFrame.Angles(0, -yaw, 0)
		for _, other in Players:GetPlayers() do
			local oc = other ~= player and other.Character
			local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
			if oroot and used < BLIPS then
				local rel = turn * (oroot.Position - root.Position)
				local flat = Vector2.new(rel.X, rel.Z) / PowerConfig.RadarRange
				if flat.Magnitude <= 1 then
					used += 1
					local blip = blips[used]
					blip.Visible = true
					blip.Position = UDim2.new(0.5, flat.X * (RADAR_SCREEN / 2 - 6), 0.5, flat.Y * (RADAR_SCREEN / 2 - 6))
					local pulse = 0.5 + 0.5 * math.sin(now * 6 + used)
					blip.Size = UDim2.fromOffset(7 + 3 * pulse, 7 + 3 * pulse)
					blip.BackgroundColor3 = (oc:GetAttribute("Form") == "SSJ") and DragonUI.KI_SSJ or DragonUI.DAMAGE
				end
			end
		end
	end
	for k = used + 1, BLIPS do
		blips[k].Visible = false
	end
end)

player.CharacterAdded:Connect(function(c)
	portraitForm = nil
	enterAt = os.clock()
	shownHealth, trailHealth = 1, 1
	task.delay(1, function()
		if player.Character == c then
			buildPortrait(c)
		end
	end)
end)
if player.Character then
	task.defer(buildPortrait, player.Character)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="16">
        <Properties>
          <string name="Name">HandFX</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HandFX  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Moves everyone's fingers on this player's screen (the finger pieces CharacterSetup puts on
	the hands from LeftFingers_Rigged.fbx and RightFingers_Rigged.fbx):
	  standing     relaxed: each finger a little curled (the pinky most, the index least), the
	               thumb hanging forward. Every few seconds one hand fidgets, bored: a quick
	               open-close-open-close, drumming along the fingers, rubbing the thumb on the
	               index finger, a big stretch, or squeezing a fist and shaking it loose
	  moving       relaxed, the fingers trailing behind the hand as the arms swing
	  powering up  fists, squeezing harder and trembling as the bar fills
	  transforming fists ... then the left hand rests flat on the inside of the right elbow and
	               swipes out into a point for "YOU'RE FINISHED!" (PowerFX moves the arm)
	  Super Saiyan fists while the golden aura burns, loosening as you calm down
	  Kaioken      fists, straining harder the higher you push it
	  exhausted    limp
	Every finger joint moves on a spring, so fingers overshoot a touch and settle instead of
	snapping, and each finger starts a moment after its neighbour.
	Poses and fidgets: the POSES and FIDGETS tables below (degrees).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local PowerConfig = require(ReplicatedStorage:WaitForChild("PowerConfig"))

local FINGERS = { "Thumb", "Index", "Middle", "Ring", "Pinky" }
local VIEW_DISTANCE = 120 -- fingers further than this from the camera aren't animated
local rng = Random.new()

----------------------------------------------------------------------------------------
-- poses: for each finger { knuckle bend, middle-joint bend, spread } in degrees.
-- Bend: + curls toward the palm. Spread: + swings the finger toward the front.
----------------------------------------------------------------------------------------
local POSES = {
	Relaxed = { Thumb = { 6, 6, 16 }, Index = { 12, 16, 0 }, Middle = { 15, 20, 0 }, Ring = { 18, 24, 0 }, Pinky = { 22, 28, 0 } },
	Loose = { Thumb = { 3, 4, 12 }, Index = { 8, 10, 0 }, Middle = { 10, 13, 0 }, Ring = { 12, 15, 0 }, Pinky = { 14, 18, 0 } },
	Open = { Thumb = { -4, 0, 10 }, Index = { -6, -2, 2 }, Middle = { -6, -2, 0 }, Ring = { -6, -2, -1 }, Pinky = { -6, -2, -2 } },
	Stretch = { Thumb = { -10, -4, 24 }, Index = { -16, -8, 9 }, Middle = { -16, -8, 3 }, Ring = { -16, -8, -3 }, Pinky = { -16, -8, -9 } },
	Fist = { Thumb = { 80, 30, 30 }, Index = { 50, 120, 0 }, Middle = { 52, 122, 0 }, Ring = { 54, 122, 0 }, Pinky = { 56, 120, 0 } },
	Tight = { Thumb = { 86, 36, 32 }, Index = { 56, 126, 0 }, Middle = { 58, 128, 0 }, Ring = { 60, 128, 0 }, Pinky = { 62, 126, 0 } },
	Claw = { Thumb = { 20, 30, 14 }, Index = { 25, 70, 0 }, Middle = { 28, 72, 0 }, Ring = { 30, 74, 0 }, Pinky = { 32, 72, 0 } },
	Point = { Thumb = { 78, 28, 28 }, Index = { -3, 0, 0 }, Middle = { 52, 122, 0 }, Ring = { 54, 122, 0 }, Pinky = { 56, 120, 0 } },
	Flat = { Thumb = { 4, 4, 12 }, Index = { 8, 10, 0 }, Middle = { 9, 12, 0 }, Ring = { 10, 13, 0 }, Pinky = { 12, 15, 0 } },
	Rub = { Thumb = { 38, 34, 26 }, Index = { 24, 40, 0 }, Middle = { 17, 22, 0 }, Ring = { 19, 25, 0 }, Pinky = { 23, 29, 0 } },
	Rub2 = { Thumb = { 30, 44, 18 }, Index = { 28, 46, 0 }, Middle = { 17, 22, 0 }, Ring = { 19, 25, 0 }, Pinky = { 23, 29, 0 } },
}

-- Idle fidgets: key poses over time (seconds). Order + Stagger: each finger runs a little behind
-- the one before it, from the pinky (or the index) along the hand. Shake: a strained tremble.
local FIDGETS = {
	Flex = { -- quick open, close, open, close
		Weight = 3, Order = "pinky", Stagger = 0.022,
		Keys = { { 0, "Relaxed" }, { 0.1, "Open" }, { 0.26, "Fist" }, { 0.38, "Open" }, { 0.54, "Fist" }, { 0.68, "Open" }, { 1.0, "Relaxed" } },
	},
	Drum = { -- drumming along the fingers, pinky to index, twice
		Weight = 2, Order = "pinky", Stagger = 0.075, KeepThumb = true,
		Keys = { { 0, "Relaxed" }, { 0.08, "Claw" }, { 0.2, "Relaxed" }, { 0.5, "Relaxed" }, { 0.58, "Claw" }, { 0.7, "Relaxed" } },
	},
	Rub = { -- rubbing the thumb against the side of the index finger
		Weight = 2, Order = "index", Stagger = 0,
		Keys = { { 0, "Relaxed" }, { 0.15, "Rub" }, { 0.3, "Rub2" }, { 0.45, "Rub" }, { 0.6, "Rub2" }, { 0.75, "Rub" }, { 1.05, "Relaxed" } },
	},
	Stretch = { -- fingers spread wide and straight, held, then let go
		Weight = 1.5, Order = "index", Stagger = 0.03, Shake = 0.6,
		Keys = { { 0, "Relaxed" }, { 0.22, "Stretch" }, { 0.75, "Stretch" }, { 1.1, "Relaxed" } },
	},
	Squeeze = { -- squeeze a tight fist, then shake it loose
		Weight = 1.5, Order = "pinky", Stagger = 0.03, Shake = 1,
		Keys = { { 0, "Relaxed" }, { 0.18, "Tight" }, { 0.6, "Tight" }, { 0.72, "Open" }, { 0.8, "Claw" }, { 0.9, "Open" }, { 1.2, "Relaxed" } },
	},
}
-- as a Super Saiyan the bored fidgets are tense ones
local SSJ_FIDGETS = {
	Clench = {
		Weight = 2, Order = "pinky", Stagger = 0.02, Shake = 1.2,
		Keys = { { 0, "Fist" }, { 0.15, "Tight" }, { 0.75, "Tight" }, { 1.0, "Fist" } },
	},
	Crack = {
		Weight = 1, Order = "index", Stagger = 0.05,
		Keys = { { 0, "Fist" }, { 0.16, "Claw" }, { 0.36, "Claw" }, { 0.5, "Tight" }, { 0.8, "Fist" } },
	},
}
local ORDER = {
	pinky = { Pinky = 0, Ring = 1, Middle = 2, Index = 3, Thumb = 4 },
	index = { Index = 0, Middle = 1, Ring = 2, Pinky = 3, Thumb = 0.5 },
}

-- springs: how fast each joint follows its target, and how much it overshoots
local OMEGA = { Thumb = 22, Index = 30, Middle = 29, Ring = 28, Pinky = 27 }
local DAMPING = 0.55 -- 1 = no overshoot, lower = more bounce
local LAG = 3 -- how much the fingers trail behind when the hand speeds up or slows down

----------------------------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------------------------
local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function mix(a, b, t: number)
	local out = {}
	for _, f in FINGERS do
		local pa, pb = a[f], b[f]
		out[f] = { pa[1] + (pb[1] - pa[1]) * t, pa[2] + (pb[2] - pa[2]) * t, pa[3] + (pb[3] - pa[3]) * t }
	end
	return out
end

-- one finger's angles from a fidget's key poses at time t
local function sampleKeys(keys, finger: string, t: number)
	if t <= keys[1][1] then
		return POSES[keys[1][2]][finger]
	end
	for i = 1, #keys - 1 do
		local k0, k1 = keys[i], keys[i + 1]
		if t < k1[1] then
			local x = smooth((t - k0[1]) / (k1[1] - k0[1]))
			local a, b = POSES[k0[2]][finger], POSES[k1[2]][finger]
			return { a[1] + (b[1] - a[1]) * x, a[2] + (b[2] - a[2]) * x, a[3] + (b[3] - a[3]) * x }
		end
	end
	return POSES[keys[#keys][2]][finger]
end

local function fidgetLength(fidget): number
	local last = fidget.Keys[#fidget.Keys][1]
	return last + (fidget.Stagger or 0) * 4
end

local function pick(set)
	local total = 0
	for _, f in set do
		total += f.Weight
	end
	local r = rng:NextNumber(0, total)
	local last
	for _, f in set do
		last = f
		r -= f.Weight
		if r <= 0 then
			return f
		end
	end
	return last
end

-- a bone's resting CFrame inside the MeshPart it lives in
local function restInMesh(bone: Bone, mesh: BasePart): CFrame?
	local cf = CFrame.identity
	local node: Instance? = bone
	while node and node ~= mesh do
		if not node:IsA("Bone") then
			return nil
		end
		cf = (node :: Bone).CFrame * cf
		node = node.Parent
	end
	return node == mesh and cf or nil
end

----------------------------------------------------------------------------------------
-- one hand: its bones, and the hand's sideways / front-back axes seen from each bone
----------------------------------------------------------------------------------------
local function setupHand(character: Model, side: string)
	local holder = character:FindFirstChild("DW_" .. side .. "Fingers")
	local mesh = holder and holder:FindFirstChild(side .. "Fingers")
	local hand = character:FindFirstChild(side .. "Hand")
	if not (mesh and mesh:IsA("BasePart") and hand and hand:IsA("BasePart")) then
		return nil
	end
	local prefix = side:sub(1, 1)
	-- the hand's axes inside the mesh (welded, so this never changes)
	local handToMesh = hand.CFrame:ToObjectSpace(mesh.CFrame).Rotation
	local xMesh = handToMesh:VectorToObjectSpace(Vector3.xAxis)
	local zMesh = handToMesh:VectorToObjectSpace(Vector3.zAxis)
	local fingers = {}
	for _, f in FINGERS do
		local b1 = mesh:FindFirstChild(prefix .. f .. "1", true)
		local b2 = mesh:FindFirstChild(prefix .. f .. "2", true)
		if not (b1 and b1:IsA("Bone") and b2 and b2:IsA("Bone")) then
			return nil
		end
		local r1, r2 = restInMesh(b1, mesh), restInMesh(b2, mesh)
		if not (r1 and r2) then
			return nil
		end
		-- which way the fingertip moves (along the hand's X) when the finger curls: the four
		-- fingers sit on the outer edge and curl inward, the thumb on the inner edge curls outward
		local outward = side == "Right" and 1 or -1
		local dir = (f == "Thumb") and outward or -outward
		fingers[f] = {
			B1 = b1,
			B2 = b2,
			X1 = r1.Rotation:VectorToObjectSpace(xMesh),
			Z1 = r1.Rotation:VectorToObjectSpace(zMesh),
			Z2 = r2.Rotation:VectorToObjectSpace(zMesh),
			Dir = dir,
			Angle = { 0, 0, 0 }, -- knuckle, middle, spread (radians)
			Speed = { 0, 0, 0 },
		}
	end
	return {
		Side = side,
		Mesh = mesh,
		Hand = hand,
		Fingers = fingers,
		Fidget = nil,
		FidgetAt = 0,
		NextFidget = os.clock() + rng:NextNumber(1.5, 5),
		LastPos = nil,
		LastVel = Vector3.zero,
	}
end

local rigs = {} -- [character] = { Left = hand, Right = hand, BurstAt, ... }

local function rigFor(character: Model)
	local rig = rigs[character]
	if rig and (rig.Left or rig.Right) and (not rig.Left or rig.Left.Mesh.Parent) and (not rig.Right or rig.Right.Mesh.Parent) then
		return rig
	end
	if rig and os.clock() < (rig.RetryAt or 0) then
		return rig
	end
	rig = rig or {}
	rig.Left = setupHand(character, "Left")
	rig.Right = setupHand(character, "Right")
	rig.RetryAt = os.clock() + 2 -- (no fingers yet: look again in a bit)
	rigs[character] = rig
	return rig
end

----------------------------------------------------------------------------------------
-- what each hand should be doing right now
----------------------------------------------------------------------------------------
local function startFidget(hand, set, now: number)
	hand.Fidget = pick(set)
	hand.FidgetAt = now
	hand.NextFidget = now + fidgetLength(hand.Fidget) + rng:NextNumber(2.5, 7)
end

-- target angles (degrees) for one hand, plus how much it trembles
local function target(character: Model, rig, hand, now: number, standing: boolean)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health <= 0 then
		return POSES.Loose, 0
	end
	local state = character:GetAttribute("PowerState")
	local kaioken = character:GetAttribute("Kaioken") or 0
	if state == "Charging" then
		local charge = character:GetAttribute("Charge") or 0
		return mix(POSES.Fist, POSES.Tight, charge), 0.6 + 1.4 * charge
	elseif state == "Bursting" then
		local t = now - (rig.BurstAt or now)
		local pointAt = PowerConfig.PointAt
		if hand.Side == "Left" and pointAt and t >= pointAt then
			-- the "YOU'RE FINISHED!" point, in step with PowerFX's arm
			local p = t - pointAt
			if p < 0.62 then
				return mix(POSES.Fist, POSES.Flat, smooth(p / 0.24)), 0
			elseif p < 0.7 then
				return mix(POSES.Flat, POSES.Open, smooth((p - 0.62) / 0.08)), 0
			end
			return mix(POSES.Open, POSES.Point, smooth((p - 0.7) / 0.1)), 0
		end
		return POSES.Tight, t < (PowerConfig.ExplodeAt or 0) and 1.5 or 0.4
	elseif kaioken > 0 then
		return POSES.Tight, 0.4 + 0.35 * kaioken
	elseif character:GetAttribute("Exhausted") then
		return POSES.Loose, 0
	end
	local ssj = character:GetAttribute("Form") == "SSJ"
	local base = POSES.Relaxed
	if ssj then
		-- fists while the golden aura burns, loosening as you calm down
		local breeze = character:GetAttribute("Breeze") or 0
		base = mix(mix(POSES.Relaxed, POSES.Claw, 0.35), POSES.Fist, breeze)
	end
	if not standing then
		hand.Fidget = nil
		return base, 0
	end
	-- bored: now and then a fidget
	if not hand.Fidget and now >= hand.NextFidget then
		startFidget(hand, ssj and SSJ_FIDGETS or FIDGETS, now)
		-- sometimes the other hand joins in a moment later
		local other = hand.Side == "Left" and rig.Right or rig.Left
		if other and not other.Fidget and rng:NextNumber() < 0.3 then
			other.Fidget = hand.Fidget
			other.FidgetAt = now + 0.12
			other.NextFidget = hand.NextFidget + 0.3
		end
	end
	local fidget = hand.Fidget
	if fidget then
		local t = now - hand.FidgetAt
		if t > fidgetLength(fidget) then
			hand.Fidget = nil
		elseif t >= 0 then
			local out = {}
			local order = ORDER[fidget.Order] or ORDER.pinky
			for _, f in FINGERS do
				if f == "Thumb" and fidget.KeepThumb then
					out[f] = base[f]
				else
					out[f] = sampleKeys(fidget.Keys, f, t - order[f] * (fidget.Stagger or 0))
				end
			end
			local shake = 0
			if fidget.Shake then
				local len = fidget.Keys[#fidget.Keys][1]
				shake = fidget.Shake * smooth(t / (len * 0.25)) * (1 - smooth((t - len * 0.6) / (len * 0.25)))
			end
			return out, shake
		end
	end
	return base, 0
end

----------------------------------------------------------------------------------------
-- every frame, after the character's animations have played
----------------------------------------------------------------------------------------
local function stepHand(character: Model, rig, hand, now: number, dt: number, standing: boolean)
	-- how the hand is speeding up or slowing down, in its own axes (the fingers trail behind)
	local bottom = hand.Hand.CFrame * Vector3.new(0, -0.2, 0)
	local accel = Vector3.zero
	if hand.LastPos and dt > 0 then
		local vel = (bottom - hand.LastPos) / dt
		if vel.Magnitude > 60 then -- teleported or respawned: no kick
			vel = Vector3.zero
			hand.LastVel = Vector3.zero
		end
		accel = hand.Hand.CFrame:VectorToObjectSpace((vel - hand.LastVel) / dt)
		if accel.Magnitude > 300 then
			accel = accel.Unit * 300
		end
		hand.LastVel = vel
	end
	hand.LastPos = bottom

	local goal, shake = target(character, rig, hand, now, standing)
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for i, f in FINGERS do
		local finger = hand.Fingers[f]
		local g = goal[f]
		local w = OMEGA[f]
		local k, c = w * w, 2 * DAMPING * w
		local tremble = shake > 0 and math.rad(3) * shake * math.sin(now * 53 + i * 1.7) or 0
		local targets = { math.rad(g[1]) + tremble, math.rad(g[2]) + tremble * 0.7, math.rad(g[3]) }
		-- trailing: sideways speeding-up bends the finger back, front-back speeding-up fans it
		local push = { -finger.Dir * LAG * accel.X, -finger.Dir * LAG * 0.6 * accel.X, LAG * 0.5 * accel.Z }
		for _ = 1, steps do
			for j = 1, 3 do
				local a = k * (targets[j] - finger.Angle[j]) - c * finger.Speed[j] + push[j]
				finger.Speed[j] += a * h
				finger.Angle[j] += finger.Speed[j] * h
			end
		end
		finger.B1.Transform = CFrame.fromAxisAngle(finger.X1, finger.Angle[3]) * CFrame.fromAxisAngle(finger.Z1, finger.Dir * finger.Angle[1])
		finger.B2.Transform = CFrame.fromAxisAngle(finger.Z2, finger.Dir * finger.Angle[2])
	end
end

local okPre, preRender = pcall(function()
	return RunService.PreRender
end)
local renderSignal = (okPre and preRender) or RunService.RenderStepped
local lastColour = 0

renderSignal:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	local now = os.clock()
	local camera = Workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position
	local seen = {}
	local recolour = now - lastColour > 1.5
	if recolour then
		lastColour = now
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and (not camPos or (root.Position - camPos).Magnitude < VIEW_DISTANCE) then
			seen[character] = true
			local rig = rigFor(character)
			-- when the transformation started (for the point)
			if character:GetAttribute("PowerState") == "Bursting" then
				rig.BurstAt = rig.BurstAt or now
			else
				rig.BurstAt = nil
			end
			local flat = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			local standing = flat.Magnitude < 1.5
			for _, hand in { rig.Left, rig.Right } do
				if hand and hand.Mesh.Parent then
					stepHand(character, rig, hand, now, dt, standing)
					if recolour and hand.Mesh:GetAttribute("KeepColour") ~= true then
						hand.Mesh.Color = hand.Hand.Color -- (skin colour changes follow the hand)
					end
				end
			end
		end
	end
	for character in rigs do
		if not seen[character] and not character.Parent then
			rigs[character] = nil
		end
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="17">
        <Properties>
          <string name="Name">HairFitTool</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairFitTool  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	A little panel for lining the hair and belt up on your character while the game is running.
	Press H (or tap the "Fit" button on a phone) to open or close it.

	  Prev / Next   pick which piece you're moving: base hair, Super Saiyan hair or belt
	                (it gets an outline; the Super Saiyan hair only shows once you transform)
	  Up, Down, Left, Right, Fwd, Back   move it 0.05 studs (hold Shift on a keyboard
	                                      for 0.01)
	  Reset         undo this session's nudges

	The box at the bottom shows the Offset line for HairConfig, e.g.
	    Offset = CFrame.new(0, 0.05, -0.02),
	Copy it into that piece's entry in ReplicatedStorage > HairConfig to keep it.
	(The nudges only change what you see in this play session.) Directions are relative to
	the body part the piece is fixed to (the head for hair, the waist for the belt).

	Turn the tool off with HairConfig.FitToolEnabled = false.
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))

if not HairConfig.FitToolEnabled then
	return
end

local STEP = 0.05
local FINE_STEP = 0.01

local player = Players.LocalPlayer
local nudges = {} -- [hair part] = total nudge this session (head space: right, up, back)
local selectedIndex = 1
local gui, title, readout, highlight

local function tagged(): { BasePart }
	local list = {}
	local character = player.Character
	for _, part in CollectionService:GetTagged(HairPhysics.TAG) do
		if part:IsA("BasePart") and character and part:IsDescendantOf(character) then
			table.insert(list, part)
		end
	end
	table.sort(list, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return list
end

local function selectedHair(): BasePart?
	local list = tagged()
	if #list == 0 then
		return nil
	end
	selectedIndex = (selectedIndex - 1) % #list + 1
	return list[selectedIndex]
end

-- The weld holding the piece on, and the body part it's fixed to.
local function findWeld(hair: BasePart): (JointInstance?, BasePart?)
	for _, child in hair:GetChildren() do
		if child:IsA("JointInstance") then
			local other = child.Part0 == hair and child.Part1 or child.Part0
			if other then
				return child, other
			end
		end
	end
	return nil
end

local function offsetLine(hair: BasePart): string
	local preset = hair:GetAttribute("HairPreset")
	local cfg = HairConfig.Hairs[preset]
	local base = cfg and cfg.Offset or CFrame.identity
	local p = base.Position + (nudges[hair] or Vector3.zero)
	local function n(x: number): string
		local str = string.format("%.2f", x)
		if str == "0.00" or str == "-0.00" then
			return "0"
		end
		return (str:gsub("0+$", ""):gsub("%.$", ""))
	end
	return ("Offset = CFrame.new(%s, %s, %s),"):format(n(p.X), n(p.Y), n(p.Z))
end

local function refresh()
	if not gui then
		return
	end
	local hair = selectedHair()
	if hair then
		title.Text = ("Fit: %s"):format(tostring(hair:GetAttribute("HairPreset")))
		readout.Text = offsetLine(hair)
		highlight.Adornee = hair
	else
		title.Text = "Fit: nothing to fit yet"
		readout.Text = ""
		highlight.Adornee = nil
	end
end

-- Moves a hair by delta (head space: right, up, back) by adjusting the weld that holds it.
local function applyDelta(hair: BasePart, delta: Vector3)
	local weld, head = findWeld(hair)
	if not weld or not head then
		warn("[HairFitTool] couldn't find the weld holding " .. hair:GetFullName())
		return
	end
	if weld.Part0 == head then
		local current = weld.C0 * weld.C1:Inverse()
		weld.C0 = CFrame.new(delta) * current * weld.C1
	else
		local current = weld.C1 * weld.C0:Inverse()
		weld.C1 = CFrame.new(delta) * current * weld.C0
	end
	nudges[hair] = (nudges[hair] or Vector3.zero) + delta
	refresh()
end

local function nudge(direction: Vector3)
	local hair = selectedHair()
	if hair then
		local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		applyDelta(hair, direction * (fine and FINE_STEP or STEP))
	end
end

local function reset()
	local hair = selectedHair()
	if hair and nudges[hair] then
		applyDelta(hair, -nudges[hair])
		nudges[hair] = Vector3.zero
		refresh()
	end
end

local function makeButton(parent: Instance, text: string, pos: UDim2, size: UDim2, onClick: () -> ())
	local b = Instance.new("TextButton")
	b.Text = text
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextScaled = true
	b.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

local function buildGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "HairFitTool"
	gui.ResetOnSpawn = false
	gui.Enabled = false

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0, 1)
	frame.Position = UDim2.new(0, 12, 1, -12)
	frame.Size = UDim2.fromOffset(300, 250)
	frame.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
	frame.BackgroundTransparency = 0.1
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(10, 6)
	title.Size = UDim2.new(1, -20, 0, 24)
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local w, h = 88, 32
	local function at(col: number, row: number)
		return UDim2.fromOffset(10 + col * (w + 6), 36 + row * (h + 6))
	end
	local size = UDim2.fromOffset(w, h)
	makeButton(frame, "Prev", at(0, 0), size, function()
		selectedIndex -= 1
		refresh()
	end)
	makeButton(frame, "Reset", at(1, 0), size, reset)
	makeButton(frame, "Next", at(2, 0), size, function()
		selectedIndex += 1
		refresh()
	end)
	makeButton(frame, "Up", at(1, 1), size, function()
		nudge(Vector3.yAxis)
	end)
	makeButton(frame, "Left", at(0, 2), size, function()
		nudge(-Vector3.xAxis)
	end)
	makeButton(frame, "Down", at(1, 2), size, function()
		nudge(-Vector3.yAxis)
	end)
	makeButton(frame, "Right", at(2, 2), size, function()
		nudge(Vector3.xAxis)
	end)
	makeButton(frame, "Fwd", at(0, 1), size, function()
		nudge(-Vector3.zAxis)
	end)
	makeButton(frame, "Back", at(2, 1), size, function()
		nudge(Vector3.zAxis)
	end)

	-- a TextBox so the line can be selected and copied
	readout = Instance.new("TextBox")
	readout.ClearTextOnFocus = false
	readout.TextEditable = false
	readout.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 4)
	readout.Size = UDim2.new(1, -20, 0, 30)
	readout.BackgroundColor3 = Color3.fromRGB(12, 13, 16)
	readout.TextColor3 = Color3.fromRGB(140, 220, 160)
	readout.Font = Enum.Font.Code
	readout.TextScaled = true
	readout.Parent = frame
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 6)
	rc.Parent = readout

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 38)
	hint.Size = UDim2.new(1, -20, 0, 16)
	hint.Font = Enum.Font.Gotham
	hint.TextColor3 = Color3.fromRGB(170, 175, 185)
	hint.TextScaled = true
	hint.Text = "Copy this line into HairConfig to keep it"
	hint.Parent = frame

	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 200, 60)
	highlight.Enabled = false
	highlight.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function toggle(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if not gui then
		buildGui()
	end
	gui.Enabled = not gui.Enabled
	highlight.Enabled = gui.Enabled
	refresh()
	if gui.Enabled then
		local hair = selectedHair()
		if hair then
			print("[HairFitTool] " .. tostring(hair:GetAttribute("HairPreset")) .. ": " .. offsetLine(hair))
		end
	end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction("HairFitTool", toggle, true, HairConfig.FitToolKey or Enum.KeyCode.H)
ContextActionService:SetTitle("HairFitTool", "Fit")
ContextActionService:SetPosition("HairFitTool", UDim2.new(1, -70, 0, 10))
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">ServerStorage</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">CharacterParts</string>
        </Properties>
      </Item>
