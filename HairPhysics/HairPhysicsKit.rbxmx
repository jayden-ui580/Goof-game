    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">HairApplier</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairApplier  (Script — lives in ServerScriptService)

	Puts the rigged hair on the rigs listed in HairConfig.Assignments
	(MrPigtails gets Pigtails, MrLady gets LadyHair) when the game starts.

	For each rig it:
	  1. finds the imported hair model (in ServerStorage > HairModels) by its bones,
	  2. copies just the hair MeshPart and its bones,
	  3. works out from the bone positions exactly where the hair sits on the head
	     (this also fixes the hair if the importer scaled or turned it),
	  4. wears it as a normal hair Accessory,
	  5. tags it "HairPhysics" so every player's computer starts simulating it.

	Nothing to edit here — settings are in HairConfig.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))

local RIG_WAIT_TIME = 20 -- seconds to wait for a rig to exist before giving up

local function log(message: string)
	print("[HairApplier] " .. message)
end

local function complain(message: string)
	warn("[HairApplier] " .. message)
end

-- The MeshPart that owns a bone (the first part above it).
local function partOfBone(bone: Instance): BasePart?
	local node = bone.Parent
	while node and not node:IsA("BasePart") do
		node = node.Parent
	end
	return node :: BasePart?
end

local function isInsideCharacter(inst: Instance): boolean
	local node = inst.Parent
	while node and node ~= game do
		if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
			return true
		end
		node = node.Parent
	end
	return false
end

-- Finds the imported hair by looking for its signature bone. Returns that bone.
local function findHairSource(hairName: string, hairCfg): (Bone?, string?)
	local signature = hairCfg.SignatureBone
	local places = {}
	for _, container in { ServerStorage, ReplicatedStorage, Workspace } do
		local folder = container:FindFirstChild(HairConfig.ModelFolder)
		if folder then
			table.insert(places, folder)
		end
	end
	for _, place in places do
		local bone = place:FindFirstChild(signature, true)
		if bone and bone:IsA("Bone") then
			return bone, place:GetFullName()
		end
	end
	-- forgiving fallback: the imported model was left loose in Workspace
	for _, d in Workspace:GetDescendants() do
		if d.Name == signature and d:IsA("Bone") and not isInsideCharacter(d) then
			local part = partOfBone(d)
			if part then
				complain(
					("found the %s hair loose in Workspace (%s). It works, but move the model into ServerStorage > %s so it doesn't float around in your map."):format(
						hairName,
						part:GetFullName(),
						HairConfig.ModelFolder
					)
				)
				return d, "Workspace"
			end
		end
	end
	return nil
end

-- Bone positions inside the hair part, paired with where they were modeled (head space).
local function collectBonePairs(hairPart: BasePart, layout)
	local design, actual = {}, {}
	for boneName, modeled in layout.Bones do
		local bone = hairPart:FindFirstChild(boneName, true)
		if bone and bone:IsA("Bone") then
			local cf = HairPhysics.PartSpaceCFrame(bone, hairPart)
			if cf then
				table.insert(design, modeled)
				table.insert(actual, cf.Position)
			end
		end
	end
	return design, actual
end

-- Makes a copy of the hair MeshPart with all of its bones inside it. Normally the importer
-- already puts the bones inside the mesh; if it put them in a separate part instead, they're
-- moved into the mesh at exactly the same spot, so the skinning is unchanged.
local function copyHairMesh(signatureBone: Bone): BasePart?
	local original = partOfBone(signatureBone)
	if not original then
		return nil
	end
	local holder: Instance = signatureBone:FindFirstAncestorWhichIsA("Model") or original
	if holder:IsA("Workspace") then
		holder = original -- Workspace counts as a Model; never copy the whole map
	end
	local copy = holder:Clone() or original:Clone()
	if not copy then
		return nil
	end
	local bone = copy:FindFirstChild(signatureBone.Name, true)
	local bonePart = bone and partOfBone(bone)
	if not bonePart then
		copy:Destroy()
		return nil
	end
	local mesh = bonePart
	if not bonePart:IsA("MeshPart") then
		local found = copy:IsA("MeshPart") and copy or copy:FindFirstChildWhichIsA("MeshPart", true)
		if found then
			mesh = found
			for _, child in bonePart:GetChildren() do
				if child:IsA("Bone") then
					local world = bonePart.CFrame * child.CFrame
					child.CFrame = mesh.CFrame:ToObjectSpace(world)
					child.Parent = mesh
				end
			end
		end
	end
	if mesh ~= copy then
		mesh.Parent = nil
		copy:Destroy()
	end
	return mesh
end

local function removeOldHair(rig: Model, hairCfg)
	for _, child in rig:GetChildren() do
		if child:GetAttribute("HairPhysicsHair") then
			child:Destroy()
		elseif hairCfg.RemoveOtherHair and child:IsA("Accessory") then
			local handle = child:FindFirstChild("Handle")
			local isHair = child.AccessoryType == Enum.AccessoryType.Hair
				or (handle and handle:FindFirstChild("HairAttachment") ~= nil)
			if isHair then
				child:Destroy()
			end
		end
	end
end

local function applyHair(rig: Model, hairName: string)
	local hairCfg = HairConfig.Hairs[hairName]
	local layout = HairConfig.Layouts[hairName]
	if not hairCfg or not layout then
		complain(("no settings called '%s' in HairConfig.Hairs / HairConfig.Layouts"):format(hairName))
		return
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	local head = rig:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		complain(rig.Name .. " has no Head part, so it can't wear hair")
		return
	end

	local sourceBone, where = findHairSource(hairName, hairCfg)
	if not sourceBone then
		complain(
			("couldn't find the rigged %s hair. Import %s.fbx with the 3D Importer and put the model in ServerStorage > %s (looking for a bone named %s)."):format(
				hairName,
				hairName == "LadyHair" and "LadyHair_Rigged" or hairName .. "_Rigged",
				HairConfig.ModelFolder,
				hairCfg.SignatureBone
			)
		)
		return
	end

	-- copy just the hair mesh and its bones (and its SurfaceAppearance, if the importer made one)
	local hairPart = copyHairMesh(sourceBone)
	if not hairPart then
		complain(("found the %s bones in %s but no hair mesh next to them"):format(hairName, where or "?"))
		return
	end
	for _, d in hairPart:GetDescendants() do
		if d.Parent and not (d:IsA("Bone") or d:IsA("SurfaceAppearance")) then
			d:Destroy()
		end
	end
	hairPart.Name = "Handle"
	hairPart.Anchored = false
	hairPart.CanCollide = false
	hairPart.CanTouch = false
	hairPart.CanQuery = false
	hairPart.Massless = true
	if hairPart:IsA("MeshPart") then
		if hairCfg.TextureId and hairCfg.TextureId ~= "" then
			hairPart.TextureID = hairCfg.TextureId
		end
	end
	if hairCfg.Color then
		hairPart.Color = hairCfg.Color
	end

	-- where does it go? compare modeled bone positions with the imported ones
	local design, actual = collectBonePairs(hairPart, layout)
	if #design < 3 then
		complain(("the %s hair from %s is missing its bones (found %d). Re-import the FBX and make sure the importer kept the rig."):format(hairName, where or "?", #design))
		hairPart:Destroy()
		return
	end
	local fit = HairPhysics.FitRig(design, actual)
	local wantScale = hairCfg.Scale or 1
	if hairCfg.ScaleToHead and head:IsA("MeshPart") then
		-- the hair was made for a head ReferenceHeadWidth wide: match this rig's head
		local ratio = (head.Size.X + head.Size.Z) * 0.5 / (HairConfig.ReferenceHeadWidth or 1.2)
		if ratio > 0.5 and ratio < 3 then
			wantScale *= ratio
		end
	end
	if math.abs(fit.Scale / wantScale - 1) > 0.02 then
		-- the importer used a different unit size (or you changed Scale): resize the hair + bones
		local holder = Instance.new("Model")
		hairPart.Parent = holder
		local ok, err = pcall(function()
			holder:ScaleTo(holder:GetScale() * wantScale / fit.Scale)
		end)
		hairPart.Parent = nil
		holder:Destroy()
		if ok then
			log(("resized the %s hair by x%.3f to fit %s's head"):format(hairName, wantScale / fit.Scale, rig.Name))
			design, actual = collectBonePairs(hairPart, layout)
			fit = HairPhysics.FitRig(design, actual)
		else
			complain("couldn't resize the hair: " .. tostring(err))
		end
	end
	if fit.Error > 0.05 * math.max(fit.Scale, 0.01) then
		complain(("the %s hair's bones don't match the expected layout (off by %.2f studs on average). It may sit wrong — was the rig changed in Blender?"):format(hairName, fit.Error))
	end
	-- the rig's HeadCenter point goes on the centre of the head, then your Offset nudge on top
	local headCenter = (layout.HeadCenter or Vector3.zero) * fit.Scale
	local headToHair = hairCfg.Offset * CFrame.new(-headCenter) * HairPhysics.HeadToPart(fit)

	-- wear it
	removeOldHair(rig, hairCfg)
	local accessory = Instance.new("Accessory")
	accessory.Name = hairName .. "Hair"
	accessory.AccessoryType = Enum.AccessoryType.Hair
	accessory:SetAttribute("HairPhysicsHair", true)
	hairPart:SetAttribute("HairPreset", hairName)
	CollectionService:AddTag(hairPart, HairPhysics.TAG)
	hairPart.CFrame = head.CFrame * headToHair
	hairPart.Parent = accessory

	local headAttachment = head:FindFirstChild("HairAttachment")
	if humanoid and headAttachment and headAttachment:IsA("Attachment") then
		-- standard accessory route: Roblox welds our HairAttachment onto the head's HairAttachment
		local attachment = Instance.new("Attachment")
		attachment.Name = "HairAttachment"
		attachment.CFrame = headToHair:Inverse() * headAttachment.CFrame
		attachment.Parent = hairPart
		humanoid:AddAccessory(accessory)
	else
		accessory.Parent = rig
	end

	-- make sure it really is attached (and attach it ourselves if not)
	local attached = false
	for _, d in hairPart:GetChildren() do
		if (d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("RigidConstraint")) then
			attached = true
		end
	end
	if not attached then
		if accessory.Parent ~= rig then
			accessory.Parent = rig
		end
		local weld = Instance.new("Weld")
		weld.Name = "AccessoryWeld"
		weld.Part0 = head
		weld.Part1 = hairPart
		weld.C0 = headToHair
		weld.Parent = hairPart
	end

	log(("%s is wearing %s (%d bones lined up, error %.3f studs)"):format(rig.Name, hairName, #design, fit.Error))
end

for _, assignment in HairConfig.Assignments do
	task.spawn(function()
		local rig = Workspace:WaitForChild(assignment.Rig, RIG_WAIT_TIME)
		if not rig then
			complain(("no rig called '%s' in Workspace"):format(assignment.Rig))
			return
		end
		local ok, err = pcall(applyHair, rig, assignment.Hair)
		if not ok then
			complain(("putting %s on %s failed: %s"):format(assignment.Hair, assignment.Rig, tostring(err)))
		end
	end)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">NPCRoam</string>
          <ProtectedString name="Source"><![CDATA[--[[
	NPCRoam  (Script — lives in ServerScriptService)

	Test script: makes the rigs walk to random spots (inside the TestArena, if it's in
	Workspace), jump at random, pause, and sometimes turn around sharply — so you can see
	the hair swing, bounce and settle.
	It also plays Roblox's default walk / idle / jump / fall animations on them.

	Delete this script (or set ENABLED = false) once you're happy with the hair.
]]

----------------------------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------------------------
local ENABLED = true
local RIGS = { "MrPigtails", "MrLady" } -- rigs in Workspace to move around
local ARENA_NAME = "TestArena" -- if this model is in Workspace, they roam inside it
local ARENA_MARGIN = 5 -- keep this far (studs) from the arena walls
local ROAM_RADIUS = 30 -- with no arena: how far (studs) from their starting spot they wander
local WALK_SPEED_MIN = 8 -- they pick a random speed between these for each walk
local WALK_SPEED_MAX = 16
local JUMPS_PER_SECOND = 0.35 -- average number of random jumps per second while walking
local PAUSE_MIN = 0.4 -- seconds they stand still between walks
local PAUSE_MAX = 2.5
local TURN_AROUND_CHANCE = 0.3 -- chance to spin round on the spot after a walk (hair whip test)
local JUMP_IN_PLACE_CHANCE = 0.3 -- chance to jump while standing still

-- Roblox's default character animations (the same ones the built-in Animate script uses)
local ANIMATIONS = {
	R15 = {
		idle = "rbxassetid://507766666",
		walk = "rbxassetid://507777826",
		run = "rbxassetid://507767714",
		jump = "rbxassetid://507765000",
		fall = "rbxassetid://507767968",
	},
	R6 = {
		idle = "rbxassetid://180435571",
		walk = "rbxassetid://180426354",
		run = "rbxassetid://180426354",
		jump = "rbxassetid://125750702",
		fall = "rbxassetid://180436148",
	},
}
----------------------------------------------------------------------------------------

if not ENABLED then
	return
end

local Workspace = game:GetService("Workspace")

local rigModels = {}

local function setupAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local set = humanoid.RigType == Enum.HumanoidRigType.R6 and ANIMATIONS.R6 or ANIMATIONS.R15
	local tracks = {}
	for name, id in set do
		local animation = Instance.new("Animation")
		animation.Name = name
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok then
			track.Looped = name ~= "jump"
			track.Priority = Enum.AnimationPriority.Core
			tracks[name] = track
		else
			warn("[NPCRoam] couldn't load the " .. name .. " animation: " .. tostring(track))
		end
	end

	local current
	local function play(name: string, speed: number?)
		local track = tracks[name]
		if not track then
			return
		end
		if current ~= track then
			if current then
				current:Stop(0.2)
			end
			track:Play(0.2)
			current = track
		end
		track:AdjustSpeed(speed or 1)
	end

	local airborne = false
	humanoid.Running:Connect(function(speed: number)
		if airborne then
			return
		end
		if speed > 0.75 then
			if speed > 12 and tracks.run then
				play("run", speed / 16)
			else
				play("walk", math.clamp(speed / 10, 0.6, 1.6))
			end
		else
			play("idle")
		end
	end)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			airborne = true
			play("jump")
		elseif new == Enum.HumanoidStateType.Freefall then
			airborne = true
			task.delay(0.2, function()
				if airborne and humanoid:GetState() == Enum.HumanoidStateType.Freefall then
					play("fall")
				end
			end)
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			airborne = false
			local speed = humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed
			if speed > 0.75 then
				play("walk", math.clamp(speed / 10, 0.6, 1.6))
			else
				play("idle")
			end
		end
	end)
	play("idle")
end

-- Random spot on the ground: inside the arena if there is one, otherwise near home
-- (raycasts down so they don't walk into the void).
local function pickGoal(home: Vector3, rng: Random): Vector3?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = rigModels
	local arena = Workspace:FindFirstChild(ARENA_NAME)
	local floor = arena and arena:FindFirstChild("Floor")
	for _ = 1, 12 do
		local probe
		if floor and floor:IsA("BasePart") then
			local size = arena:GetAttribute("InteriorSize") or Vector3.new(64, 24, 64)
			local top = floor.CFrame * CFrame.new(0, floor.Size.Y / 2, 0)
			local hx, hz = size.X / 2 - ARENA_MARGIN, size.Z / 2 - ARENA_MARGIN
			probe = top * Vector3.new(rng:NextNumber(-hx, hx), size.Y - 2, rng:NextNumber(-hz, hz))
		else
			local angle = rng:NextNumber(0, math.pi * 2)
			local dist = rng:NextNumber(6, ROAM_RADIUS)
			probe = home + Vector3.new(math.cos(angle) * dist, 40, math.sin(angle) * dist)
		end
		local hit = Workspace:Raycast(probe, Vector3.new(0, -120, 0), params)
		if hit and hit.Instance.CanCollide then
			return hit.Position
		end
	end
	return nil
end

local function tryJump(humanoid: Humanoid)
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		humanoid.Jump = true
	end
end

local function walkTo(humanoid: Humanoid, goal: Vector3, rng: Random)
	local done = false
	local connection = humanoid.MoveToFinished:Connect(function()
		done = true
	end)
	humanoid:MoveTo(goal)
	local started = os.clock()
	while not done and os.clock() - started < 8 and humanoid.Health > 0 do
		if rng:NextNumber() < JUMPS_PER_SECOND * 0.25 then
			tryJump(humanoid)
		end
		task.wait(0.25)
	end
	connection:Disconnect()
end

local function roam(rig: Model)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then
		warn("[NPCRoam] " .. rig.Name .. " needs a Humanoid and a HumanoidRootPart")
		return
	end

	-- rigs made with the Rig Builder are often anchored; they can't walk like that
	for _, d in rig:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	-- the server drives them, so the server should own their physics (stops stutter near players)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	setupAnimations(humanoid)

	local rng = Random.new()
	task.wait(rng:NextNumber(1, 2)) -- lets ArenaSetup put them in the arena, and stops them moving in sync
	local home = root.Position

	while rig.Parent and humanoid.Health > 0 do
		local goal = pickGoal(home, rng)
		if goal then
			humanoid.WalkSpeed = rng:NextNumber(WALK_SPEED_MIN, WALK_SPEED_MAX)
			walkTo(humanoid, goal, rng)
		end

		if rng:NextNumber() < TURN_AROUND_CHANCE then
			-- step a little behind themselves: a fast 180° turn
			humanoid.WalkSpeed = WALK_SPEED_MAX
			local back = root.Position - root.CFrame.LookVector * 2.5
			walkTo(humanoid, back, rng)
		end
		if rng:NextNumber() < JUMP_IN_PLACE_CHANCE then
			tryJump(humanoid)
		end
		task.wait(rng:NextNumber(PAUSE_MIN, PAUSE_MAX))
	end
end

for _, name in RIGS do
	local rig = Workspace:WaitForChild(name, 20)
	if rig and rig:IsA("Model") then
		table.insert(rigModels, rig)
	else
		warn("[NPCRoam] no rig called '" .. name .. "' in Workspace")
	end
end
for _, rig in rigModels do
	task.spawn(roam, rig)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">ArenaSetup</string>
          <ProtectedString name="Source"><![CDATA[--[[
	ArenaSetup  (Script — lives in ServerScriptService)

	Runs the TestArena (the sealed glass-roofed box in Workspace):
	  * moves MrPigtails and MrLady onto their spots inside it when the game starts,
	  * makes every player spawn inside it (and puts them back in if they ever end up outside),
	  * opens / closes the drain gate when a player presses Z (or taps "Gate" on a phone).

	The arena keeps two attributes the upcoming water system will read:
	  InteriorSize  size of the inside of the box (studs)
	  GateOpen      true while the drain gate is open
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

----------------------------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------------------------
local ARENA_NAME = "TestArena"
local RIGS = { "MrPigtails", "MrLady" } -- each goes to the part called RigSpot_<name>
local GATE_TIME = 1.2 -- seconds the gate takes to slide open or shut
local GATE_COOLDOWN = 0.4 -- ignore Z presses closer together than this
----------------------------------------------------------------------------------------

local arena = Workspace:WaitForChild(ARENA_NAME, 10)
if not arena then
	warn("[ArenaSetup] no model called " .. ARENA_NAME .. " in Workspace — drop the TestArena from the kit into Workspace")
	return
end

local floor = arena:WaitForChild("Floor") :: BasePart
local spawnPad = arena:FindFirstChild("ArenaSpawn")
local drain = arena:FindFirstChild("Drain")
local gate = drain and drain:FindFirstChild("Gate")

-- The inside of the box as a CFrame (centre of the floor's top surface) plus its size.
local function interior(): (CFrame, Vector3)
	local size = arena:GetAttribute("InteriorSize") or Vector3.new(64, 24, 64)
	local top = floor.CFrame * CFrame.new(0, floor.Size.Y / 2, 0)
	return top, size
end

local function isInside(position: Vector3): boolean
	local top, size = interior()
	local p = top:PointToObjectSpace(position)
	return math.abs(p.X) < size.X / 2 and math.abs(p.Z) < size.Z / 2 and p.Y > -1 and p.Y < size.Y
end

-- Stands a model on top of a spot part, facing the way the spot faces.
local function standOn(model: Model, spot: BasePart)
	local pivot = model:GetPivot()
	local boxCF, boxSize = model:GetBoundingBox()
	local feetBelowPivot = pivot.Position.Y - (boxCF.Position.Y - boxSize.Y / 2)
	local base = spot.Position - Vector3.new(0, spot.Size.Y / 2, 0)
	local facing = spot.CFrame.LookVector
	model:PivotTo(CFrame.lookAt(base, base + Vector3.new(facing.X, 0, facing.Z)) + Vector3.new(0, feetBelowPivot + 0.05, 0))
end

-- 1) dummies into the arena
for _, name in RIGS do
	task.spawn(function()
		local rig = Workspace:WaitForChild(name, 10)
		local spot = arena:FindFirstChild("RigSpot_" .. name)
		if rig and rig:IsA("Model") and spot and spot:IsA("BasePart") then
			standOn(rig, spot)
		elseif not rig then
			warn("[ArenaSetup] no rig called " .. name .. " in Workspace")
		end
	end)
end

-- 2) players spawn inside
local function onCharacter(player: Player, character: Model)
	task.wait(0.2) -- let Roblox finish placing the character first
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and spawnPad and not isInside(root.Position) then
		character:PivotTo(spawnPad.CFrame + Vector3.new(0, 3.5, 0))
	end
end

local function onPlayer(player: Player)
	if spawnPad and spawnPad:IsA("SpawnLocation") then
		player.RespawnLocation = spawnPad
	end
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	onPlayer(player)
end

-- 3) the drain gate
local remote = ReplicatedStorage:FindFirstChild("ArenaGate")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "ArenaGate"
	remote.Parent = ReplicatedStorage
end

if gate and gate:IsA("BasePart") then
	local closedCF = gate.CFrame
	local openCF = closedCF + closedCF.UpVector * (gate.Size.Y + 0.1) -- slides up inside the wall
	local lastToggle = 0
	local function setGate(open: boolean)
		arena:SetAttribute("GateOpen", open)
		TweenService:Create(gate, TweenInfo.new(GATE_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			CFrame = open and openCF or closedCF,
		}):Play()
	end
	remote.OnServerEvent:Connect(function(player: Player, action)
		if action ~= "Toggle" or os.clock() - lastToggle < GATE_COOLDOWN then
			return
		end
		lastToggle = os.clock()
		setGate(not arena:GetAttribute("GateOpen"))
		print(("[ArenaSetup] %s %s the drain gate"):format(player.Name, arena:GetAttribute("GateOpen") and "opened" or "closed"))
	end)
	setGate(false)
else
	warn("[ArenaSetup] the arena has no Drain > Gate part")
end
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">HairPhysicsClient</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairPhysicsClient  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Starts the hair simulation on this player's screen. Every hair the server tagged
	"HairPhysics" gets simulated here. Nothing to change in this script — the settings
	are in ReplicatedStorage > HairConfig.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))
HairPhysics.StartClient()
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="11">
        <Properties>
          <string name="Name">HairFitTool</string>
          <ProtectedString name="Source"><![CDATA[--[[
	HairFitTool  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	A little panel for lining the hair up on the heads while the game is running.
	Press H (or tap the "Fit" button on a phone) to open or close it.

	  Prev / Next   pick which rig's hair you're moving (it gets an outline)
	  Up, Down, Left, Right, Fwd, Back   move it 0.05 studs (hold Shift on a keyboard
	                                      for 0.01)
	  Reset         undo this session's nudges

	The box at the bottom shows the Offset line for HairConfig, e.g.
	    Offset = CFrame.new(0, 0.05, -0.02),
	Copy it into that hair's entry in ReplicatedStorage > HairConfig to keep it.
	(The nudges only change what you see in this play session.)

	Turn the tool off with HairConfig.FitToolEnabled = false.
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local HairConfig = require(ReplicatedStorage:WaitForChild("HairConfig"))
local HairPhysics = require(ReplicatedStorage:WaitForChild("HairPhysics"))

if not HairConfig.FitToolEnabled then
	return
end

local STEP = 0.05
local FINE_STEP = 0.01

local player = Players.LocalPlayer
local nudges = {} -- [hair part] = total nudge this session (head space: right, up, back)
local selectedIndex = 1
local gui, title, readout, highlight

local function tagged(): { BasePart }
	local list = {}
	for _, part in CollectionService:GetTagged(HairPhysics.TAG) do
		if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
			table.insert(list, part)
		end
	end
	table.sort(list, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return list
end

local function selectedHair(): BasePart?
	local list = tagged()
	if #list == 0 then
		return nil
	end
	selectedIndex = (selectedIndex - 1) % #list + 1
	return list[selectedIndex]
end

-- The weld holding the hair to the head, and the head.
local function findWeld(hair: BasePart): (JointInstance?, BasePart?)
	for _, child in hair:GetChildren() do
		if child:IsA("JointInstance") then
			local other = child.Part0 == hair and child.Part1 or child.Part0
			if other and other.Name == "Head" then
				return child, other
			end
		end
	end
	return nil
end

local function rigName(hair: BasePart): string
	local node = hair.Parent
	while node and not (node:IsA("Model") and node:FindFirstChildOfClass("Humanoid")) do
		node = node.Parent
	end
	return node and node.Name or "?"
end

local function offsetLine(hair: BasePart): string
	local preset = hair:GetAttribute("HairPreset")
	local cfg = HairConfig.Hairs[preset]
	local base = cfg and cfg.Offset or CFrame.identity
	local p = base.Position + (nudges[hair] or Vector3.zero)
	local function n(x: number): string
		local str = string.format("%.2f", x)
		if str == "0.00" or str == "-0.00" then
			return "0"
		end
		return (str:gsub("0+$", ""):gsub("%.$", ""))
	end
	return ("Offset = CFrame.new(%s, %s, %s),"):format(n(p.X), n(p.Y), n(p.Z))
end

local function refresh()
	if not gui then
		return
	end
	local hair = selectedHair()
	if hair then
		title.Text = ("Hair fit: %s (%s)"):format(rigName(hair), tostring(hair:GetAttribute("HairPreset")))
		readout.Text = offsetLine(hair)
		highlight.Adornee = hair
	else
		title.Text = "Hair fit: no hair found yet"
		readout.Text = ""
		highlight.Adornee = nil
	end
end

-- Moves a hair by delta (head space: right, up, back) by adjusting the weld that holds it.
local function applyDelta(hair: BasePart, delta: Vector3)
	local weld, head = findWeld(hair)
	if not weld or not head then
		warn("[HairFitTool] couldn't find the weld holding " .. hair:GetFullName())
		return
	end
	if weld.Part0 == head then
		local current = weld.C0 * weld.C1:Inverse()
		weld.C0 = CFrame.new(delta) * current * weld.C1
	else
		local current = weld.C1 * weld.C0:Inverse()
		weld.C1 = CFrame.new(delta) * current * weld.C0
	end
	nudges[hair] = (nudges[hair] or Vector3.zero) + delta
	refresh()
end

local function nudge(direction: Vector3)
	local hair = selectedHair()
	if hair then
		local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		applyDelta(hair, direction * (fine and FINE_STEP or STEP))
	end
end

local function reset()
	local hair = selectedHair()
	if hair and nudges[hair] then
		applyDelta(hair, -nudges[hair])
		nudges[hair] = Vector3.zero
		refresh()
	end
end

local function makeButton(parent: Instance, text: string, pos: UDim2, size: UDim2, onClick: () -> ())
	local b = Instance.new("TextButton")
	b.Text = text
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextScaled = true
	b.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

local function buildGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "HairFitTool"
	gui.ResetOnSpawn = false
	gui.Enabled = false

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0, 1)
	frame.Position = UDim2.new(0, 12, 1, -12)
	frame.Size = UDim2.fromOffset(300, 250)
	frame.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
	frame.BackgroundTransparency = 0.1
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(10, 6)
	title.Size = UDim2.new(1, -20, 0, 24)
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local w, h = 88, 32
	local function at(col: number, row: number)
		return UDim2.fromOffset(10 + col * (w + 6), 36 + row * (h + 6))
	end
	local size = UDim2.fromOffset(w, h)
	makeButton(frame, "Prev", at(0, 0), size, function()
		selectedIndex -= 1
		refresh()
	end)
	makeButton(frame, "Reset", at(1, 0), size, reset)
	makeButton(frame, "Next", at(2, 0), size, function()
		selectedIndex += 1
		refresh()
	end)
	makeButton(frame, "Up", at(1, 1), size, function()
		nudge(Vector3.yAxis)
	end)
	makeButton(frame, "Left", at(0, 2), size, function()
		nudge(-Vector3.xAxis)
	end)
	makeButton(frame, "Down", at(1, 2), size, function()
		nudge(-Vector3.yAxis)
	end)
	makeButton(frame, "Right", at(2, 2), size, function()
		nudge(Vector3.xAxis)
	end)
	makeButton(frame, "Fwd", at(0, 1), size, function()
		nudge(-Vector3.zAxis)
	end)
	makeButton(frame, "Back", at(2, 1), size, function()
		nudge(Vector3.zAxis)
	end)

	-- a TextBox so the line can be selected and copied
	readout = Instance.new("TextBox")
	readout.ClearTextOnFocus = false
	readout.TextEditable = false
	readout.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 4)
	readout.Size = UDim2.new(1, -20, 0, 30)
	readout.BackgroundColor3 = Color3.fromRGB(12, 13, 16)
	readout.TextColor3 = Color3.fromRGB(140, 220, 160)
	readout.Font = Enum.Font.Code
	readout.TextScaled = true
	readout.Parent = frame
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 6)
	rc.Parent = readout

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromOffset(10, 36 + 3 * (h + 6) + 38)
	hint.Size = UDim2.new(1, -20, 0, 16)
	hint.Font = Enum.Font.Gotham
	hint.TextColor3 = Color3.fromRGB(170, 175, 185)
	hint.TextScaled = true
	hint.Text = "Copy this line into HairConfig to keep it"
	hint.Parent = frame

	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 200, 60)
	highlight.Enabled = false
	highlight.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function toggle(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if not gui then
		buildGui()
	end
	gui.Enabled = not gui.Enabled
	highlight.Enabled = gui.Enabled
	refresh()
	if gui.Enabled then
		local hair = selectedHair()
		if hair then
			print("[HairFitTool] " .. tostring(hair:GetAttribute("HairPreset")) .. ": " .. offsetLine(hair))
		end
	end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction("HairFitTool", toggle, true, HairConfig.FitToolKey or Enum.KeyCode.H)
ContextActionService:SetTitle("HairFitTool", "Fit")
ContextActionService:SetPosition("HairFitTool", UDim2.new(1, -70, 0, 10))
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">ArenaControls</string>
          <ProtectedString name="Source"><![CDATA[--[[
	ArenaControls  (LocalScript — lives in StarterPlayer > StarterPlayerScripts)

	Press Z (or tap the "Gate" button on a phone) to open / close the TestArena's drain gate.
	A small label at the top of the screen shows whether it's open.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local KEY = Enum.KeyCode.Z

local remote = ReplicatedStorage:WaitForChild("ArenaGate")
local arena = Workspace:WaitForChild("TestArena", 30)

local label = Instance.new("TextLabel")
do
	local gui = Instance.new("ScreenGui")
	gui.Name = "ArenaControls"
	gui.ResetOnSpawn = false
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0, 8)
	label.Size = UDim2.fromOffset(300, 28)
	label.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamMedium
	label.TextScaled = true
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 5)
	pad.PaddingBottom = UDim.new(0, 5)
	pad.Parent = label
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function refresh()
	local open = arena and arena:GetAttribute("GateOpen")
	label.Text = ("Drain gate: %s   (press Z)"):format(open and "OPEN" or "closed")
	label.TextColor3 = open and Color3.fromRGB(120, 210, 255) or Color3.new(1, 1, 1)
end

if arena then
	arena:GetAttributeChangedSignal("GateOpen"):Connect(refresh)
end
refresh()

ContextActionService:BindAction("ArenaGate", function(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		remote:FireServer("Toggle")
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end, true, KEY)
ContextActionService:SetTitle("ArenaGate", "Gate")
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
